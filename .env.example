# 站点正式地址（部署到 Vercel / Netlify 时可留空，平台会自动识别）
# 本地构建想生成正确的 canonical / sitemap，请复制本文件为 .env 并填写：
# SITE_URL=https://你的域名
SITE_URL=

# ─────────────────────────────────────────────────────────────
# 下面这些是 server/server.mjs 读的（改完重启服务生效）
# ─────────────────────────────────────────────────────────────

# 后端端口，默认 8787
# PORT=8787

# 数据库位置，默认 data/blog.db（想换库/做备份测试时改这里）
# FIREFLY_DB=data/blog.db

# 网站放静态托管（GitHub Pages 等）、后端跑在自己电脑上时，
# 把后端公网地址填在这里，构建时会写进页面 <meta name="firefly-api-base">，
# 访客打开就能直接用，登录页也不会再显示「⚙ 服务器」按钮（自己改地址用 ?setup=1 打开）。
# PUBLIC_API_BASE=https://xxxx.trycloudflare.com

# ── 邮箱验证码发信（不配置 = 开发模式）─────────────────────────
# 不配置时：验证码会打印在服务器窗口里，并且本机 / 局域网访问的页面会自动填入，
# 所以单机自用完全可以不配；想让别人也能登录就填下面的 SMTP。
# FIREFLY_SMTP_HOST=smtp.qq.com
# FIREFLY_SMTP_PORT=465
# FIREFLY_SMTP_SECURE=true
# FIREFLY_SMTP_USER=123456789@qq.com
# FIREFLY_SMTP_PASS=邮箱授权码（不是登录密码）
# FIREFLY_MAIL_FROM=123456789@qq.com
# FIREFLY_MAIL_FROM_NAME=我的动漫小屋

# 验证码有效期（秒，默认 600）与重发冷却（秒，默认 60）
# FIREFLY_CODE_TTL=600
# FIREFLY_CODE_RESEND=60
