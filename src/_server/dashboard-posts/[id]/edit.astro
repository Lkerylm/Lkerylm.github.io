---
import AnimeBackdrop from "@/components/features/AnimeBackdrop.astro";
import AnimeHeadMeta from "@/components/features/AnimeHeadMeta.astro";
export const prerender = false;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>编辑文章 - 我的动漫小屋</title>
  <AnimeHeadMeta />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh;
      background: linear-gradient(135deg, #1b1e33 0%, #0a0b12 100%);
      font-family: system-ui, -apple-system, "Noto Sans SC", sans-serif;
      color: #fff; padding: 40px 20px;
    }
    .container { max-width: 800px; margin: 0 auto; }
    h1 { margin: 0 0 8px; font-size: 26px; }
    .sub { color: rgba(255,255,255,0.55); font-size: 13px; margin-bottom: 28px; }
    label { display: block; font-size: 13px; margin-bottom: 8px; color: rgba(255,255,255,0.75); }
    input, textarea {
      width: 100%; padding: 12px 14px;
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 10px;
      color: #fff; font-size: 14px;
      margin-bottom: 20px; outline: none;
      font-family: inherit;
    }
    input:focus, textarea:focus { border-color: #ff9ac8; box-shadow: 0 0 0 3px rgba(255,154,200,0.15); }
    textarea { min-height: 320px; resize: vertical; line-height: 1.6; }
    .actions { display: flex; gap: 12px; flex-wrap: wrap; }
    button, a {
      padding: 12px 22px; border-radius: 10px;
      font-size: 14px; font-weight: 500;
      text-decoration: none; cursor: pointer;
      border: none; transition: all 0.2s;
      font-family: inherit;
    }
    .btn-primary { background: linear-gradient(135deg, #ff9ac8, #a78bfa); color: #fff; }
    .btn-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 10px 30px rgba(255,154,200,0.3); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-ghost { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); }
    .btn-ghost:hover { background: rgba(255,255,255,0.15); }
    .msg { margin-top: 16px; padding: 10px 14px; border-radius: 8px; font-size: 13px; display: none; }
    .msg.err { display: block; background: rgba(255,80,80,0.15); color: #ffb0b0; border: 1px solid rgba(255,80,80,0.3); }
    .msg.ok  { display: block; background: rgba(100,255,150,0.15); color: #a8ffc4; border: 1px solid rgba(100,255,150,0.3); }
    .hint { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: -16px; margin-bottom: 20px; }
    .loading { text-align: center; padding: 60px; color: rgba(255,255,255,0.5); }
  </style>
</head>
<body>
  <AnimeBackdrop />
  <div class="container">
    <h1>编辑文章</h1>
    <div class="sub">保存后需要重新审核，管理员除外</div>

    <div id="loading" class="loading">加载中…</div>

    <form id="postForm" style="display: none;">
      <label>标题</label>
      <input type="text" id="title" required maxlength="100" />

      <label>正文</label>
      <textarea id="content" required></textarea>
      <div class="hint">支持 Markdown 语法</div>

      <div class="actions">
        <button type="submit" class="btn-primary" id="submitBtn">保存</button>
        <a href="/dashboard/" class="btn-ghost">返回</a>
      </div>
    </form>

    <div class="msg" id="msg"></div>
  </div>

  <script is:inline>
    const pathParts = location.pathname.split('/').filter(Boolean);
    const POST_ID = Number(pathParts[pathParts.length - 2]);

    const loading = document.getElementById('loading');
    const form = document.getElementById('postForm');
    const msg = document.getElementById('msg');

    function showMsg(text, type) {
      msg.textContent = text;
      msg.className = 'msg ' + type;
    }

    async function loadPost() {
      try {
        const res = await fetch('/api/posts/get/?id=' + POST_ID, { credentials: 'include' });
        const data = await res.json();
        if (!data.ok) {
          loading.textContent = data.error || '加载失败';
          return;
        }
        document.getElementById('title').value = data.post.title;
        document.getElementById('content').value = data.post.content;
        loading.style.display = 'none';
        form.style.display = 'block';
      } catch (e) {
        loading.textContent = '网络错误';
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = '保存中…';
      msg.className = 'msg';

      const title = document.getElementById('title').value.trim();
      const content = document.getElementById('content').value.trim();

      try {
        const res = await fetch('/api/posts/update/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ postId: POST_ID, title, content }),
        });
        const data = await res.json();
        if (data.ok) {
          showMsg('保存成功！即将跳转…', 'ok');
          setTimeout(() => { location.href = '/dashboard/'; }, 1000);
        } else {
          showMsg(data.error || '保存失败', 'err');
          btn.disabled = false;
          btn.textContent = '保存';
        }
      } catch (err) {
        showMsg('网络错误', 'err');
        btn.disabled = false;
        btn.textContent = '保存';
      }
    });

    loadPost();
  </script>
</body>
</html>