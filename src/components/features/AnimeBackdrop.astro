---
import AnimeCursor from "./AnimeCursor.astro";
import AnimeVoice from "./AnimeVoice.astro";
import AnimeWallpaperGallery from "./AnimeWallpaperGallery.astro";
import { animeWallpaperFiles } from "@/utils/anime-wallpaper-utils";
/**
 * 二次元全屏背景层
 * - 随机动漫壁纸（可手动切换，状态记忆）
 * - 缓慢呼吸 / 视差移动的壁纸 + 樱花花瓣
 * - 可选右下角 Live2D 看板娘（登录、后台、社区、用户页等独立页面使用）
 * - 自动带上全局 UI 音效
 */
import UiSounds from "./UiSounds.astro";

interface Props {
	/** corner: 右下角展示 Live2D 看板娘；none: 不展示 */
	live2d?: "corner" | "none";
	/** 是否显示樱花花瓣 */
	petals?: boolean;
	/** 是否加载 UI 音效系统 */
	sounds?: boolean;
	/** 是否显示"换壁纸"按钮 */
	wallpaperButton?: boolean;
}

const {
	live2d = "corner",
	petals = true,
	sounds = true,
	wallpaperButton = true,
} = Astro.props;

// 与横幅 / 画廊使用同一份排序后的清单，保证 index 对应同一张壁纸
const desktop = animeWallpaperFiles("desktop");
const mobile = animeWallpaperFiles("mobile");
if (!desktop.length) desktop.push("/anime-wallpaper/desktop-01.avif");
if (!mobile.length) mobile.push("/anime-wallpaper/mobile-01.avif");

const petalList = Array.from({ length: 16 }, (_, i) => ({
	left: (i * 6.3 + (i % 3) * 7 + 2) % 100,
	size: 7 + (i % 4) * 4,
	delay: -((i * 1.9) % 22),
	duration: 15 + (i % 5) * 3.5,
	drift: (i % 2 === 0 ? 1 : -1) * (40 + (i % 5) * 30),
	opacity: 0.25 + (i % 5) * 0.1,
}));
---

<div id="anime-backdrop" aria-hidden="true">
	<div class="anime-backdrop-media">
		<img id="anime-backdrop-img" src={desktop[0]} alt="" loading="eager" />
	</div>
	<div class="anime-backdrop-glow"></div>
	<div class="anime-backdrop-veil"></div>

	{
		petals && (
			<div class="anime-petals">
				{petalList.map((petal) => (
					<span
						style={`left:${petal.left}%; width:${petal.size}px; height:${petal.size}px; opacity:${petal.opacity}; --petal-delay:${petal.delay}s; --petal-duration:${petal.duration}s; --petal-drift:${petal.drift}px;`}
					/>
				))}
			</div>
		)
	}
</div>

{
	wallpaperButton && (
		<button
			id="anime-wallpaper-next"
			type="button"
			title="换一张动漫壁纸"
			aria-label="换一张动漫壁纸"
		>
			<span class="anime-wallpaper-icon">🌸</span>
			<span class="anime-wallpaper-text">换壁纸</span>
		</button>
	)
}

{
	live2d === "corner" && (
		<div id="anime-corner-l2d" data-anime-l2d>
			<div id="anime-corner-bubble" class="anime-corner-bubble">
				一起看番吗？
			</div>
			<canvas id="anime-corner-canvas" />
			<button
				id="anime-corner-next"
				type="button"
				title="换一个看板娘"
				aria-label="换一个看板娘"
			>
				🔄
			</button>
		</div>
	)
}

{sounds && <UiSounds />}

<!-- 壁纸画廊 + 看板娘甜美声音：独立页面本身已是全屏壁纸，故不显示「全屏铺满」开关 -->
<AnimeWallpaperGallery fullwall={false} />
<AnimeVoice />
<AnimeCursor />

<style is:global>
	html {
		background-color: #08070f;
	}

	/* 让壁纸真正透出来：独立页面原本的纯色 / 渐变背景全部让位 */
	body {
		background: transparent !important;
	}

	#anime-backdrop {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		background: #08070f;
	}

	.anime-backdrop-media {
		position: absolute;
		inset: -7%;
		animation: anime-bg-drift 46s ease-in-out infinite alternate;
		will-change: transform;
	}

	#anime-backdrop-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: saturate(1.08) brightness(0.82);
		transform: translate3d(0, 0, 0) scale(1.02);
		transition: opacity 0.7s ease;
		will-change: transform, opacity;
	}

	.anime-backdrop-glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 70% 55% at 12% 0%, rgba(255, 143, 193, 0.3), transparent 62%),
			radial-gradient(ellipse 60% 50% at 92% 12%, rgba(167, 139, 250, 0.26), transparent 66%),
			radial-gradient(ellipse 80% 60% at 50% 108%, rgba(255, 154, 200, 0.18), transparent 70%);
		mix-blend-mode: screen;
	}

	.anime-backdrop-veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(8, 7, 15, 0.5) 0%,
			rgba(8, 7, 15, 0.68) 42%,
			rgba(8, 7, 15, 0.88) 100%
		);
	}

	.anime-petals {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.anime-petals span {
		position: absolute;
		top: -10vh;
		display: block;
		border-radius: 62% 4% 62% 4%;
		background: radial-gradient(circle at 32% 28%, #ffe6f2 0%, #ffaccf 58%, #f472b6 100%);
		box-shadow: 0 0 8px rgba(255, 154, 200, 0.45);
		animation: anime-petal-fall var(--petal-duration, 18s) linear
			var(--petal-delay, 0s) infinite;
		will-change: transform;
	}

	@keyframes anime-bg-drift {
		0% {
			transform: scale(1.02) translate3d(-0.8%, 0.4%, 0);
		}
		50% {
			transform: scale(1.08) translate3d(0.6%, -0.8%, 0);
		}
		100% {
			transform: scale(1.04) translate3d(1%, 0.6%, 0);
		}
	}

	@keyframes anime-petal-fall {
		0% {
			transform: translate3d(0, -10vh, 0) rotate(0deg);
		}
		50% {
			transform: translate3d(var(--petal-drift, 40px), 52vh, 0) rotate(190deg);
		}
		100% {
			transform: translate3d(calc(var(--petal-drift, 40px) * -0.7), 114vh, 0)
				rotate(380deg);
			opacity: 0;
		}
	}

	/* ------------------------------ 换壁纸按钮 ------------------------------ */
	#anime-wallpaper-next {
		position: fixed;
		left: 16px;
		bottom: 58px;
		z-index: 999994;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 7px 13px;
		border-radius: 999px;
		border: 1px solid rgba(255, 154, 200, 0.3);
		background: rgba(18, 16, 28, 0.5);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: #ffd9ea;
		font-size: 12px;
		line-height: 1;
		cursor: pointer;
		font-family: inherit;
		box-shadow: 0 6px 22px rgba(167, 139, 250, 0.16);
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}
	#anime-wallpaper-next:hover {
		transform: translateY(-2px);
		background: rgba(38, 28, 50, 0.72);
	}
	#anime-wallpaper-next:active {
		transform: scale(0.96);
	}
	.anime-wallpaper-icon {
		display: inline-block;
		transition: transform 0.5s ease;
	}
	#anime-wallpaper-next.is-switching .anime-wallpaper-icon {
		transform: rotate(360deg) scale(1.15);
	}
	@media (max-width: 640px) {
		#anime-wallpaper-next {
			left: 10px;
			bottom: 50px;
			padding: 7px 10px;
		}
		.anime-wallpaper-text {
			display: none;
		}
	}
	/* ------------------------------ 看板娘 ------------------------------ */
	#anime-corner-l2d {
		position: fixed;
		right: 4px;
		bottom: 0;
		width: clamp(190px, 20vw, 300px);
		height: clamp(250px, 27vw, 380px);
		z-index: 60;
		pointer-events: none;
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 0.9s ease,
			transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
	}
	#anime-corner-l2d.is-ready {
		opacity: 1;
		transform: translateY(0);
	}
	#anime-corner-canvas {
		width: 100%;
		height: 100%;
		display: block;
		pointer-events: auto;
		cursor: pointer;
		filter: drop-shadow(0 12px 28px rgba(167, 139, 250, 0.34));
	}
	#anime-corner-next {
		position: absolute;
		top: 4px;
		right: 4px;
		width: 28px;
		height: 28px;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid rgba(255, 154, 200, 0.35);
		background: rgba(20, 16, 30, 0.55);
		color: #fff;
		font-size: 13px;
		line-height: 1;
		cursor: pointer;
		pointer-events: auto;
		opacity: 0.55;
		backdrop-filter: blur(8px);
		transition:
			opacity 0.2s ease,
			transform 0.4s ease;
	}
	#anime-corner-next:hover {
		opacity: 1;
		transform: rotate(180deg);
	}
	.anime-corner-bubble {
		position: absolute;
		top: 2px;
		left: 50%;
		max-width: 240px;
		padding: 8px 14px;
		border-radius: 14px;
		border: 1px solid rgba(255, 154, 200, 0.42);
		background: rgba(28, 22, 40, 0.82);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: #ffe4f0;
		font-size: 12px;
		line-height: 1.5;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, 8px) scale(0.94);
		transition:
			opacity 0.35s ease,
			transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.anime-corner-bubble.is-show {
		opacity: 1;
		transform: translate(-50%, 0) scale(1);
	}
	@media (max-width: 900px) {
		#anime-corner-l2d {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.anime-backdrop-media,
		.anime-petals span,
		#anime-backdrop-img {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script is:inline define:vars={{ desktop, mobile }}>
	(function () {
		if (window.__animeBackdropReady) return;
		window.__animeBackdropReady = true;

		var img = document.getElementById("anime-backdrop-img");
		if (!img || !Array.isArray(desktop) || !desktop.length) return;

		var STORAGE_KEY = "anime-wallpaper-index";
		// 与壁纸画廊保持一致：<= 860px 视为竖屏，避免「画廊按手机算、背景按电脑算」
		var MOBILE_QUERY = "(max-width: 860px)";
		function isMobileView() {
			return !!(window.matchMedia && window.matchMedia(MOBILE_QUERY).matches);
		}
		function deviceKey() {
			return isMobileView() ? "anime-wallpaper-mobile" : "anime-wallpaper-desktop";
		}
		var reduceMotion =
			window.matchMedia &&
			window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		var index = -1;
		try {
			index = parseInt(localStorage.getItem(STORAGE_KEY) || "-1", 10);
		} catch (e) {}
		if (isNaN(index) || index < 0) {
			index = Math.floor(Math.random() * desktop.length);
		}
		// 壁纸画廊（AnimeWallpaperGallery）手动选过的图片优先，避免两套逻辑打架
		try {
			var picked = localStorage.getItem(deviceKey());
			if (picked !== null) {
				var pickedIndex = parseInt(picked, 10);
				if (!isNaN(pickedIndex) && pickedIndex >= 0) index = pickedIndex;
			}
		} catch (e) {}

		var wasMobile = isMobileView();

		function currentList() {
			return isMobileView() ? mobile : desktop;
		}

		function apply(fade) {
			var list = currentList();
			if (!list || !list.length) return;
			var src = list[index % list.length];

			if (!fade) {
				img.src = src;
				return;
			}

			img.style.opacity = "0";
			var done = function () {
				img.style.opacity = "1";
				img.onload = null;
			};
			img.onload = done;
			img.src = src;
			// 兜底：图片已缓存时 onload 可能不触发
			setTimeout(done, 900);
		}

		apply(false);

		// 只预载「当前 + 后两张」，44 张全量预载太吃流量
		var warmList = currentList();
		for (var w = 1; w <= 2; w++) {
			var warmSrc = warmList[(index + w) % warmList.length];
			if (!warmSrc) continue;
			var preload = new Image();
			preload.src = warmSrc;
		}

		var btn = document.getElementById("anime-wallpaper-next");
		if (btn) {
			btn.addEventListener("click", function () {
				var list = currentList();
				if (!list || !list.length) return;
				index = (index + 1) % list.length;
				var kind = isMobileView() ? "mobile" : "desktop";
				try {
					localStorage.setItem(STORAGE_KEY, String(index));
					// 同步给壁纸画廊，切页后横幅 / 页面背景不会又跳回旧图
					localStorage.setItem(deviceKey(), String(index));
				} catch (e) {}
				if (
					window.AnimeWallpaperGallery &&
					typeof window.AnimeWallpaperGallery.pick === "function"
				) {
					window.AnimeWallpaperGallery.pick(kind, index);
				} else {
					apply(true);
				}
				btn.classList.add("is-switching");
				setTimeout(function () {
					btn.classList.remove("is-switching");
				}, 520);
				if (window.AnimeSounds) window.AnimeSounds.play("open", 0.22);
			});
		}

		// 滚动视差：壁纸随页面缓慢移动，而不是一整块死图
		if (!reduceMotion) {
			var ticking = false;
			var update = function () {
				ticking = false;
				var y = window.scrollY || document.documentElement.scrollTop || 0;
				var shift = Math.min(y * 0.08, 72);
				img.style.transform =
					"translate3d(0," + shift.toFixed(1) + "px,0) scale(1.03)";
			};
			window.addEventListener(
				"scroll",
				function () {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				},
				{ passive: true },
			);
			update();
		}

		var resizeTimer = null;
		window.addEventListener("resize", function () {
			if (resizeTimer) clearTimeout(resizeTimer);
			resizeTimer = setTimeout(function () {
				var mobileNow = isMobileView();
				if (mobileNow !== wasMobile) {
					wasMobile = mobileNow;
					// 切换设备布局时，重新贴一次画廊里选好的那张图
					if (window.AnimeWallpaperGallery) {
						window.AnimeWallpaperGallery.restore();
					} else {
						apply(false);
					}
				}
			}, 200);
		});
	})();
</script>

{
	live2d === "corner" && (
		<>
			<script is:inline src="/Firefly-live2d-main/load/live2dcubismcore.min.js" />
			<script is:inline src="/Firefly-live2d-main/load/pixi.min.js" />
			<script is:inline src="/Firefly-live2d-main/load/cubism4.min.js" />
			<script is:inline>
				(function () {
					if (window.__animeCornerL2DInit) return;
					window.__animeCornerL2DInit = true;

					var wrap = document.getElementById("anime-corner-l2d");
					var canvas = document.getElementById("anime-corner-canvas");
					if (!wrap || !canvas) return;
					if (window.innerWidth < 900) return;

					var bubble = document.getElementById("anime-corner-bubble");
					var nextBtn = document.getElementById("anime-corner-next");

					var LINES = [
						"今天也要元气满满哦～",
						"要不要一起看番？",
						"嘿嘿，被你发现了～",
						"这个壁纸好看吗？",
						"记得多喝水呀！",
						"再摸我就要害羞了…",
						"新的一天，新的番剧！",
					];

					var bubbleTimer = null;
					function say(text) {
						if (!bubble) return;
						bubble.textContent = text || LINES[Math.floor(Math.random() * LINES.length)];
						bubble.classList.add("is-show");
						if (bubbleTimer) clearTimeout(bubbleTimer);
						bubbleTimer = setTimeout(function () {
							bubble.classList.remove("is-show");
						}, 3600);
					}

					var app = null;
					var model = null;
					var pool = [];
					var voices = [];
					var idx = -1;
					var loading = false;
					var baseX = 0;
					var baseY = 0;
					var curX = 0;
					var curY = 0;
					var targetX = 0;
					var targetY = 0;

					function layout() {
						if (!app || !model) return;
						var w = wrap.clientWidth || 260;
						var h = wrap.clientHeight || 340;
						app.renderer.resize(w, h);
						var bounds = model.getLocalBounds();
						var scale = (h * 0.98) / (bounds.height || 1);
						model.anchor.set(0.5, 1);
						model.scale.set(scale);
						baseX = w / 2;
						baseY = h + 6;
						model.x = baseX + curX;
						model.y = baseY + curY;
					}

					function voiceEnabled() {
						if (window.AnimeSounds && !window.AnimeSounds.isEnabled()) return false;
						return true;
					}

					function playVoice() {
						if (!voiceEnabled()) return;
						// 优先用「声音」面板里选的甜美语音包
						if (window.AnimeVoice && window.AnimeVoice.play(0.55)) return;
						if (!voices.length) return;
						try {
							var audio = new Audio(voices[Math.floor(Math.random() * voices.length)]);
							audio.volume = 0.55;
							var p = audio.play();
							if (p && p.catch) p.catch(function () {});
						} catch (e) {}
					}

					function playMotion() {
						if (!model) return;
						try {
							var defs = model.internalModel?.motionManager?.definitions || {};
							var groups = Object.keys(defs).filter(function (group) {
								return group !== "idle" && Array.isArray(defs[group]) && defs[group].length;
							});
							if (groups.length) {
								model.motion(groups[Math.floor(Math.random() * groups.length)]);
							}
						} catch (e) {}
					}

					async function show(startIndex) {
						if (loading || !app || !pool.length) return false;
						loading = true;

						if (model) {
							try {
								app.stage.removeChild(model);
							} catch (e) {}
							try {
								model.destroy();
							} catch (e) {}
							model = null;
						}

						var tries = Math.min(pool.length, 14);
						for (var n = 0; n < tries; n++) {
							var target = (startIndex + n) % pool.length;
							try {
								var loaded = await PIXI.live2d.Live2DModel.from(pool[target]);
								model = loaded;
								idx = target;
								app.stage.addChild(loaded);
								layout();
								try {
									loaded.motion("idle");
								} catch (e) {}
								wrap.classList.add("is-ready");
								loading = false;
								return true;
							} catch (err) {
								console.warn("[anime-l2d] 模型加载失败:", pool[target], err);
							}
						}
						loading = false;
						return false;
					}

					async function boot() {
						try {
							var res = await fetch("/models-list.json");
							pool = await res.json();
						} catch (e) {
							console.warn("[anime-l2d] models-list.json 加载失败", e);
							return;
						}
						if (!Array.isArray(pool) || !pool.length) return;

						try {
							var vres = await fetch("/voices-list.json");
							voices = await vres.json();
						} catch (e) {}

						if (window.PIXI?.live2d?.config) {
							PIXI.live2d.config.sound = false;
							PIXI.live2d.config.motionSync = true;
						}

						app = new PIXI.Application({
							view: canvas,
							width: wrap.clientWidth || 260,
							height: wrap.clientHeight || 340,
							transparent: true,
							backgroundAlpha: 0,
							antialias: true,
							autoDensity: true,
							resolution: Math.min(window.devicePixelRatio || 1, 2),
						});

						await show(Math.floor(Math.random() * pool.length));

						document.addEventListener("mousemove", function (event) {
							targetX = (event.clientX / window.innerWidth) * 2 - 1;
							targetY = (event.clientY / window.innerHeight) * 2 - 1;
						});

						(function tick() {
							requestAnimationFrame(tick);
							if (!model) return;
							try {
								model.focus(targetX * 1.4, -targetY * 1.4);
							} catch (e) {}
							curX += (targetX * 10 - curX) * 0.06;
							curY += (targetY * 6 - curY) * 0.06;
							model.x = baseX + curX;
							model.y = baseY + curY;
						})();

						canvas.addEventListener("click", function () {
							playMotion();
							playVoice();
							say();
						});

						if (nextBtn) {
							nextBtn.addEventListener("click", async function (event) {
								event.stopPropagation();
								say("换一个新朋友～");
								await show((idx + 1) % pool.length);
							});
						}

						window.addEventListener("resize", layout);
					}

					var wait = setInterval(function () {
						if (window.PIXI && PIXI.live2d) {
							clearInterval(wait);
							boot();
						}
					}, 200);
					setTimeout(function () {
						clearInterval(wait);
					}, 15000);
				})();
			</script>
		</>
	)
}
