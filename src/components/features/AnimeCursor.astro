---
/**
 * 二次元鼠标角色（全站可用）
 * - 鼠标变成一只会跟着你跑的 Q 版看板娘（内联 SVG，无额外图片请求）
 * - 移动时拖出樱花 / 星光拖尾（canvas 绘制，粒子用完即停，不常驻耗电）
 * - 点一下就说话（气泡台词）+ 星光爆开，偶尔配一声看板娘语音
 * - 输入框、可编辑区域自动让位，触屏 / 减少动效时自动降级
 * - 左下角「🎀 角色」开关，状态存 localStorage，离线 APK 内同样生效
 */
---

<button
	id="anime-cursor-toggle"
	type="button"
	class="anime-cursor-toggle"
	title="二次元鼠标角色（点击开关）"
	aria-label="二次元鼠标角色开关"
	aria-pressed="true"
>
	<span class="anime-cursor-toggle-icon" aria-hidden="true">🎀</span>
	<span class="anime-cursor-toggle-text">角色</span>
</button>

<canvas id="anime-cursor-trail" aria-hidden="true"></canvas>

<div id="anime-cursor" class="anime-cursor" aria-hidden="true">
	<svg class="anime-cursor-svg" viewBox="0 0 64 64" width="44" height="44" focusable="false">
		<defs>
			<linearGradient id="ac-hair" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color="#ffe0ee"></stop>
				<stop offset="52%" stop-color="#ffabd3"></stop>
				<stop offset="100%" stop-color="#c9a4ff"></stop>
			</linearGradient>
			<radialGradient id="ac-face" cx="50%" cy="40%" r="62%">
				<stop offset="0%" stop-color="#fff6ee"></stop>
				<stop offset="100%" stop-color="#ffe2cf"></stop>
			</radialGradient>
		</defs>
		<!-- 双马尾 -->
		<ellipse cx="8.5" cy="36" rx="6.5" ry="12" fill="url(#ac-hair)" opacity="0.92"></ellipse>
		<ellipse cx="55.5" cy="36" rx="6.5" ry="12" fill="url(#ac-hair)" opacity="0.92"></ellipse>
		<!-- 后发 -->
		<path d="M32 3c13.5 0 23 9.4 23 22 0 13.4-10.3 25-23 25S9 38.4 9 25C9 12.4 18.5 3 32 3z" fill="url(#ac-hair)"></path>
		<!-- 脸 -->
		<ellipse cx="32" cy="31.5" rx="15.6" ry="15.2" fill="url(#ac-face)"></ellipse>
		<!-- 刘海 -->
		<path
			d="M32 7.4c11.2 0 18.6 7.4 18.6 16.4 0 1.9-.7 3-1.8 3.1-2.8-3.8-5.7-6.6-9.4-7.9-1.7 3.1-4.7 5-8.4 5-2.9 0-5.6-1-7.6-2.8-2.8 2.2-5.4 5-7.4 7.9-1.2-.2-1.9-1.3-1.9-3.2C14.1 15 20.9 7.4 32 7.4z"
			fill="url(#ac-hair)"></path>
		<!-- 呆毛 -->
		<path
			d="M32.5 6.2c.6-4.6 5.6-5.2 6.6-1.2"
			stroke="#ffc9e4"
			stroke-width="2.2"
			fill="none"
			stroke-linecap="round"></path>
		<!-- 眼睛：常态 -->
		<g id="ac-eyes">
			<ellipse cx="25.6" cy="32.2" rx="3.3" ry="4.1" fill="#3b2b50"></ellipse>
			<ellipse cx="38.4" cy="32.2" rx="3.3" ry="4.1" fill="#3b2b50"></ellipse>
			<circle cx="24.6" cy="30.7" r="1.15" fill="#ffffff"></circle>
			<circle cx="37.4" cy="30.7" r="1.15" fill="#ffffff"></circle>
		</g>
		<!-- 眼睛：说话 / 开心 -->
		<g id="ac-eyes-happy" opacity="0">
			<path d="M22.3 33.2q3.4-3.6 6.9 0" stroke="#3b2b50" stroke-width="2" fill="none" stroke-linecap="round"></path>
			<path d="M34.9 33.2q3.4-3.6 6.9 0" stroke="#3b2b50" stroke-width="2" fill="none" stroke-linecap="round"></path>
		</g>
		<!-- 腮红 -->
		<ellipse cx="19.4" cy="37.6" rx="3.5" ry="2" fill="#ff9ec4" opacity="0.5"></ellipse>
		<ellipse cx="44.6" cy="37.6" rx="3.5" ry="2" fill="#ff9ec4" opacity="0.5"></ellipse>
		<!-- 嘴：常态 -->
		<path id="ac-mouth" d="M29.6 41q2.4 2.3 4.8 0" stroke="#b9566f" stroke-width="1.7" fill="none" stroke-linecap="round"></path>
		<!-- 嘴：说话 -->
		<ellipse id="ac-mouth-open" cx="32" cy="41.6" rx="2.5" ry="2.1" fill="#c2576f" opacity="0"></ellipse>
		<!-- 星星 -->
		<g class="anime-cursor-spark" fill="#fff4c2">
			<path d="M52 9l1.1 2.6L55.7 13l-2.6 1.1L52 16.7l-1.1-2.6L48.3 13l2.6-1.4z"></path>
			<path d="M12 12l.8 1.9 1.9.8-1.9.8-.8 1.9-.8-1.9-1.9-.8 1.9-.8z" opacity="0.85"></path>
		</g>
	</svg>
	<div id="anime-cursor-bubble" class="anime-cursor-bubble"></div>
</div>


<style is:global>
	/* 开启后隐藏系统光标（输入类元素保留 I 形光标，方便打字） */
	html.anime-cursor-on,
	html.anime-cursor-on body,
	html.anime-cursor-on body * {
		cursor: none !important;
	}
	html.anime-cursor-on input,
	html.anime-cursor-on textarea,
	html.anime-cursor-on select,
	html.anime-cursor-on [contenteditable="true"] {
		cursor: text !important;
	}

	#anime-cursor-trail {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 999989;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	html.anime-cursor-on #anime-cursor-trail {
		opacity: 1;
	}

	.anime-cursor {
		position: fixed;
		left: 0;
		top: 0;
		width: 44px;
		height: 44px;
		z-index: 1000001;
		pointer-events: none;
		opacity: 0;
		transform: translate3d(-100px, -100px, 0);
		transform-origin: 50% 50%;
		transition: opacity 0.18s ease;
		will-change: transform;
		filter: drop-shadow(0 3px 7px rgba(255, 143, 193, 0.45));
	}
	.anime-cursor.is-visible {
		opacity: 1;
	}
	.anime-cursor.is-hidden {
		opacity: 0;
	}
	.anime-cursor-svg {
		width: 100%;
		height: 100%;
		display: block;
		overflow: visible;
	}
	.anime-cursor.is-talking .anime-cursor-svg {
		animation: ac-talk 0.34s ease-in-out 2;
	}
	@keyframes ac-talk {
		0%,
		100% {
			transform: scale(1) rotate(0deg);
		}
		40% {
			transform: scale(1.12) rotate(-4deg);
		}
		70% {
			transform: scale(1.06) rotate(3deg);
		}
	}
	.anime-cursor.is-talking #ac-eyes {
		opacity: 0;
	}
	.anime-cursor.is-talking #ac-eyes-happy {
		opacity: 1;
	}
	.anime-cursor.is-talking #ac-mouth {
		opacity: 0;
	}
	.anime-cursor.is-talking #ac-mouth-open {
		opacity: 1;
	}
	.anime-cursor-spark {
		animation: ac-sparkle 2.6s ease-in-out infinite;
		transform-origin: 52px 12px;
	}
	@keyframes ac-sparkle {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(0.8) rotate(0deg);
		}
		50% {
			opacity: 1;
			transform: scale(1.15) rotate(18deg);
		}
	}

	/* 说话气泡 */
	.anime-cursor-bubble {
		position: absolute;
		left: 46px;
		bottom: 34px;
		max-width: 210px;
		padding: 6px 10px;
		border-radius: 12px 12px 12px 4px;
		border: 1px solid rgba(255, 154, 200, 0.55);
		background: rgba(28, 20, 40, 0.92);
		color: #ffe6f2;
		font-size: 12px;
		line-height: 1.5;
		white-space: nowrap;
		box-shadow: 0 8px 22px rgba(0, 0, 0, 0.42);
		opacity: 0;
		transform: translateY(6px) scale(0.9);
		transform-origin: 0 100%;
		transition:
			opacity 0.16s ease,
			transform 0.2s cubic-bezier(0.2, 1.4, 0.5, 1);
		pointer-events: none;
	}
	.anime-cursor-bubble.is-open {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.anime-cursor-bubble.is-flip {
		left: auto;
		right: 46px;
		border-radius: 12px 12px 4px 12px;
		transform-origin: 100% 100%;
	}

	/* 点击星光 */
	.anime-cursor-burst {
		position: fixed;
		left: 0;
		top: 0;
		width: 0;
		height: 0;
		z-index: 1000000;
		pointer-events: none;
	}
	.anime-cursor-burst span {
		position: absolute;
		left: 0;
		top: 0;
		font-size: 12px;
		line-height: 1;
		color: #ffd6ec;
		animation: ac-burst 0.62s ease-out forwards;
	}
	@keyframes ac-burst {
		0% {
			opacity: 0.95;
			transform: translate(-50%, -50%) scale(0.4) rotate(0deg);
		}
		100% {
			opacity: 0;
			transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1.15)
				rotate(var(--tr));
		}
	}

	/* 开关按钮 */
	.anime-cursor-toggle {
		position: fixed;
		left: 16px;
		bottom: 154px;
		z-index: 999996;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 7px 13px;
		border-radius: 999px;
		border: 1px solid rgba(255, 154, 200, 0.38);
		background: rgba(18, 16, 28, 0.55);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: #ffd9ea;
		font-size: 12px;
		line-height: 1;
		font-family: inherit;
		cursor: pointer;
		user-select: none;
		box-shadow: 0 6px 22px rgba(255, 143, 193, 0.18);
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			opacity 0.2s ease;
	}
	.anime-cursor-toggle:hover {
		transform: translateY(-2px);
		background: rgba(38, 28, 50, 0.75);
	}
	.anime-cursor-toggle:focus-visible {
		outline: 2px solid rgba(255, 154, 200, 0.8);
		outline-offset: 2px;
	}
	.anime-cursor-toggle.is-off {
		opacity: 0.55;
		border-color: rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.65);
	}
	.anime-cursor-toggle-icon {
		font-size: 13px;
	}
	@media (max-width: 640px) {
		.anime-cursor-toggle {
			left: 10px;
			bottom: 146px;
			padding: 7px 10px;
		}
		.anime-cursor-toggle-text {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.anime-cursor.is-talking .anime-cursor-svg,
		.anime-cursor-spark {
			animation: none;
		}
		.anime-cursor {
			transition: none;
		}
	}
</style>


<script is:inline>
	(function () {
		if (window.__animeCursorInit) return;
		window.__animeCursorInit = true;

		var STORAGE_KEY = "anime-cursor-enabled";
		var reduceMotion =
			window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		// 触屏 / 无悬停设备：不接管光标，但保留点击「星光 + 台词」反馈
		var coarsePointer =
			(window.matchMedia && window.matchMedia("(pointer: coarse)").matches) ||
			(window.matchMedia && !window.matchMedia("(hover: hover)").matches);

		var LINES = [
			"喵～在的在的！",
			"别戳啦 (*/ω＼*)",
			"今天也要元气满满哦",
			"嘿咻～",
			"要一起看番吗？",
			"这里这里！",
			"欸嘿，被你发现了",
			"再点一下试试？",
			"喜欢这个地方吗～",
			"我会一直陪着你的",
		];
		var LINK_LINES = ["出发～", "点这里就对啦", "这就带你去！", "跟紧我哦"];
		var IMG_LINES = ["这张好好看！", "好想住进这幅画里", "截图收藏啦～"];
		var BURST_GLYPHS = ["✦", "★", "✧", "❀", "♡", "✿", "⋆"];

		function read() {
			try {
				var v = localStorage.getItem(STORAGE_KEY);
				return v === null ? true : v === "1";
			} catch (e) {
				return true;
			}
		}
		function write(on) {
			try {
				localStorage.setItem(STORAGE_KEY, on ? "1" : "0");
			} catch (e) {}
		}

		var on = read();

		function els() {
			return {
				cur: document.getElementById("anime-cursor"),
				bubble: document.getElementById("anime-cursor-bubble"),
				canvas: document.getElementById("anime-cursor-trail"),
				toggle: document.getElementById("anime-cursor-toggle"),
			};
		}

		// 光标位置（cx/cy = 实际绘制，tx/ty = 鼠标目标）
		var cx = -100;
		var cy = -100;
		var tx = -100;
		var ty = -100;
		var lastMoveX = 0;
		var tilt = 0;

		var parts = [];
		var running = false;
		var lastTs = 0;
		var lastSpawn = 0;
		var size = { w: 0, h: 0, dpr: 1 };

		function ctxOf() {
			var canvas = els().canvas;
			if (!canvas) return null;
			if (canvas.__ctx) return canvas.__ctx;
			var ctx = canvas.getContext("2d");
			canvas.__ctx = ctx;
			return ctx;
		}

		function resizeCanvas() {
			var canvas = els().canvas;
			if (!canvas) return;
			var dpr = Math.min(2, window.devicePixelRatio || 1);
			size.w = window.innerWidth;
			size.h = window.innerHeight;
			size.dpr = dpr;
			canvas.width = Math.floor(size.w * dpr);
			canvas.height = Math.floor(size.h * dpr);
			canvas.style.width = size.w + "px";
			canvas.style.height = size.h + "px";
			var ctx = ctxOf();
			if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		}

		function spawnTrail(x, y, big) {
			var palette = ["#ffb6d5", "#ffd9ea", "#c9a4ff", "#9fd0ff", "#fff0b8"];
			parts.push({
				x: x,
				y: y,
				vx: (Math.random() - 0.5) * 0.7,
				vy: 0.35 + Math.random() * 0.75,
				rot: Math.random() * Math.PI,
				vr: (Math.random() - 0.5) * 0.16,
				r: (big ? 4.2 : 2.6) + Math.random() * 2.2,
				alpha: big ? 0.85 : 0.62,
				star: Math.random() < 0.28,
				color: palette[Math.floor(Math.random() * palette.length)],
			});
			if (parts.length > 90) parts.splice(0, parts.length - 90);
		}

		function drawParts(ctx) {
			ctx.clearRect(0, 0, size.w, size.h);
			for (var i = parts.length - 1; i >= 0; i--) {
				var p = parts[i];
				p.x += p.vx;
				p.y += p.vy;
				p.vy += 0.012;
				p.rot += p.vr;
				p.alpha -= 0.016;
				if (p.alpha <= 0.02 || p.y > size.h + 20) {
					parts.splice(i, 1);
					continue;
				}
				ctx.save();
				ctx.translate(p.x, p.y);
				ctx.rotate(p.rot);
				ctx.globalAlpha = Math.max(0, p.alpha);
				ctx.fillStyle = p.color;
				ctx.beginPath();
				if (p.star) {
					var r = p.r;
					ctx.moveTo(0, -r);
					ctx.lineTo(r * 0.32, -r * 0.3);
					ctx.lineTo(r, 0);
					ctx.lineTo(r * 0.32, r * 0.3);
					ctx.lineTo(0, r);
					ctx.lineTo(-r * 0.32, r * 0.3);
					ctx.lineTo(-r, 0);
					ctx.lineTo(-r * 0.32, -r * 0.3);
					ctx.closePath();
				} else {
					ctx.ellipse(0, 0, p.r, p.r * 0.58, 0, 0, Math.PI * 2);
				}
				ctx.fill();
				ctx.restore();
			}
		}

		function positionCursor() {
			var cur = els().cur;
			if (!cur) return;
			var vx = tx - cx;
			tilt = Math.max(-16, Math.min(16, tilt + (-vx * 0.55 - tilt) * 0.14));
			// 角色画在光标右下方；贴近视口边缘时收回来，别被裁掉一半
			var px = Math.max(4, Math.min(window.innerWidth - 52, cx + 12));
			var py = Math.max(4, Math.min(window.innerHeight - 56, cy + 8));
			cur.style.transform =
				"translate3d(" +
				Math.round(px) +
				"px," +
				Math.round(py) +
				"px,0) rotate(" +
				tilt.toFixed(1) +
				"deg)";
		}

		function tick(ts) {
			var dt = lastTs ? Math.min(2.6, (ts - lastTs) / 16.7) : 1;
			lastTs = ts;

			var ease = reduceMotion ? 1 : Math.min(1, 0.3 * dt);
			cx += (tx - cx) * ease;
			cy += (ty - cy) * ease;
			positionCursor();

			var ctx = ctxOf();
			if (ctx) drawParts(ctx);

			var moving = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.4;
			if (on && (parts.length || moving)) {
				requestAnimationFrame(tick);
			} else {
				running = false;
				lastTs = 0;
				if (ctx) ctx.clearRect(0, 0, size.w, size.h);
			}
		}

		function startLoop() {
			if (running) return;
			running = true;
			lastTs = 0;
			requestAnimationFrame(tick);
		}

		// ------------------------------ 说话气泡 ------------------------------
		var bubbleTimer = null;
		var talkTimer = null;

		function say(text, hold) {
			var e = els();
			if (!e.bubble || !e.cur) return;
			e.bubble.textContent = text;
			var flip = cx > window.innerWidth - 250;
			e.bubble.classList.toggle("is-flip", flip);
			e.bubble.classList.add("is-open");
			e.cur.classList.add("is-talking");
			if (bubbleTimer) clearTimeout(bubbleTimer);
			if (talkTimer) clearTimeout(talkTimer);
			var stay = hold || 1500 + text.length * 26;
			bubbleTimer = setTimeout(function () {
				var bubble = els().bubble;
				if (bubble) bubble.classList.remove("is-open");
			}, stay);
			talkTimer = setTimeout(function () {
				var cur = els().cur;
				if (cur) cur.classList.remove("is-talking");
			}, 860);
		}

		// ------------------------------ 点击星光 ------------------------------
		function burst(x, y) {
			if (reduceMotion) return;
			var layer = document.createElement("div");
			layer.className = "anime-cursor-burst";
			layer.style.transform = "translate3d(" + x + "px," + y + "px,0)";
			var count = coarsePointer ? 6 : 8;
			for (var i = 0; i < count; i++) {
				var span = document.createElement("span");
				span.textContent = BURST_GLYPHS[Math.floor(Math.random() * BURST_GLYPHS.length)];
				var angle = (Math.PI * 2 * i) / count + Math.random() * 0.5;
				var dist = 22 + Math.random() * 26;
				span.style.setProperty("--tx", Math.round(Math.cos(angle) * dist) + "px");
				span.style.setProperty("--ty", Math.round(Math.sin(angle) * dist) + "px");
				span.style.setProperty("--tr", Math.round(Math.random() * 220 - 110) + "deg");
				span.style.fontSize = 9 + Math.round(Math.random() * 7) + "px";
				layer.appendChild(span);
			}
			document.body.appendChild(layer);
			setTimeout(function () {
				layer.remove();
			}, 700);
		}

		var clickCount = 0;
		var coarseHideTimer = null;
		function react(event) {
			var target = event.target;
			if (target && target.closest && target.closest("#anime-cursor-toggle")) return;
			var x = event.clientX || cx;
			var y = event.clientY || cy;
			if (x && y) {
				tx = x;
				ty = y;
				if (!running) startLoop();
			}
			if (!on) return;
			burst(x, y);

			// 触屏设备没有悬停：让看板娘在点击处冒出来说一句，再自己消失
			if (coarsePointer) {
				var e = els();
				if (e.cur) {
					cx = tx;
					cy = ty;
					positionCursor();
					e.cur.classList.add("is-visible");
					if (coarseHideTimer) clearTimeout(coarseHideTimer);
					coarseHideTimer = setTimeout(function () {
						var again = els().cur;
						if (again) again.classList.remove("is-visible");
					}, 1900);
				}
			}

			var line = LINES[Math.floor(Math.random() * LINES.length)];
			if (target && target.closest) {
				if (target.closest("a")) line = LINK_LINES[Math.floor(Math.random() * LINK_LINES.length)];
				else if (target.closest("img, picture, .post-card-wrapper, [data-awg-kind]"))
					line = IMG_LINES[Math.floor(Math.random() * IMG_LINES.length)];
				else if (target.closest("#anime-wallpaper-panel")) line = "换好啦，喜欢这张吗？";
				else if (target.closest("#anime-voice-panel")) line = "想要我多说几句吗～";
			}
			say(line);

			// 每 5 次点击配一句看板娘语音，避免太吵
			clickCount += 1;
			if (clickCount % 5 === 0 && window.AnimeVoice) {
				try {
					window.AnimeVoice.play();
				} catch (e) {}
			}
		}

		function setOn(next, silent) {
			on = !!next;
			write(on);
			var html = document.documentElement;
			if (on && !coarsePointer) html.classList.add("anime-cursor-on");
			else html.classList.remove("anime-cursor-on");

			var e = els();
			if (e.toggle) {
				e.toggle.classList.toggle("is-off", !on);
				e.toggle.setAttribute("aria-pressed", on ? "true" : "false");
			}
			if (e.cur) {
				// 触屏设备没有悬停指针，角色只在点击时短暂冒出来
				e.cur.classList.toggle("is-visible", on && !coarsePointer);
				if (!on) e.cur.classList.remove("is-talking");
			}
			if (e.bubble) e.bubble.classList.remove("is-open");
			if (!on) {
				parts.length = 0;
				var ctx = ctxOf();
				if (ctx) ctx.clearRect(0, 0, size.w, size.h);
			}
			if (!silent) {
				if (on) say(coarsePointer ? "点一下试试～" : "我来陪你啦～");
				else if (window.AnimeSounds) window.AnimeSounds.play("close", 0.16);
			}
		}

		// ------------------------------ 事件绑定（只绑一次，元素每次重新查询） ------------------------------
		var bound = false;
		function bind() {
			if (bound) return;
			bound = true;

			document.addEventListener(
				"mousemove",
				function (event) {
					tx = event.clientX;
					ty = event.clientY;
					var e = els();
					if (!on) return;
					if (e.cur) e.cur.classList.add("is-visible");
					if (reduceMotion) {
						cx = tx;
						cy = ty;
						positionCursor();
						return;
					}
					startLoop();
					var now = Date.now();
					if (now - lastSpawn > 52) {
						lastSpawn = now;
						var speed = Math.min(30, Math.abs(tx - lastMoveX) * 1.6);
						if (speed > 1.5) spawnTrail(tx + Math.random() * 6 - 3, ty + Math.random() * 6 - 3, speed > 14);
					}
					lastMoveX = tx;
				},
				{ passive: true },
			);

			// 悬停在输入框 / 可编辑区域时，把光标让回去
			document.addEventListener(
				"pointerover",
				function (event) {
					var target = event.target;
					var e = els();
					if (!e.cur || !target || !target.closest) return;
					var typing = target.closest('input, textarea, select, [contenteditable="true"]');
					e.cur.classList.toggle("is-hidden", !!typing && on);
				},
				true,
			);

			document.addEventListener("mouseleave", function () {
				var cur = els().cur;
				if (cur) cur.classList.remove("is-visible");
			});

			document.addEventListener("click", react, true);

			document.addEventListener(
				"click",
				function (event) {
					var target = event.target;
					if (!target || !target.closest) return;
					if (!target.closest("#anime-cursor-toggle")) return;
					event.stopPropagation();
					setOn(!on);
				},
				true,
			);

			document.addEventListener(
				"keydown",
				function (event) {
					// Alt + C 快速开关
					if (event.altKey && (event.key === "c" || event.key === "C")) {
						event.preventDefault();
						setOn(!on);
					}
				},
				true,
			);

			var resizeTimer = null;
			window.addEventListener(
				"resize",
				function () {
					if (resizeTimer) clearTimeout(resizeTimer);
					resizeTimer = setTimeout(resizeCanvas, 200);
				},
				{ passive: true },
			);
			window.addEventListener("scroll", function () {
				var e = els();
				if (!e.cur || !on) return;
				// 页面滚动时系统光标不会触发 mousemove，气泡跟着收起更自然
				if (e.bubble) e.bubble.classList.remove("is-open");
			}, { passive: true });
		}

		function boot() {
			bind();
			resizeCanvas();
			var e = els();
			if (!e.cur) return;
			// 触屏设备不主动说话（角色此时不在屏幕上），只保留开关状态
			if (on && !coarsePointer) say("我来陪你啦～", 1200);
			setOn(on, true);
		}

		window.AnimeCursor = {
			say: function (text) {
				say(text);
			},
			burst: burst,
			isOn: function () {
				return on;
			},
			toggle: function (next) {
				setOn(typeof next === "boolean" ? next : !on);
			},
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", boot);
		} else {
			boot();
		}
		document.addEventListener("swup:page:view", boot);
	})();
</script>
