---
/**
 * PWA / 离线支持（iOS「添加到主屏幕」+ 断网可读）
 *
 * 需求对应：
 * 1. iPhone / iPad 不能装 APK → 用 Safari「分享 → 添加到主屏幕」把本站
 *    变成一个全屏 App（清单见 /manifest.webmanifest，图标用店里那张樱花）；
 * 2. 「在线版」= 直接联网打开，内容永远最新；
 * 3. 「离线版」= 注册 /sw.js 之后，逛过的页面、图片、样式会留在手机里，
 *    地铁 / 飞行模式下还能翻；没缓存到的页面会落到 /offline/ 离线小页面；
 * 4. 状态要温柔可见但不打扰 → 底部一颗小胶囊提示「已离线 / 已恢复 / 有新版本」，
 *    3～6 秒自己消失，有新版本时才出现一个「刷新」小按钮。
 *
 * 开发模式（astro dev）不注册 Service Worker，避免缓存住热更新的页面。
 */
---

<div id="pwa-ios-hint" class="pwa-ios-hint" hidden>
	<span class="pwa-ios-hint-icon" aria-hidden="true">🍎</span>
	<div class="pwa-ios-hint-body">
		<p class="pwa-ios-hint-title">把「我的动漫小屋」装到主屏幕</p>
		<p class="pwa-ios-hint-desc">
			点 Safari 底部的「分享」→「添加到主屏幕」，以后从图标打开就是全屏小屋，断网也能翻逛过的文章。
		</p>
	</div>
	<div class="pwa-ios-hint-actions">
		<a class="pwa-ios-hint-more" href={`${import.meta.env.BASE_URL}ios/`}>看教程</a>
		<button
			id="pwa-ios-hint-close"
			class="pwa-ios-hint-close"
			type="button"
			aria-label="关闭安装提示">✕</button
		>
	</div>
</div>

<div
	id="pwa-toast"
	class="pwa-toast"
	role="status"
	aria-live="polite"
>
	<span class="pwa-toast-dot" id="pwa-toast-dot" aria-hidden="true"></span>
	<span class="pwa-toast-text" id="pwa-toast-text"></span>
	<button id="pwa-toast-action" class="pwa-toast-action" type="button" hidden>
		刷新
	</button>
</div>

<script
	is:inline
	define:vars={{ baseUrl: import.meta.env.BASE_URL, isDev: import.meta.env.DEV }}
>
	(function () {
		var toast = document.getElementById("pwa-toast");
		var textEl = document.getElementById("pwa-toast-text");
		var actionEl = document.getElementById("pwa-toast-action");
		if (!toast || !textEl) return;

		var hideTimer = 0;

		function hideToast() {
			toast.classList.remove("is-visible");
		}

		function showToast(message, tone, timeout, action) {
			window.clearTimeout(hideTimer);

			textEl.textContent = message;
			toast.className = "pwa-toast is-visible" + (tone ? " is-" + tone : "");

			if (actionEl) {
				if (action) {
					actionEl.hidden = false;
					actionEl.onclick = function () {
						hideToast();
						action();
					};
				} else {
					actionEl.hidden = true;
					actionEl.onclick = null;
				}
			}

			if (timeout) {
				hideTimer = window.setTimeout(hideToast, timeout);
			}
		}

		/* ------------------------------------------------ 在线 / 离线状态提示 */

		var root = document.documentElement;

		// html.is-offline 会顺手把看板娘的「加载中」遮罩藏起来（见下面 is:global 样式），
		// 不然断网时 Live2D 模型要等到超时才收场，整页被一块半透明遮罩盖住。
		function setOfflineClass(offline) {
			root.classList.toggle("is-offline", offline);
		}

		function showOffline() {
			setOfflineClass(true);
			showToast("已离线 · 正在显示缓存内容 📴", "offline", 6000);
		}

		window.addEventListener("offline", showOffline);
		window.addEventListener("online", function () {
			setOfflineClass(false);
			showToast("网络回来啦 · 已恢复在线 🌸", "online", 3600);
		});

		if (navigator.onLine === false) {
			setOfflineClass(true);
			window.setTimeout(showOffline, 1200);
		}

		/* ------------------------- iPhone / iPad：引导「添加到主屏幕」（装成 App） */

		var iosHint = document.getElementById("pwa-ios-hint");
		var IOS_HINT_KEY = "pwa-ios-hint-dismissed-at";
		var IOS_HINT_COOLDOWN = 14 * 24 * 60 * 60 * 1000; // 关掉后两周内不再烦你

		// 原生外壳（ios/ 下的 WKWebView 工程）会在 UA 末尾追加 FireflyApp/3.0.2，
		// 这种情况本身就已经是 App，不用再劝用户「添加到主屏幕」。
		function isFireflyShell() {
			return /FireflyApp\//.test(navigator.userAgent || "");
		}

		function isIosDevice() {
			var ua = navigator.userAgent || "";
			if (/iPad|iPhone|iPod/.test(ua)) return true;
			// iPadOS 13+ 默认冒充 Mac，用触点数区分
			return navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1;
		}

		function isStandaloneApp() {
			return (
				window.navigator.standalone === true ||
				(window.matchMedia &&
					window.matchMedia("(display-mode: standalone)").matches)
			);
		}

		function iosHintDismissed() {
			try {
				var at = Number(window.localStorage.getItem(IOS_HINT_KEY) || 0);
				return at > 0 && Date.now() - at < IOS_HINT_COOLDOWN;
			} catch (error) {
				return false;
			}
		}

		function hideIosHint(remember) {
			if (!iosHint) return;
			iosHint.classList.remove("is-visible");
			window.setTimeout(function () {
				iosHint.hidden = true;
			}, 280);
			if (remember) {
				try {
					window.localStorage.setItem(IOS_HINT_KEY, String(Date.now()));
				} catch (error) {
					// 无痕模式下写不了，下次再提示一次也无所谓
				}
			}
		}

		// 已经在主屏幕上打开（standalone）就不再劝你安装；原生壳里也不用
		if (
			iosHint &&
			isIosDevice() &&
			!isFireflyShell() &&
			!isStandaloneApp() &&
			!iosHintDismissed()
		) {
			window.setTimeout(function () {
				iosHint.hidden = false;
				// 稍等一帧再加 class，过渡动画才会生效（不用 rAF：省电模式下可能被挂起）
				window.setTimeout(function () {
					iosHint.classList.add("is-visible");
				}, 30);
			}, 4200);

			var iosHintClose = document.getElementById("pwa-ios-hint-close");
			if (iosHintClose) {
				iosHintClose.addEventListener("click", function () {
					hideIosHint(true);
				});
			}

			// 用户真的去添加主屏幕了：切回来时如果已经是 standalone，就悄悄收起来
			document.addEventListener("visibilitychange", function () {
				if (!iosHint.hidden && isStandaloneApp()) hideIosHint(false);
			});
		}

		/* --------------------------------------------------- 注册 Service Worker */

		var isSecure =
			location.protocol === "https:" ||
			location.hostname === "localhost" ||
			location.hostname === "127.0.0.1" ||
			location.hostname === "[::1]";

		if (isDev || !isSecure || !("serviceWorker" in navigator)) {
			return;
		}

		var swUrl = baseUrl + "sw.js";
		var reloading = false;

		function promptUpdate(registration) {
			showToast("有新版本啦 · 点右边刷新 ✨", "update", 0, function () {
				if (registration.waiting) {
					registration.waiting.postMessage({ type: "SKIP_WAITING" });
				}
			});
		}

		navigator.serviceWorker.addEventListener("controllerchange", function () {
			if (reloading) return;
			reloading = true;
			location.reload();
		});

		function register() {
			navigator.serviceWorker
				.register(swUrl, { scope: baseUrl })
				.then(function (registration) {
					// 已经有一个装好的新版本在排队
					if (registration.waiting && navigator.serviceWorker.controller) {
						promptUpdate(registration);
					}

					registration.addEventListener("updatefound", function () {
						var installing = registration.installing;
						if (!installing) return;

						installing.addEventListener("statechange", function () {
							if (
								installing.state === "installed" &&
								navigator.serviceWorker.controller
							) {
								promptUpdate(registration);
							}
						});
					});
				})
				.catch(function () {
					// 注册失败（比如 Safari 无痕模式）就安静地当普通网页用
				});
		}

		if (document.readyState === "complete") {
			register();
		} else {
			window.addEventListener("load", register);
		}
	})();
</script>

<style>
	/* iPhone / iPad「添加到主屏幕」引导条 */
	.pwa-ios-hint {
		position: fixed;
		left: 50%;
		bottom: calc(16px + env(safe-area-inset-bottom, 0px));
		z-index: 1000004;
		display: flex;
		align-items: flex-start;
		gap: 10px;
		width: min(94vw, 430px);
		padding: 12px 14px;
		border-radius: 18px;
		border: 1px solid rgba(255, 154, 200, 0.42);
		background: rgba(255, 251, 253, 0.96);
		color: #6b4a5c;
		box-shadow: 0 16px 36px rgba(224, 68, 143, 0.2);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 16px);
		transition:
			opacity 0.28s ease,
			transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.pwa-ios-hint[hidden] {
		display: none;
	}

	.pwa-ios-hint.is-visible {
		opacity: 1;
		pointer-events: auto;
		transform: translate(-50%, 0);
	}

	.pwa-ios-hint-icon {
		flex: 0 0 auto;
		font-size: 17px;
		line-height: 1.3;
	}

	.pwa-ios-hint-body {
		min-width: 0;
	}

	.pwa-ios-hint-title {
		margin: 0 0 3px;
		font-size: 12.5px;
		font-weight: 700;
		color: #d6407f;
	}

	.pwa-ios-hint-desc {
		margin: 0;
		font-size: 11.5px;
		line-height: 1.6;
		color: #9a7c8d;
	}

	.pwa-ios-hint-actions {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
	}

	.pwa-ios-hint-more {
		padding: 5px 10px;
		border-radius: 999px;
		background: linear-gradient(135deg, #ff8ab8, #b79cff);
		color: #fff;
		font-size: 11.5px;
		font-weight: 700;
		white-space: nowrap;
		text-decoration: none;
	}

	.pwa-ios-hint-close {
		padding: 2px 4px;
		border: 0;
		background: transparent;
		color: #c0a5b4;
		font-size: 12px;
		line-height: 1;
		cursor: pointer;
	}

	:global(html.dark) .pwa-ios-hint {
		border-color: rgba(255, 154, 200, 0.26);
		background: rgba(36, 26, 44, 0.95);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.42);
	}

	:global(html.dark) .pwa-ios-hint-title {
		color: #ffb3d4;
	}

	:global(html.dark) .pwa-ios-hint-desc {
		color: #cbb2c2;
	}

	.pwa-toast {
		position: fixed;
		left: 50%;
		bottom: 18px;
		z-index: 1000003;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		max-width: min(92vw, 420px);
		padding: 9px 15px;
		border-radius: 999px;
		border: 1px solid rgba(255, 154, 200, 0.36);
		background: rgba(30, 22, 38, 0.8);
		color: #ffe1ee;
		font-size: 12.5px;
		line-height: 1.15;
		box-shadow: 0 10px 26px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 14px);
		transition:
			opacity 0.24s ease,
			transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.pwa-toast.is-visible {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.pwa-toast-dot {
		flex: 0 0 auto;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ffb3d4;
		box-shadow: 0 0 0 4px rgba(255, 179, 212, 0.18);
	}

	.pwa-toast.is-online .pwa-toast-dot {
		background: #7ee2b8;
		box-shadow: 0 0 0 4px rgba(126, 226, 184, 0.2);
	}

	.pwa-toast.is-offline .pwa-toast-dot {
		background: #ffc46b;
		box-shadow: 0 0 0 4px rgba(255, 196, 107, 0.2);
	}

	.pwa-toast.is-update .pwa-toast-dot {
		background: #b79cff;
		box-shadow: 0 0 0 4px rgba(183, 156, 255, 0.22);
	}

	.pwa-toast-text {
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.pwa-toast-action {
		flex: 0 0 auto;
		pointer-events: auto;
		padding: 5px 11px;
		border: 0;
		border-radius: 999px;
		background: linear-gradient(135deg, #ff8ab8, #b79cff);
		color: #fff;
		font-family: inherit;
		font-size: 11.5px;
		font-weight: 700;
		cursor: pointer;
	}

	.pwa-toast-action[hidden] {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.pwa-toast {
			transition: opacity 0.2s ease;
			transform: translate(-50%, 0);
		}
	}
</style>

<!-- 断网时：看板娘的启动遮罩 / 欢迎视频拿不到模型文件，会一直卡在「加载中」，
     这里只在 html.is-offline 时把它们收起来，联网时完全不受影响 -->
<style is:global>
	html.is-offline #l2d-loading,
	html.is-offline #l2d-splash,
	html.is-offline #l2d-video-wrap,
	html.is-offline #l2d-welcome,
	html.is-offline #l2d-boot-tip {
		display: none !important;
	}
</style>
