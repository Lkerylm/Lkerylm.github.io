		function burst(x, y) {
			if (reduceMotion) return;
			var layer = document.createElement("div");
			layer.className = "acx-burst";
			layer.style.transform = "translate3d(" + x + "px," + y + "px,0)";
			var count = coarse ? 6 : 8;
			for (var i = 0; i < count; i++) {
				var span = document.createElement("span");
				span.textContent = BURST_GLYPHS[Math.floor(Math.random() * BURST_GLYPHS.length)];
				var angle = (Math.PI * 2 * i) / count + Math.random() * 0.5;
				var dist = 22 + Math.random() * 26;
				span.style.setProperty("--tx", Math.round(Math.cos(angle) * dist) + "px");
				span.style.setProperty("--ty", Math.round(Math.sin(angle) * dist) + "px");
				span.style.setProperty("--tr", Math.round(Math.random() * 220 - 110) + "deg");
				span.style.fontSize = 9 + Math.round(Math.random() * 7) + "px";
				layer.appendChild(span);
			}
			document.body.appendChild(layer);
			setTimeout(function () {
				layer.remove();
			}, 700);
		}

		// 点一下让角色「弹一下」：系统箭头藏起来后，这是最直观的点击反馈
		function popStage() {
			var st = els().stage;
			if (!st || reduceMotion) return;
			st.classList.remove("is-pop");
			// 读一次布局，保证连点时动画也能重新播
			void st.offsetWidth;
			st.classList.add("is-pop");
			setTimeout(function () {
				var s = els().stage;
				if (s) s.classList.remove("is-pop");
			}, 400);
		}

		// ------------------------------ 樱花 / 星光拖尾 ------------------------------
		var parts = [];
		var trailLooping = false;
		var trailSpawnAt = 0;
		var trailSize = { w: 0, h: 0 };

		function trailCtx() {
			var c = els().trail;
			if (!c) return null;
			if (c.__ctx) return c.__ctx;
			c.__ctx = c.getContext("2d");
			return c.__ctx;
		}

		function resizeTrail() {
			var c = els().trail;
			if (!c) return;
			var dpr = Math.min(2, window.devicePixelRatio || 1);
			trailSize.w = window.innerWidth;
			trailSize.h = window.innerHeight;
			c.width = Math.floor(trailSize.w * dpr);
			c.height = Math.floor(trailSize.h * dpr);
			c.style.width = trailSize.w + "px";
			c.style.height = trailSize.h + "px";
			var ctx = trailCtx();
			if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		}

		function spawnTrail(x, y, big) {
			var palette = ["#ffb6d5", "#ffd9ea", "#c9a4ff", "#9fd0ff", "#fff0b8"];
			parts.push({
				x: x,
				y: y,
				vx: (Math.random() - 0.5) * 0.7,
				vy: 0.35 + Math.random() * 0.75,
				rot: Math.random() * Math.PI,
				vr: (Math.random() - 0.5) * 0.16,
				r: (big ? 4 : 2.4) + Math.random() * 2,
				alpha: big ? 0.85 : 0.6,
				star: Math.random() < 0.28,
				color: palette[Math.floor(Math.random() * palette.length)],
			});
			if (parts.length > 80) parts.splice(0, parts.length - 80);
		}

		function drawTrail(ctx, dt) {
			var k = dt / 16.7;
			ctx.clearRect(0, 0, trailSize.w, trailSize.h);
			for (var i = parts.length - 1; i >= 0; i--) {
				var p = parts[i];
				p.x += p.vx * k;
				p.y += p.vy * k;
				p.vy += 0.012 * k;
				p.rot += p.vr * k;
				p.alpha -= 0.016 * k;
				if (p.alpha <= 0.02 || p.y > trailSize.h + 20) {
					parts.splice(i, 1);
					continue;
				}
				ctx.save();
				ctx.translate(p.x, p.y);
				ctx.rotate(p.rot);
				ctx.globalAlpha = Math.max(0, p.alpha);
				ctx.fillStyle = p.color;
				ctx.beginPath();
				if (p.star) {
					var r = p.r;
					ctx.moveTo(0, -r);
					ctx.lineTo(r * 0.32, -r * 0.3);
					ctx.lineTo(r, 0);
					ctx.lineTo(r * 0.32, r * 0.3);
					ctx.lineTo(0, r);
					ctx.lineTo(-r * 0.32, r * 0.3);
					ctx.lineTo(-r, 0);
					ctx.lineTo(-r * 0.32, -r * 0.3);
					ctx.closePath();
				} else {
					ctx.ellipse(0, 0, p.r, p.r * 0.58, 0, 0, Math.PI * 2);
				}
				ctx.fill();
				ctx.restore();
			}
		}

		function trailLoop() {
			if (trailLooping) return;
			trailLooping = true;
			var last = 0;
			function step(ts) {
				var dt = last ? Math.min(64, ts - last) : 16.7;
				last = ts;
				var ctx = trailCtx();
				if (ctx) drawTrail(ctx, dt);
				if (state.enabled && parts.length) {
					requestAnimationFrame(step);
				} else {
					trailLooping = false;
					parts.length = 0;
					if (ctx) ctx.clearRect(0, 0, trailSize.w, trailSize.h);
				}
			}
			requestAnimationFrame(step);
		}

		function maybeTrail(x, y) {
			if (!state.enabled || reduceMotion || coarse) return;
			var now = Date.now();
			if (now - trailSpawnAt < 58) return;
			trailSpawnAt = now;
			spawnTrail(x + Math.random() * 6 - 3, y + Math.random() * 6 - 3, Math.random() < 0.22);
			trailLoop();
		}

		// ------------------------------ 和渲染 iframe 通信 ------------------------------
		var frameReady = false;
		var frameReadyResolvers = [];
		var frameWaiters = {};
		var reqSeq = 0;

		function postToFrame(msg) {
			var frame = els().frame;
			if (!frame || !frame.contentWindow) return false;
			try {
				frame.contentWindow.postMessage(msg, "*");
				return true;
			} catch (e) {
				return false;
			}
		}

		function onFrameMessage(e) {
			var frame = els().frame;
			if (!frame || e.source !== frame.contentWindow) return;
			var d = e.data || {};
			if (d.type === "ready") {
				frameReady = true;
				frameReadyResolvers.splice(0).forEach(function (fn) {
					fn(true);
				});
			} else if (d.type === "fatal") {
				frameReadyResolvers.splice(0).forEach(function (fn) {
					fn(false);
				});
			} else if ((d.type === "loaded" || d.type === "error") && d.id && frameWaiters[d.id]) {
				var fn = frameWaiters[d.id];
				delete frameWaiters[d.id];
				fn(d.type === "loaded");
			}
		}

		function waitFrameReady() {
			if (frameReady) return Promise.resolve(true);
			return new Promise(function (resolve) {
				frameReadyResolvers.push(resolve);
				setTimeout(function () {
					var i = frameReadyResolvers.indexOf(resolve);
					if (i >= 0) {
						frameReadyResolvers.splice(i, 1);
						resolve(frameReady);
					}
				}, FRAME_READY_TIMEOUT);
			});
		}

		/** GitHub Pages 模型 → jsDelivr 镜像（safe 仓库太大，镜像不了） */
		function candidatesOf(url) {
			var list = [url];
			var m = /^https?:\/\/lkerylm\.github\.io\/([^\/?#]+)\/(.+)$/i.exec(url || "");
			if (m && m[1] !== "firefly-live2d-safe") {
				list.push("https://fastly.jsdelivr.net/gh/Lkerylm/" + m[1] + "@main/" + m[2]);
			}
			return list;
		}

		function requestLoad(url, timeoutMs) {
			var frame = els().frame;
			if (!frame || !frame.contentWindow) return Promise.resolve(false);
			var id = "r" + ++reqSeq;
			return new Promise(function (resolve) {
				var done = false;
				var timer = setTimeout(function () {
					if (done) return;
					done = true;
					delete frameWaiters[id];
					resolve(false);
				}, timeoutMs || 50000);
				frameWaiters[id] = function (ok) {
					if (done) return;
					done = true;
					clearTimeout(timer);
					resolve(ok);
				};
				try {
					frame.contentWindow.postMessage(
						{ type: "load", id: id, url: url, urls: candidatesOf(url) },
						"*",
					);
				} catch (e) {
					clearTimeout(timer);
					delete frameWaiters[id];
					resolve(false);
				}
			});
		}

		// ------------------------------ 模型目录 / 轮换池 ------------------------------
		function fetchJson(url) {
			return fetch(url, { credentials: "same-origin" })
				.then(function (r) {
					return r.ok ? r.json() : null;
				})
				.catch(function () {
					return null;
				});
		}

		function customModels() {
			try {
				var a = JSON.parse(lsGet(KEY_CUSTOM, "[]"));
				return Array.isArray(a)
					? a.filter(function (u) {
							return typeof u === "string" && u;
						})
					: [];
			} catch (e) {
				return [];
			}
		}

		function nameOfUrl(u) {
			var m = /([^\/]+)\.model3?\.json$/i.exec(u || "");
			return m ? m[1] : u;
		}

		async function loadCatalogs() {
			if (catalog.official.length || catalog.local.length) return;
			var res = await Promise.all([
				fetchJson("/models-list.json"),
				fetchJson("/models-safe-catalog.json"),
				fetchJson("/models-catalog.json"),
			]);
			var local = Array.isArray(res[0]) ? res[0] : [];
			var safe = Array.isArray(res[1]) ? res[1] : (res[1] && res[1].models) || [];
			var all = Array.isArray(res[2]) ? res[2] : (res[2] && res[2].models) || [];
			catalog.local = local.map(function (u, i) {
				return {
					name: i === 0 ? "Firefly 流萤（本站内置）" : "本站模型 " + (i + 1),
					url: u,
					mb: null,
					tag: "本站",
				};
			});
			catalog.official = safe.map(function (m) {
				return { name: m.name || "官方示例", url: m.url, mb: m.mb || null, tag: "官方" };
			});
			catalog.big = all.map(function (m) {
				return { name: m.name || "模型", url: m.url, mb: m.mb || null, tag: "更多" };
			});
			syncCustom();
			renderList();
		}

		function syncCustom() {
			catalog.custom = customModels().map(function (u) {
				return { name: nameOfUrl(u), url: u, mb: null, tag: "我的", removable: true };
			});
		}

		/** 轮换池 = 本站内置 + 官方轻量模型 + 自己加的模型 */
		function buildRotationPool() {
			var pool = [];
			function push(m) {
				if (!m || !m.url) return;
				for (var i = 0; i < pool.length; i++) if (pool[i].url === m.url) return;
				pool.push(m);
			}
			catalog.local.forEach(push);
			catalog.official.forEach(function (m) {
				if (!m.mb || m.mb <= ROTATE_MAX_MB) push(m);
			});
			catalog.custom.forEach(push);
			// 离线时（APK 断网）只留本站内置模型，别去拉 CDN 白等几十秒
			if (navigator.onLine === false) {
				pool = pool.filter(function (m) {
					return !/^https?:/i.test(m.url);
				});
			}
			return pool;
		}

		// ------------------------------ 尺寸 / 换装 ------------------------------
		function stageSize() {
			return SIZES[state.size] || SIZES.m;
		}

		function applySize() {
			var s = stageSize();
			var stage = els().stage;
			if (stage) {
				stage.style.width = s.w + "px";
				stage.style.height = s.h + "px";
			}
			postToFrame({ type: "size", w: s.w, h: s.h });
		}

		function playMotion() {
			postToFrame({ type: "motion" });
		}

		async function applyModel(url, quiet) {
			if (!url || state.loading) return false;
			if (!frameReady) {
				var okFrame = await waitFrameReady();
				if (!okFrame) {
					failSoft("Live2D 运行库加载失败");
					return false;
				}
			}
			state.loading = true;
			hint(quiet ? "" : "换装中…");
			var ok = await requestLoad(url, quiet ? 45000 : 60000);
			state.loading = false;
			if (!ok) {
				state.failed[url] = true;
				hint("这个模型下不来…换一个试试", 3200);
				return false;
			}
			state.model = true;
			state.src = url;
			delete state.failed[url];
			hint("");
			// 模型真的出来了才把「角色在位」标记打开（拖尾 / 文案样式都挂在这个 class 上）
			document.documentElement.classList.add("acx-on");
			// 模型到位后再打招呼，气泡不会孤零零地飘在页面上
			if (state.enabled && !greetedOnce) {
				greetedOnce = true;
				say("我来陪你啦～");
			}
			playMotion();
			lsSet(KEY_SRC, url);
			state.lastRotate = Date.now();
			renderList();
			return true;
		}

		function pickFromPool(pool, current) {
			var usable = pool.filter(function (m) {
				return !state.failed[m.url] && m.url !== current;
			});
			if (!usable.length) {
				usable = pool.filter(function (m) {
					return !state.failed[m.url];
				});
			}
			if (!usable.length) return "";
			return usable[Math.floor(Math.random() * usable.length)].url;
		}

		function next() {
			var pool = buildRotationPool();
			if (!pool.length) return;
			applyModel(pickFromPool(pool, state.src));
		}

		function rotateTick() {
			if (!state.enabled || !state.rotate || state.loading) return;
			if (document.hidden) return;
			// 只有鼠标停下来（空闲）时才换，免得你正看着它突然变脸
			if (state.idleOnly && Date.now() - state.lastMove < IDLE_MS) return;
			if (Date.now() - state.lastRotate < state.rotate * 1000) return;
			var pool = buildRotationPool();
			if (pool.length < 2) return;
			var url = pickFromPool(pool, state.src);
			if (url) applyModel(url, true);
		}

		function startRotate() {
			if (rotateTimer) clearInterval(rotateTimer);
			rotateTimer = setInterval(rotateTick, 5000);
		}

		// ------------------------------ 模型库面板 ------------------------------
		function escapeHtml(s) {
			return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
				return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
			});
		}

		function renderList(filter) {
			var list = els().list;
			if (!list) return;
			var q = (filter || "").trim().toLowerCase();
			var groups = [
				{ title: "我的模型", items: catalog.custom },
				{ title: "本站 / 官方示例", items: catalog.official.concat(catalog.local) },
				{ title: "更多模型（体积较大）", items: catalog.big },
			];
			var html = "";
			groups.forEach(function (g) {
				var items = g.items.filter(function (m) {
					if (!q) return true;
					return (m.name || "").toLowerCase().indexOf(q) >= 0 || String(m.mb || "").indexOf(q) >= 0;
				});
				if (!items.length) return;
				html += '<div class="acx-sect">' + g.title + " · " + items.length + "</div>";
				items.slice(0, q ? 80 : 400).forEach(function (m) {
					var active = m.url === state.src ? " is-active" : "";
					var meta = (m.tag || "") + (m.mb ? " · " + m.mb + "MB" : "");
					html +=
						'<button type="button" class="acx-item' +
						active +
						'" data-url="' +
						escapeHtml(m.url) +
						'">' +
						'<span class="acx-item-name">' +
						escapeHtml(m.name || m.url) +
						"</span>" +
						'<span class="acx-item-meta">' +
						escapeHtml(meta) +
						"</span>" +
						(m.removable
							? '<span class="acx-del" data-url="' + escapeHtml(m.url) + '" title="移除">✕</span>'
							: "") +
						"</button>";
				});
			});
			if (!html) html = '<div class="acx-sect">没有匹配的模型</div>';
			list.innerHTML = html;
		}

		function openPanel() {
			var p = els().panel;
			if (!p) return;
			p.hidden = false;
			if (!catalog.official.length) loadCatalogs();
			renderList(els().search ? els().search.value : "");
			if (els().search) {
				try {
					els().search.focus({ preventScroll: true });
				} catch (e) {}
			}
		}

		function closePanel() {
			var p = els().panel;
			if (p) p.hidden = true;
		}

		function pick(url) {
			if (!url) return;
			applyModel(url);
		}

		function addCustom() {
			var input = els().customInput;
			if (!input) return;
			var url = (input.value || "").trim();
			if (!/^https?:\/\/.+/i.test(url) && !/^\/.+\.json$/i.test(url)) {
				hint("要填 http(s) 开头的 .model3.json 地址哦", 3000);
				return;
			}
			var list = customModels();
			if (list.indexOf(url) === -1) list.push(url);
			lsSet(KEY_CUSTOM, JSON.stringify(list.slice(-30)));
			input.value = "";
			syncCustom();
			renderList(els().search ? els().search.value : "");
			applyModel(url);
		}

		function removeCustom(url) {
			var list = customModels().filter(function (u) {
				return u !== url;
			});
			lsSet(KEY_CUSTOM, JSON.stringify(list));
			syncCustom();
			renderList(els().search ? els().search.value : "");
			hint("已从「我的模型」里移除", 1800);
		}

		// ------------------------------ 开关 / 跟随 / 启动 ------------------------------
		function setOn(v, silent) {
			state.enabled = !!v;
			lsSet(KEY_ON, state.enabled ? "1" : "0");
			var e = els();
			if (e.toggle) {
				e.toggle.classList.toggle("is-on", state.enabled);
				e.toggle.classList.toggle("is-off", !state.enabled);
				e.toggle.setAttribute("aria-pressed", state.enabled ? "true" : "false");
			}
			if (e.next) e.next.hidden = !state.enabled;
			if (e.open) e.open.hidden = !state.enabled;
			if (!state.enabled) {
				closePanel();
				document.documentElement.classList.remove("acx-on");
				document.documentElement.classList.remove("acx-cursor-none");
				if (e.stage) e.stage.classList.remove("is-visible");
				if (e.bubble) e.bubble.classList.remove("is-open");
				parts.length = 0;
				var tctx = trailCtx();
				if (tctx) tctx.clearRect(0, 0, trailSize.w, trailSize.h);
				postToFrame({ type: "pause" });
			} else {
				if (e.stage) e.stage.classList.add("is-visible");
				// 关掉时摘过 acx-on，再打开要补回来（拖尾、藏光标都挂在它上面）
				if (state.model) document.documentElement.classList.add("acx-on");
				resizeTrail();
				init();
				postToFrame({ type: "resume" });
			}
			if (!silent) {
				// 打开时说一句；关掉时角色已经下班，气泡看不见，就用按钮音效收尾
				if (state.enabled) say("换我上场陪你啦～");
				else if (window.AnimeSounds) {
					try {
						window.AnimeSounds.play("close", 0.16);
					} catch (err) {}
				}
			}
		}

		function failSoft(msg) {
			console.warn("[acx]", msg);
			state.enabled = false;
			// 记成「未初始化」，下次点开关还能再试一次（网络恢复后不用刷新）
			state.inited = false;
			lsSet(KEY_ON, "0");
			document.documentElement.classList.remove("acx-on");
			document.documentElement.classList.remove("acx-cursor-none");
			var e = els();
			if (e.toggle) {
				e.toggle.classList.remove("is-on");
				e.toggle.classList.add("is-off");
				e.toggle.setAttribute("aria-pressed", "false");
			}
			if (e.next) e.next.hidden = true;
			if (e.open) e.open.hidden = true;
			if (e.stage) e.stage.classList.remove("is-visible");
			postToFrame({ type: "pause" });
		}

		var rafId = 0;
		function startFollow() {
			if (rafId) return;
			var lastHideCursor = null;
			function loop() {
				rafId = requestAnimationFrame(loop);
				var st = els().stage;
				if (!st || !state.enabled) {
					// 关掉（或元素还没就绪）时把系统光标放回来；
					// 这里的 lastHideCursor 必须跟着归位，否则下次打开会因为「状态没变」而不再藏光标
					if (lastHideCursor !== false) {
						lastHideCursor = false;
						document.documentElement.classList.remove("acx-cursor-none");
					}
					return;
				}
				var w = st.offsetWidth || stageSize().w;
				var h = st.offsetHeight || stageSize().h;
				// 角色中心 = 光标位置：它就是鼠标指针本身。
				// 不做贴边夹取——一靠边就被推开的话，指哪儿点哪儿就对不上了
				var bx = state.pointerX - w / 2;
				var by = state.pointerY - h / 2;
				// 模型没出来之前慢慢飘过去，出来之后严格跟手
				var k = reduceMotion ? 1 : state.model ? 1 : 0.32;
				state.drawX += (bx - state.drawX) * k;
				state.drawY += (by - state.drawY) * k;
				var bob = reduceMotion ? 0 : Math.sin(Date.now() / 620) * 1.2;
				st.style.transform =
					"translate3d(" +
					Math.round(state.drawX) +
					"px," +
					Math.round(state.drawY + bob) +
					"px,0)";
				// 系统箭头只在「角色真的在」的时候藏起来；打字 / 触屏时让开
				var hideCursor =
					state.enabled &&
					state.model &&
					!coarse &&
					!state.typing &&
					st.classList.contains("is-visible");
				if (hideCursor !== lastHideCursor) {
					lastHideCursor = hideCursor;
					document.documentElement.classList.toggle("acx-cursor-none", hideCursor);
				}
			}
			rafId = requestAnimationFrame(loop);
		}

		async function init() {
			if (state.inited) {
				if (frameReady) postToFrame({ type: "resume" });
				return;
			}
			state.inited = true;
			hint("召唤看板娘…");
			var ok = await waitFrameReady();
			if (!ok) {
				failSoft("Live2D 运行库加载失败");
				return;
			}
			await loadCatalogs();
			applySize();
			startFollow();
			var saved = lsGet(KEY_SRC, "");
			var pool = buildRotationPool();
			var first = saved || (catalog.local[0] && catalog.local[0].url) || pickFromPool(pool, "");
			var loaded = await applyModel(first, true);
			if (!loaded && saved) {
				lsDel(KEY_SRC);
				loaded = await applyModel(pickFromPool(pool, saved), true);
			}
			if (!loaded) {
				failSoft("模型加载失败，可能是网络问题");
				return;
			}
			startRotate();
		}

		// ------------------------------ 事件绑定 ------------------------------
		function bind() {
			if (bind.done) return;
			bind.done = true;
			var root = document;

			root.addEventListener(
				"mousemove",
				function (e) {
					state.pointerX = e.clientX;
					state.pointerY = e.clientY;
					state.lastMove = Date.now();
					var st = els().stage;
					if (st && state.enabled) {
						st.classList.add("is-visible");
						st.classList.remove("is-hidden");
					}
					maybeTrail(e.clientX, e.clientY);
					// 第一次动鼠标时打个招呼（等模型真的出来再说，免得气泡悬空）
					if (state.enabled && state.model && !greetedOnce) {
						greetedOnce = true;
						say("我来陪你啦～");
					}
				},
				{ passive: true },
			);

			// 输入框 / 可编辑区域里把角色让开，别挡着打字
			root.addEventListener(
				"pointerover",
				function (e) {
					var st = els().stage;
					if (!st || !state.enabled) return;
					var t = e.target;
					var typing =
						t && t.closest && t.closest('input, textarea, select, [contenteditable="true"]');
					state.typing = !!typing;
					st.classList.toggle("is-typing", !!typing);
				},
				true,
			);

			root.addEventListener("mouseleave", function () {
				var st = els().stage;
				if (st) st.classList.remove("is-visible");
				var b = els().bubble;
				if (b) b.classList.remove("is-open");
				state.typing = false;
				document.documentElement.classList.remove("acx-cursor-none");
			});

			// 渲染 iframe 的回执（ready / loaded / error）
			window.addEventListener("message", onFrameMessage);

			// 点一下：说一句台词 + 星光炸开 + 偶尔做个 Live2D 动作
			root.addEventListener(
				"click",
				function (e) {
					if (!state.enabled) return;
					var t = e.target;
					// 点自己的按钮 / 面板不算「和角色互动」
					if (t && t.closest && t.closest("#acx-dock, #acx-panel")) return;
					var x = typeof e.clientX === "number" && e.clientX ? e.clientX : state.pointerX;
					var y = typeof e.clientY === "number" && e.clientY ? e.clientY : state.pointerY;
					burst(x, y);
					popStage();
					// 模型还没出来就先不弹台词（星光照旧，点哪儿都有反馈）
					if (!state.model) return;

					var line = LINES[Math.floor(Math.random() * LINES.length)];
					if (t && t.closest) {
						if (t.closest("a")) line = LINK_LINES[Math.floor(Math.random() * LINK_LINES.length)];
						else if (t.closest("img, picture, .post-card-wrapper, [data-awg-kind]"))
							line = IMG_LINES[Math.floor(Math.random() * IMG_LINES.length)];
						else if (t.closest("#anime-wallpaper-panel")) line = "换好啦，喜欢这张吗？";
						else if (t.closest("#anime-voice-panel")) line = "想要我多说几句吗～";
					}
					say(line);

					// 每 5 次点击配一句看板娘语音，别太吵
					clickCount += 1;
					if (clickCount % 5 === 0 && window.AnimeVoice) {
						try {
							window.AnimeVoice.play();
						} catch (err) {}
					}

					if (Date.now() - state.lastMotion < 500) return;
					state.lastMotion = Date.now();
					if (Math.random() < 0.7) playMotion();
				},
				true,
			);

			root.addEventListener("visibilitychange", function () {
				postToFrame({ type: document.hidden ? "pause" : "resume" });
			});

			root.addEventListener("keydown", function (e) {
				// Alt + C 快速开关（和 3.0.0 的手绘角色保持一致的手感）
				if (e.altKey && (e.key === "c" || e.key === "C")) {
					e.preventDefault();
					setOn(!state.enabled);
					return;
				}
				if (e.key === "Escape") closePanel();
				var t = e.target;
				if (t && t.id === "acx-custom" && e.key === "Enter") addCustom();
			});

			// 所有按钮 / 列表项统一走事件代理（选择器都是本组件自己的，不会误伤站点其它按钮）
			root.addEventListener(
				"click",
				function (e) {
					var t = e.target;
					if (!t || !t.closest) return;
					if (t.closest("#acx-toggle")) {
						e.preventDefault();
						setOn(!state.enabled);
						return;
					}
					if (t.closest("#acx-next")) {
						e.preventDefault();
						next();
						return;
					}
					if (t.closest("#acx-open")) {
						e.preventDefault();
						var panel = els().panel;
						if (panel) {
							if (panel.hidden) openPanel();
							else closePanel();
						}
						return;
					}
					if (t.closest("#acx-close")) {
						e.preventDefault();
						closePanel();
						return;
					}
					if (t.closest("#acx-addbtn")) {
						e.preventDefault();
						addCustom();
						return;
					}
					var del = t.closest(".acx-del");
					if (del) {
						e.preventDefault();
						e.stopPropagation();
						removeCustom(del.getAttribute("data-url"));
						return;
					}
					var item = t.closest(".acx-item");
					if (item) {
						e.preventDefault();
						pick(item.getAttribute("data-url"));
					}
				},
				true,
			);

			var search = els().search;
			if (search) {
				search.addEventListener("input", function () {
					renderList(search.value);
				});
			}
			var rot = els().rotate;
			if (rot) {
				rot.addEventListener("change", function () {
					state.rotate = Math.max(0, parseInt(rot.value, 10) || 0);
					lsSet(KEY_ROT, state.rotate);
				});
			}
			var sz = els().size;
			if (sz) {
				sz.addEventListener("change", function () {
					state.size = SIZES[sz.value] ? sz.value : "m";
					lsSet(KEY_SIZE, state.size);
					applySize();
				});
			}
			var idle = els().idle;
			if (idle) {
				idle.addEventListener("change", function () {
					state.idleOnly = !!idle.checked;
					lsSet(KEY_IDLE, state.idleOnly ? "1" : "0");
				});
			}

			// 窗口尺寸变了：拖尾画布跟着重设，别拉花
			var resizeTimer = null;
			window.addEventListener(
				"resize",
				function () {
					if (resizeTimer) clearTimeout(resizeTimer);
					resizeTimer = setTimeout(resizeTrail, 200);
				},
				{ passive: true },
			);
		}

		function boot() {
			if (!document.getElementById("acx-stage")) return;
			if (!state.booted) {
				state.booted = true;
				bind();
				// iframe 可能已经就绪（浏览器缓存命中时），补问一次状态
				postToFrame({ type: "ping" });
			}
			state.rotate = parseInt(lsGet(KEY_ROT, String(DEFAULT_ROTATE)), 10);
			if (isNaN(state.rotate)) state.rotate = DEFAULT_ROTATE;
			state.size = lsGet(KEY_SIZE, "m");
			if (!SIZES[state.size]) state.size = "m";
			state.idleOnly = lsGet(KEY_IDLE, "1") === "1";
			var e = els();
			if (e.rotate) e.rotate.value = String(state.rotate);
			if (e.size) e.size.value = state.size;
			if (e.idle) e.idle.checked = state.idleOnly;
			applySize();
			resizeTrail();
			// 触屏设备默认关掉（省流量），可以手动点「🎭 看板娘」打开
			setOn(lsGet(KEY_ON, coarse ? "0" : "1") === "1", true);
		}

		// 控制台 / 其它脚本都能直接调用
		window.AnimeCursorLive2D = {
			on: function () {
				setOn(true);
			},
			off: function () {
				setOn(false);
			},
			toggle: function () {
				setOn(!state.enabled);
			},
			next: next,
			pick: pick,
			say: function (text, hold) {
				say(text, hold);
			},
			burst: burst,
			isOn: function () {
				return state.enabled;
			},
			setModel: function (url) {
				return applyModel(url);
			},
			setSize: function (k) {
				state.size = SIZES[k] ? k : "m";
				lsSet(KEY_SIZE, state.size);
				var s = els().size;
				if (s) s.value = state.size;
				applySize();
			},
			setRotate: function (sec) {
				state.rotate = Math.max(0, parseInt(sec, 10) || 0);
				lsSet(KEY_ROT, state.rotate);
				var r = els().rotate;
				if (r) r.value = String(state.rotate);
			},
			pool: buildRotationPool,
			state: state,
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", boot);
		} else {
			boot();
		}
		document.addEventListener("swup:page:view", boot);
	})();
</script>
