---
/**
 * 动漫少女「Live2D 鼠标陪伴角色」（全站可用）
 * ------------------------------------------------------------------
 * 和右下角看板娘（Live2DWidget.astro）共用同一套运行库 / 同一批模型，
 * 区别是这只小可爱会**跟着鼠标跑**：
 *
 *   · 位置   角色中心 = 光标位置（系统箭头隐藏，指哪儿点哪儿不偏，贴边也不推开）
 *   · 小动作 待机自动换 Idle 动作（呼吸 / 眨眼 / 东张西望），点一下播 Tap 动作
 *   · 模型   随机轮换（默认 2 分钟，且只在你不动鼠标时才换）
 *   · 换装   「⚙ 模型库」可搜索 200+ 个在线模型，点一下即换；
 *            也能粘贴自己的 .model3.json 地址加入，选中结果存 localStorage
 *   · 台词   点一下会说话（气泡）+ 星光炸开 + 角色弹一下
 *   · 拖尾   移动时拖出樱花 / 星光（canvas 粒子，停下即停，不常驻耗电）
 *   · 降级   WebGL / 运行库不可用时只留一条 [acx] 警告，不挡网站正常使用
 *   · 触屏   默认关闭（省流量），可点左下「🎭 看板娘」手动打开
 *
 * 这一只**替掉**了 3.0.0 的手绘 Q 版 AnimeCursor.astro：跟随、台词气泡、
 * 点击星光、拖尾、Alt+C 快捷键全部搬到这里，全站只留一个跟随鼠标的角色。
 *
 * 渲染为什么放在 iframe：Cubism 4 的 CubismShader_WebGL 是模块级单例，着色器绑在
 * 第一个 WebGL 上下文上；同页第二个 PIXI 渲染器会画不出东西（控制台刷
 * "no valid shader program"）。放进 /acx/cursor-frame.html 后拥有独立 JS 作用域，
 * 和右下角看板娘互不干扰。
 *
 * 自己想改的常见位置（都在下面 <script> 里，改完 pnpm build 即可）：
 *   1) SIZES        角色三档大小（宽 / 高，CSS 像素）
 *   2) DEFAULT_ROTATE / ROTATE_MAX_MB / IDLE_MS  轮换节奏与轻量模型上限
 *   3) 默认模型池   搜 `buildRotationPool`，想固定用某几个模型就写死在数组里
 *   4) localStorage 键名：acx_on / acx_src / acx_rotate / acx_size / acx_idle / acx_custom
 *
 * 也可以在浏览器控制台里直接调：
 *   AnimeCursorLive2D.on() / .off() / .toggle() / .next()
 *   AnimeCursorLive2D.setModel("https://…/xxx.model3.json")
 *   AnimeCursorLive2D.setSize("s" | "m" | "l") / .setRotate(0|60|120|300)
 *   AnimeCursorLive2D.say("想说的一句话") / .burst()
 */
---

<div id="acx-dock" class="acx-dock">
	<button
		id="acx-toggle"
		class="acx-btn acx-btn--main"
		type="button"
		aria-pressed="false"
		title="Live2D 鼠标看板娘（跟随光标 · 随机换装）"
	>
		<span class="acx-ico" aria-hidden="true">🎭</span>
		<span class="acx-txt">看板娘</span>
	</button>
	<button id="acx-next" class="acx-btn" type="button" title="换一个模型" aria-label="换一个模型" hidden
		>🔄</button
	>
	<button id="acx-open" class="acx-btn" type="button" title="模型库 / 设置" aria-label="模型库 / 设置" hidden
		>⚙</button
	>
</div>

<canvas id="acx-trail" class="acx-trail" aria-hidden="true"></canvas>

<div id="acx-stage" class="acx-stage" aria-hidden="true">
	<iframe
		id="acx-frame"
		class="acx-frame"
		src="/acx/cursor-frame.html"
		title="Live2D 鼠标角色"
		scrolling="no"
		tabindex="-1"
		aria-hidden="true"></iframe>
	<div id="acx-bubble" class="acx-bubble" role="presentation"></div>
	<span id="acx-hint" class="acx-hint"></span>
</div>

<div id="acx-panel" class="acx-panel" role="dialog" aria-label="鼠标看板娘设置" hidden>
	<div class="acx-head">
		<strong>🎭 鼠标看板娘</strong>
		<button id="acx-close" class="acx-x" type="button" aria-label="关闭">✕</button>
	</div>

	<div class="acx-row">
		<label for="acx-rotate">自动轮换</label>
		<select id="acx-rotate">
			<option value="0">不换（只用当前）</option>
			<option value="60">每 1 分钟</option>
			<option value="120">每 2 分钟</option>
			<option value="300">每 5 分钟</option>
			<option value="600">每 10 分钟</option>
		</select>
	</div>

	<div class="acx-row">
		<label for="acx-size">角色大小</label>
		<select id="acx-size">
			<option value="s">小</option>
			<option value="m">中</option>
			<option value="l">大</option>
		</select>
	</div>

	<label class="acx-check"
		><input id="acx-idle" type="checkbox" checked /> 只在我停下鼠标时才换（推荐）</label
	>

	<input id="acx-search" class="acx-input" type="text" placeholder="搜索模型：名字 / 体积…" />

	<div id="acx-list" class="acx-list"></div>

	<div class="acx-add">
		<input id="acx-custom" class="acx-input" type="text" placeholder="粘贴 .model3.json 地址，添加自己的模型" />
		<button id="acx-addbtn" class="acx-btn acx-btn--mini" type="button">添加</button>
	</div>

	<p class="acx-note">
		标注「官方」的模型是 <b>Live2D Inc.</b> 公开示例素材，依
		<a
			href="https://www.live2d.com/eula/live2d-free-material-license-agreement_cn.html"
			target="_blank"
			rel="noopener noreferrer">Free Material License</a
		>
		仅通过浏览器加载展示；「本站」模型放在仓库
		<code>public/Firefly-live2d-main/model/</code> 下。选中的模型与设置都保存在浏览器 localStorage。
	</p>
</div>

<style is:global>
	/* 开启角色时的星光拖尾（只在移动时出现，停下就停） */
	.acx-trail {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 999998;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	html.acx-on .acx-trail {
		opacity: 1;
	}

	/* 点击时炸开的星光 */
	.acx-burst {
		position: fixed;
		left: 0;
		top: 0;
		width: 0;
		height: 0;
		z-index: 1000000;
		pointer-events: none;
	}
	.acx-burst span {
		position: absolute;
		left: 0;
		top: 0;
		font-size: 12px;
		line-height: 1;
		color: #ffd6ec;
		animation: acx-burst 0.62s ease-out forwards;
	}
	@keyframes acx-burst {
		0% {
			opacity: 0.95;
			transform: translate(-50%, -50%) scale(0.4) rotate(0deg);
		}
		100% {
			opacity: 0;
			transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1.15)
				rotate(var(--tr));
		}
	}

	/* ---------- 左下角按钮组 ---------- */
	.acx-dock {
		position: fixed;
		left: 16px;
		bottom: 154px;
		z-index: 999996;
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.acx-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-width: 34px;
		height: 28px;
		padding: 0 10px;
		border-radius: 999px;
		border: 1px solid rgba(255, 154, 200, 0.38);
		background: rgba(18, 16, 28, 0.55);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: #ffd9ea;
		font-size: 12px;
		line-height: 1;
		font-family: inherit;
		cursor: pointer;
		user-select: none;
		box-shadow: 0 6px 22px rgba(255, 143, 193, 0.18);
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			opacity 0.2s ease,
			color 0.2s ease;
	}
	.acx-btn:hover {
		transform: translateY(-2px);
		background: rgba(38, 28, 50, 0.75);
	}
	.acx-btn:focus-visible {
		outline: 2px solid rgba(255, 154, 200, 0.8);
		outline-offset: 2px;
	}
	.acx-btn[hidden] {
		display: none !important;
	}
	.acx-btn--main.is-off {
		opacity: 0.55;
		border-color: rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.65);
	}
	.acx-btn--main.is-on {
		border-color: rgba(255, 154, 200, 0.75);
		background: rgba(255, 154, 200, 0.16);
		color: #ffe6f2;
	}
	.acx-btn--mini {
		height: 26px;
		padding: 0 12px;
		font-size: 12px;
		flex: 0 0 auto;
	}
	.acx-ico {
		font-size: 13px;
	}

	/* ---------- 跟随鼠标的角色 ---------- */
	.acx-stage {
		position: fixed;
		left: 0;
		top: 0;
		width: var(--acx-w, 150px);
		height: var(--acx-h, 196px);
		z-index: 999999;
		pointer-events: none;
		opacity: 0;
		transform: translate3d(-300px, -300px, 0);
		transition: opacity 0.22s ease;
		will-change: transform;
	}
	.acx-stage.is-visible {
		opacity: 1;
	}
	.acx-stage.is-hidden,
	.acx-stage.is-typing {
		opacity: 0;
	}
	/* 角色就是「鼠标指针」：开启后系统箭头藏起来（只在本组件的按钮/面板上留着，方便点设置） */
	html.acx-on.acx-cursor-none,
	html.acx-on.acx-cursor-none body,
	html.acx-on.acx-cursor-none body * {
		cursor: none !important;
	}
	html.acx-on.acx-cursor-none #acx-dock,
	html.acx-on.acx-cursor-none #acx-dock *,
	html.acx-on.acx-cursor-none #acx-panel,
	html.acx-on.acx-cursor-none #acx-panel * {
		cursor: auto !important;
	}
	html.acx-on.acx-cursor-none #acx-dock button,
	html.acx-on.acx-cursor-none #acx-panel button,
	html.acx-on.acx-cursor-none #acx-panel select,
	html.acx-on.acx-cursor-none #acx-panel label,
	html.acx-on.acx-cursor-none #acx-panel .acx-item {
		cursor: pointer !important;
	}

	/* 点一下：角色「弹一下」，系统箭头藏起来了也能立刻看到反馈 */
	.acx-stage.is-pop .acx-frame {
		animation: acx-pop 0.36s ease-out;
	}
	@keyframes acx-pop {
		0% {
			transform: scale(1);
		}
		35% {
			transform: scale(0.94) translateY(3px);
		}
		70% {
			transform: scale(1.03) translateY(-2px);
		}
		100% {
			transform: scale(1);
		}
	}
	.acx-frame {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		background: transparent;
		pointer-events: none;
		color-scheme: light;
	}
	.acx-hint {
		position: absolute;
		left: 50%;
		bottom: 46%;
		transform: translateX(-50%);
		max-width: 190px;
		padding: 3px 8px;
		border-radius: 10px;
		background: rgba(28, 20, 40, 0.86);
		border: 1px solid rgba(255, 154, 200, 0.45);
		color: #ffe6f2;
		font-size: 11px;
		line-height: 1.45;
		white-space: nowrap;
		opacity: 0;
		transition: opacity 0.18s ease;
	}
	.acx-hint.is-show {
		opacity: 1;
	}
	/* 台词气泡：挂在角色头顶，贴边自动翻到另一侧 / 翻到下方 */
	.acx-bubble {
		position: absolute;
		left: 4px;
		bottom: calc(100% - 34px);
		max-width: 216px;
		padding: 6px 10px;
		border-radius: 12px 12px 12px 4px;
		border: 1px solid rgba(255, 154, 200, 0.55);
		background: rgba(28, 20, 40, 0.92);
		color: #ffe6f2;
		font-size: 12px;
		line-height: 1.5;
		white-space: nowrap;
		box-shadow: 0 8px 22px rgba(0, 0, 0, 0.42);
		opacity: 0;
		transform: translateY(6px) scale(0.9);
		transform-origin: 0 100%;
		transition:
			opacity 0.16s ease,
			transform 0.18s ease;
		z-index: 2;
	}
	.acx-bubble.is-open {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	.acx-bubble.is-flip {
		left: auto;
		right: 4px;
		border-radius: 12px 12px 4px 12px;
		transform-origin: 100% 100%;
	}
	.acx-bubble.is-below {
		bottom: auto;
		top: calc(100% - 34px);
	}
	@media (prefers-reduced-motion: reduce) {
		.acx-bubble {
			transition: none;
		}
	}
</style>

<style is:global>
	/* ---------- 模型库面板 ---------- */
	.acx-panel {
		position: fixed;
		left: 16px;
		bottom: 232px;
		width: 322px;
		max-width: calc(100vw - 32px);
		max-height: min(66vh, 560px);
		/* 面板本身不滚，内容超了裁掉，列表自己滚（短屏时见下面的 media 查询） */
		overflow: hidden;
		z-index: 1000002;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 12px 12px 10px;
		border-radius: 16px;
		border: 1px solid rgba(255, 154, 200, 0.4);
		background: rgba(20, 16, 30, 0.94);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		color: #ffe6f2;
		font-size: 12px;
		line-height: 1.5;
		font-family: inherit;
		box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
	}
	.acx-panel[hidden] {
		display: none !important;
	}
	.acx-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 13px;
	}
	.acx-head strong {
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.acx-x {
		width: 22px;
		height: 22px;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		color: #ffd9ea;
		font-size: 12px;
		font-family: inherit;
		cursor: pointer;
	}
	.acx-x:hover {
		background: rgba(255, 154, 200, 0.28);
	}
	.acx-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}
	.acx-row label {
		color: rgba(255, 255, 255, 0.72);
	}
	.acx-row select,
	.acx-input {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 8px;
		color: #ffeaf4;
		font-size: 12px;
		font-family: inherit;
		padding: 5px 8px;
		outline: none;
	}
	.acx-input {
		width: 100%;
	}
	.acx-input::placeholder {
		color: rgba(255, 255, 255, 0.34);
	}
	.acx-input:focus,
	.acx-row select:focus {
		border-color: rgba(255, 154, 200, 0.75);
	}
	.acx-check {
		display: flex;
		align-items: center;
		gap: 6px;
		color: rgba(255, 255, 255, 0.72);
		cursor: pointer;
	}
	.acx-list {
		flex: 1 1 auto;
		min-height: 96px;
		max-height: 300px;
		overflow-y: auto;
		padding: 2px;
		border-radius: 10px;
		background: rgba(0, 0, 0, 0.18);
	}
	.acx-list::-webkit-scrollbar {
		width: 6px;
	}
	.acx-list::-webkit-scrollbar-thumb {
		background: rgba(255, 154, 200, 0.4);
		border-radius: 3px;
	}
	.acx-item {
		display: flex;
		align-items: center;
		gap: 6px;
		width: 100%;
		padding: 6px 8px;
		border: none;
		border-radius: 8px;
		background: transparent;
		color: rgba(255, 255, 255, 0.82);
		font-size: 12px;
		font-family: inherit;
		text-align: left;
		cursor: pointer;
	}
	.acx-item:hover {
		background: rgba(255, 154, 200, 0.16);
	}
	.acx-item.is-active {
		background: rgba(255, 154, 200, 0.26);
		color: #fff;
	}
	.acx-item-name {
		flex: 1 1 auto;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.acx-item-meta {
		flex: 0 0 auto;
		font-size: 10.5px;
		color: rgba(255, 255, 255, 0.42);
	}
	.acx-del {
		flex: 0 0 auto;
		width: 18px;
		height: 18px;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.6);
		font-size: 10px;
		line-height: 1;
		cursor: pointer;
	}
	.acx-del:hover {
		background: rgba(255, 100, 140, 0.4);
		color: #fff;
	}
	.acx-sect {
		padding: 8px 8px 4px;
		font-size: 10.5px;
		letter-spacing: 0.06em;
		color: rgba(255, 255, 255, 0.36);
	}
	.acx-add {
		display: flex;
		gap: 6px;
	}
	.acx-note {
		margin: 0;
		font-size: 10.5px;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.4);
	}
	.acx-note a {
		color: #ffb3d9;
		text-decoration: none;
	}
	.acx-note code {
		padding: 0 3px;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.1);
	}

	@media (max-width: 640px) {
		.acx-dock {
			left: 10px;
			bottom: 146px;
		}
		.acx-txt {
			display: none;
		}
		.acx-panel {
			left: 10px;
			right: 10px;
			width: auto;
			bottom: 220px;
			max-height: 64vh;
		}
	}
	/* 矮屏（比如横屏手机 / 小窗）：面板改成从顶部挂下来，否则会被顶出视口 */
	@media (max-height: 620px) {
		.acx-panel {
			top: 12px;
			bottom: auto;
			max-height: calc(100vh - 24px);
		}
		.acx-list {
			min-height: 64px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.acx-stage {
			transition: none;
		}
		.acx-stage.is-pop .acx-frame {
			animation: none;
		}
	}
</style>

<script is:inline>
	(function () {
		if (window.__acxL2DInit) return;
		window.__acxL2DInit = true;

		/* ============ 想让角色「自己改」就看这几行 ============ */
		// 三档角色尺寸（CSS 像素），想更大/更小直接改数字
		var SIZES = {
			s: { w: 112, h: 146 },
			m: { w: 150, h: 196 },
			l: { w: 196, h: 252 },
		};
		// 自动轮换默认间隔（秒），0 = 不自动换
		var DEFAULT_ROTATE = 120;
		// 轮换只挑「轻量模型」，别每两分钟拉一个 15MB 的
		var ROTATE_MAX_MB = 6;
		// 鼠标停多久算「空闲」，空闲时才换，免得你正看着它突然变脸
		var IDLE_MS = 6000;
		// 等渲染 iframe 就绪的上限（毫秒）
		var FRAME_READY_TIMEOUT = 20000;
		/* ==================================================== */

		var KEY_ON = "acx_on";
		var KEY_SRC = "acx_src";
		var KEY_ROT = "acx_rotate";
		var KEY_SIZE = "acx_size";
		var KEY_IDLE = "acx_idle";
		var KEY_CUSTOM = "acx_custom";

		var reduceMotion = !!(
			window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches
		);
		var coarse =
			(window.matchMedia && window.matchMedia("(pointer: coarse)").matches) ||
			(window.matchMedia && !window.matchMedia("(hover: hover)").matches);

		function lsGet(k, def) {
			try {
				var v = localStorage.getItem(k);
				return v === null ? def : v;
			} catch (e) {
				return def;
			}
		}
		function lsSet(k, v) {
			try {
				localStorage.setItem(k, String(v));
			} catch (e) {}
