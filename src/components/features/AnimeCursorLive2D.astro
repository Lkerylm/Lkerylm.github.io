			e.bubble.textContent = text;
			// 贴着右 / 上边缘时把气泡翻到另一侧，别被视口裁掉
			e.bubble.classList.toggle("is-flip", state.drawX > window.innerWidth - 268);
			e.bubble.classList.toggle("is-below", state.drawY < 150);
