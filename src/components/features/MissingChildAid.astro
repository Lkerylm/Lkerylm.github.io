---
/**
 * 公益寻亲 · 浮动卡片（全站）
 *
 * 需求对应：
 * 1. 「可以手动关闭」     → 右上角 × ，关闭状态存 localStorage（rememberDays 天后自动恢复）；
 *                           关掉后左下角留一个 🧸 小胶囊，点一下就能重新打开；
 * 2. 「点击会跳转此链接」  → 点击卡片正文（文字区域）直接打开官方公益链接（新标签页）；
 * 3. 「实时更新」         → 运行时拉取 /data/aid/missing-children.json，默认每 5 分钟刷新一次，
 *                           切回标签页 / 网络恢复时也会立即补拉，并显示「x 分钟前同步」；
 * 4. 「不侵权」           → 只展示官方已公开的文字要点，不转载照片、海报、原文；
 *                           每条都带官方来源链接，底部明确「以官方发布为准」。
 *
 * 数据格式见 public/data/aid/missing-children.json，配置见 src/config/aidConfig.ts。
 */
import AidArt from "@/components/common/AidArt.astro";
import { aidConfig } from "@/config";

const config = aidConfig;
---

{
  config.enable && (
    <div
      id="aid-root"
      class:list={["aid-root", `aid-root-${config.position}`]}
      data-data-url={config.dataUrl}
      data-portal={config.portalUrl}
      data-rotate={config.rotateSeconds}
      data-refresh={config.refreshMinutes}
      data-remember={config.rememberDays}
      aria-live="polite"
    >
      {config.sideRail && (
        <button
          id="aid-rail"
          class="aid-rail"
          type="button"
          aria-label="公益寻亲：点开查看"
          title="公益寻亲 · 点开看看"
        >
          <span class="aid-rail-emoji" aria-hidden="true">🧸</span>
          <span class="aid-rail-text">公益寻亲</span>
        </button>
      )}

      <aside id="aid-card" class="aid-card" aria-label={config.title}>
        {config.art && (
          <span class="aid-art aid-art-left" aria-hidden="true">
            <AidArt kind="girl" />
          </span>
        )}
        <div class="aid-inner">
          <div class="aid-top">
            <span class="aid-badge">🧸 {config.title}</span>
            <span id="aid-live" class="aid-live">
              同步中…
            </span>
            <label class="aid-switch" title="公益卡片开关：关掉后点左下角 🧸 还能打开">
              <input
                id="aid-switch"
                type="checkbox"
                role="switch"
                checked
                aria-label={`${config.title}卡片开关`}
              />
              <span class="aid-switch-track" aria-hidden="true">
                <span class="aid-switch-thumb" />
              </span>
            </label>
            {config.closeable && (
              <button
                id="aid-close"
                type="button"
                class="aid-close"
                aria-label={`关闭${config.title}卡片`}
                title="关闭（之后可在左下角 🧸 重新打开）"
              >
                ×
              </button>
            )}
          </div>

        <a
          id="aid-main"
          class="aid-main"
          href={config.portalUrl}
          target="_blank"
          rel="noopener noreferrer"
          title="点击前往官方公益平台"
        >
          <span id="aid-emoji" class="aid-emoji" aria-hidden="true">
            🧸
          </span>
          <span class="aid-body">
            <strong id="aid-title" class="aid-title">
              {config.subtitle}
            </strong>
            <span id="aid-text" class="aid-text">
              正在同步官方公益信息…
            </span>
          </span>
          <span class="aid-go" aria-hidden="true">
            →
          </span>
        </a>

        <div class="aid-foot">
          <a class="aid-more" href="/aid/">
            如何正确帮助
          </a>
          <span id="aid-src" class="aid-src">
            以官方发布为准
          </span>
        </div>
        </div>
        {config.art && (
          <span class="aid-art aid-art-right" aria-hidden="true">
            <AidArt kind="teddy" />
          </span>
        )}
      </aside>

      <button
        id="aid-pill"
        type="button"
        class="aid-pill is-hidden"
        aria-label={`打开${config.title}卡片`}
        title="公益寻亲"
      >
        🧸<span class="aid-pill-text">寻亲</span>
      </button>
    </div>
  )
}

<style>
  .aid-root {
    position: fixed;
    /* 必须盖在 Live2D 看板娘（z-index 999999）和左下角那排小胶囊（999996）之上，
       否则卡片只会露出一角、还点不到 */
    z-index: 1000003;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    pointer-events: none;
    right: 1.25rem;
    /* 左下角那排小胶囊（音效 / 壁纸 / 声音 / 看板娘 / BGM）最高约 230px，卡片叠在它们头顶 */
    bottom: 15.5rem;
    max-width: min(21rem, calc(100vw - 2rem));
  }

  .aid-root-bottom-left {
    right: auto;
    left: 1rem;
    align-items: flex-start;
  }

  .aid-card {
    pointer-events: auto;
    width: 21rem;
    max-width: 100%;
    border-radius: 1.15rem;
    padding: 0.7rem 0.8rem 0.6rem;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.94), rgba(255, 246, 251, 0.9)),
      radial-gradient(120% 90% at 0% 0%, rgba(255, 154, 200, 0.35), transparent 60%);
    border: 1px solid rgba(255, 154, 200, 0.45);
    box-shadow:
      0 12px 30px -12px rgba(255, 120, 180, 0.55),
      0 2px 10px -4px rgba(30, 20, 40, 0.18);
    backdrop-filter: blur(10px);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease,
      box-shadow 0.25s ease;
    animation: aid-in 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .aid-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 18px 36px -14px rgba(255, 120, 180, 0.62),
      0 3px 12px -4px rgba(30, 20, 40, 0.2);
  }

  .aid-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.45rem;
  }

  .aid-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: #b0316c;
    white-space: nowrap;
  }

  .aid-live {
    font-size: 0.62rem;
    color: #b78f9f;
    padding: 0.05rem 0.4rem;
    border-radius: 99px;
    background: rgba(255, 154, 200, 0.16);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }

  .aid-close {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.06);
    color: #8a6f7a;
    font-size: 0.85rem;
    line-height: 1;
    display: grid;
    place-items: center;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .aid-close:hover {
    background: rgba(255, 90, 150, 0.16);
    color: #c2306d;
    transform: rotate(90deg);
  }

  .aid-main {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    text-decoration: none;
    color: inherit;
    padding: 0.4rem 0.45rem;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 154, 200, 0.5);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .aid-main:hover {
    background: rgba(255, 244, 250, 0.95);
    border-color: rgba(255, 120, 180, 0.75);
  }

  .aid-main:focus-visible {
    outline: 2px solid #ff8dc0;
    outline-offset: 2px;
  }

  .aid-emoji {
    font-size: 1.5rem;
    line-height: 1.2;
    filter: drop-shadow(0 2px 4px rgba(255, 140, 190, 0.45));
    animation: aid-bob 3.2s ease-in-out infinite;
  }

  .aid-body {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
    flex: 1;
  }

  .aid-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: #7d2b52;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .aid-text {
    font-size: 0.7rem;
    line-height: 1.5;
    color: #7a6470;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .aid-go {
    align-self: center;
    font-size: 0.8rem;
    color: #e0709f;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .aid-main:hover .aid-go {
    transform: translateX(3px);
  }

  .aid-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-top: 0.4rem;
    padding: 0 0.15rem;
  }

  .aid-more {
    font-size: 0.65rem;
    color: #d1518f;
    text-decoration: none;
    border-bottom: 1px dashed rgba(209, 81, 143, 0.45);
  }

  .aid-more:hover {
    color: #b0316c;
  }

  .aid-src {
    font-size: 0.6rem;
    color: #a998a2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .aid-pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.6rem 0.4rem 0.5rem;
    border-radius: 99px;
    border: 1px solid rgba(255, 154, 200, 0.5);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 8px 20px -10px rgba(255, 120, 180, 0.7);
    cursor: pointer;
    font-size: 0.72rem;
    color: #b0316c;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .aid-pill:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 12px 24px -10px rgba(255, 120, 180, 0.85);
  }

  .aid-pill-text {
    font-weight: 700;
  }

  .is-hidden {
    display: none !important;
  }

  @keyframes aid-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes aid-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }
    50% {
      transform: translateY(-3px) rotate(3deg);
    }
  }

  @media (max-width: 768px) {
    .aid-root {
      right: 0.75rem;
      bottom: 14.5rem;
      max-width: calc(100vw - 1.5rem);
    }

    .aid-root-bottom-left {
      left: 0.75rem;
    }

    .aid-card {
      width: 17.5rem;
      padding: 0.6rem 0.65rem 0.55rem;
    }

    .aid-emoji {
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aid-card,
    .aid-emoji,
    .aid-pill {
      animation: none !important;
      transition: none !important;
    }
  }

  /* 深色模式 */
  :global(.dark) .aid-card {
    background:
      linear-gradient(150deg, rgba(38, 28, 36, 0.95), rgba(28, 20, 28, 0.92)),
      radial-gradient(120% 90% at 0% 0%, rgba(255, 154, 200, 0.22), transparent 60%);
    border-color: rgba(255, 154, 200, 0.3);
  }

  :global(.dark) .aid-badge,
  :global(.dark) .aid-title {
    color: #ffb8d8;
  }

  :global(.dark) .aid-text {
    color: #d3bcc7;
  }

  :global(.dark) .aid-live {
    color: #e0b6c7;
    background: rgba(255, 154, 200, 0.14);
  }

  :global(.dark) .aid-main {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 154, 200, 0.28);
  }

  :global(.dark) .aid-main:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  :global(.dark) .aid-close {
    background: rgba(255, 255, 255, 0.1);
    color: #e2c6d2;
  }

  :global(.dark) .aid-pill {
    background: rgba(40, 30, 38, 0.94);
    color: #ffb8d8;
  }

  :global(.dark) .aid-src {
    color: #a48f9b;
  }

  /* ============================================================
     两侧小插画 + 开关 + 左侧竖排书签（本次新增）
     ============================================================ */

  .aid-card {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    width: 24.6rem;
    padding: 0.7rem 0.55rem 0.6rem;
  }

  .aid-inner {
    flex: 1;
    min-width: 0;
    padding: 0 0.15rem;
  }

  .aid-art {
    flex: none;
    width: 2.85rem;
    align-self: center;
    pointer-events: none;
    animation: aid-art-float 5.6s ease-in-out infinite;
  }

  .aid-art-left {
    transform: rotate(-7deg);
    margin-right: -0.1rem;
  }

  .aid-art-right {
    transform: rotate(7deg);
    margin-left: -0.1rem;
    animation-delay: 1.1s;
  }

  @keyframes aid-art-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -4px;
    }
  }

  .aid-card.aid-repop {
    animation: aid-in 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---- 开 / 关 小开关 ---- */
  .aid-switch {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    padding: 0.1rem;
  }

  .aid-switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .aid-switch-track {
    display: block;
    width: 1.75rem;
    height: 0.95rem;
    border-radius: 99px;
    background: rgba(255, 154, 200, 0.3);
    border: 1px solid rgba(255, 154, 200, 0.5);
    position: relative;
    transition:
      background 0.22s ease,
      border-color 0.22s ease;
  }

  .aid-switch-thumb {
    position: absolute;
    top: 0.06rem;
    left: 0.07rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgba(160, 60, 110, 0.4);
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .aid-switch input:checked + .aid-switch-track {
    background: linear-gradient(120deg, #ff8dc0, #c084fc);
    border-color: rgba(255, 141, 192, 0.85);
  }

  .aid-switch input:checked + .aid-switch-track .aid-switch-thumb {
    transform: translateX(0.78rem);
  }

  .aid-switch input:focus-visible + .aid-switch-track {
    outline: 2px solid #ff8dc0;
    outline-offset: 2px;
  }

  /* ---- 左边缘竖排书签：宽屏才有，点一下打开卡片 ---- */
  .aid-rail {
    position: fixed;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    z-index: 1002;
    pointer-events: auto;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.6rem 0.32rem 0.7rem;
    border: 1px solid rgba(255, 154, 200, 0.5);
    border-left: none;
    border-radius: 0 0.9rem 0.9rem 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.95),
      rgba(255, 242, 249, 0.92)
    );
    box-shadow: 4px 6px 18px -10px rgba(255, 120, 180, 0.8);
    cursor: pointer;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .aid-rail:hover {
    transform: translateX(3px);
    box-shadow: 6px 8px 22px -10px rgba(255, 120, 180, 0.95);
  }

  .aid-rail-emoji {
    font-size: 0.95rem;
    line-height: 1;
    animation: aid-bob 3.2s ease-in-out infinite;
  }

  .aid-rail-text {
    font-size: 0.68rem;
    font-weight: 700;
    color: #b0316c;
    letter-spacing: 0.12em;
    writing-mode: vertical-rl;
    text-orientation: upright;
  }

  :global(.dark) .aid-rail {
    background: linear-gradient(
      180deg,
      rgba(40, 30, 38, 0.96),
      rgba(28, 20, 28, 0.94)
    );
    border-color: rgba(255, 154, 200, 0.3);
  }

  :global(.dark) .aid-rail-text {
    color: #ffb8d8;
  }

  @media (min-width: 1280px) {
    .aid-rail {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .aid-card {
      width: 18.5rem;
    }

    .aid-art {
      width: 2.15rem;
    }
  }

  @media (max-width: 420px) {
    .aid-art {
      display: none;
    }

    .aid-card {
      width: 17rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aid-art,
    .aid-rail-emoji {
      animation: none !important;
    }
  }
</style>

<script is:inline define:vars={{ portalUrl: config.portalUrl }}>
  (function () {
    var root = document.getElementById("aid-root");
    if (!root || root.dataset.aidInit === "1") return;
    root.dataset.aidInit = "1";

    var card = document.getElementById("aid-card");
    var pill = document.getElementById("aid-pill");
    var closeBtn = document.getElementById("aid-close");
    var switchEl = document.getElementById("aid-switch");
    var railEl = document.getElementById("aid-rail");
    var main = document.getElementById("aid-main");
    var emojiEl = document.getElementById("aid-emoji");
    var titleEl = document.getElementById("aid-title");
    var textEl = document.getElementById("aid-text");
    var liveEl = document.getElementById("aid-live");
    var srcEl = document.getElementById("aid-src");

    var dataUrl = root.dataset.dataUrl || "/data/aid/missing-children.json";
    var fallbackPortal = root.dataset.portal || portalUrl;
    var rotateMs = Math.max(3, Number(root.dataset.rotate) || 8) * 1000;
    var refreshMs = Math.max(1, Number(root.dataset.refresh) || 5) * 60000;
    var rememberDays = Math.max(1, Number(root.dataset.remember) || 7);
    var CLOSE_KEY = "aid_closed_until";
    var ENABLE_KEY = "aid_enabled";

    var state = {
      entries: [],
      tips: [],
      updatedAt: null,
      idx: 0,
      rotateTimer: null,
      rendered: false,
    };

    function str(v) {
      return typeof v === "string" ? v : "";
    }

    function fmtAgo(iso) {
      var t = Date.parse(iso || "");
      if (isNaN(t)) return "官方信息 · 以发布为准";
      var diff = Math.max(0, Date.now() - t);
      var m = Math.floor(diff / 60000);
      if (m < 1) return "刚刚同步";
      if (m < 60) return m + " 分钟前同步";
      var h = Math.floor(m / 60);
      if (h < 24) return h + " 小时前同步";
      return Math.floor(h / 24) + " 天前同步";
    }

    function entryLine(e) {
      var bits = [];
      if (str(e.gender)) bits.push(e.gender);
      if (e.birthYear) bits.push(e.birthYear + " 年生");
      if (str(e.missingDate)) bits.push(str(e.missingDate) + " 走失");
      if (str(e.missingPlace)) bits.push(str(e.missingPlace));
      return bits.join(" · ");
    }

    function render() {
      state.rendered = true;
      if (state.entries.length > 0) {
        var i = state.idx % state.entries.length;
        var e = state.entries[i];
        var line = entryLine(e);
        var feature = str(e.feature);
        var gender = str(e.gender);
        titleEl.textContent =
          (str(e.name) || "未公开姓名") +
          (gender === "女" ? " · 寻找她" : gender === "男" ? " · 寻找他" : "");
        textEl.textContent = [line, feature].filter(Boolean).join("。");
        emojiEl.textContent = gender === "女" ? "👧" : gender === "男" ? "👦" : "🧸";
        main.href = str(e.sourceUrl) || fallbackPortal;
        main.title = "点击查看官方详情（" + (str(e.source) || "官方平台") + "）";
        srcEl.textContent =
          "来源：" +
          (str(e.source) || "官方平台") +
          " · " +
          (i + 1) +
          "/" +
          state.entries.length;
      } else {
        var tips = state.tips.length
          ? state.tips
          : ["发现走失儿童请立即拨打 110，并记住孩子当天的衣着与特征。"];
        emojiEl.textContent = "🧸";
        titleEl.textContent = "公益提示";
        textEl.textContent = tips[state.idx % tips.length];
        main.href = fallbackPortal;
        main.title = "点击前往官方公益平台";
        srcEl.textContent = "点击卡片直达官方公益平台";
      }
      restartRotate();
    }

    function rotateCount() {
      if (state.entries.length > 0) return state.entries.length;
      return Math.max(1, state.tips.length);
    }

    function restartRotate() {
      if (state.rotateTimer) {
        clearInterval(state.rotateTimer);
        state.rotateTimer = null;
      }
      if (rotateCount() <= 1) return;
      state.rotateTimer = setInterval(function () {
        if (document.hidden) return;
        state.idx = (state.idx + 1) % rotateCount();
        render();
      }, rotateMs);
    }

    function setLive(text, title) {
      liveEl.textContent = text;
      if (title) liveEl.title = title;
    }

    function fetchData(silent) {
      var url = dataUrl + (dataUrl.indexOf("?") >= 0 ? "&" : "?") + "t=" + Date.now();
      fetch(url, { cache: "no-store" })
        .then(function (r) {
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        })
        .then(function (d) {
          var list = d && Array.isArray(d.entries) ? d.entries : [];
          state.entries = list.filter(function (e) {
            return e && (str(e.name) || str(e.sourceUrl));
          });
          state.tips =
            d && Array.isArray(d.tips)
              ? d.tips.filter(function (t) {
                  return typeof t === "string" && t.trim();
                })
              : [];
          state.updatedAt = d && d.updatedAt ? d.updatedAt : null;
          state.idx = 0;
          setLive(
            fmtAgo(state.updatedAt),
            state.updatedAt ? "数据更新时间：" + state.updatedAt : "数据更新时间未知",
          );
          render();
        })
        .catch(function () {
          if (!state.rendered) render();
          setLive("离线 · 点击直达官方平台", "网络异常，展示内置内容");
        });
    }

    function applyClosed(closed) {
      card.classList.toggle("is-hidden", closed);
      if (railEl) railEl.classList.toggle("is-hidden", closed);
      pill.classList.toggle("is-hidden", !closed);
    }

    /* ---- 开 / 关总开关（localStorage 记住，下次打开网站还是你选的状态） ---- */
    var enabled = true;
    var closedUntil = 0;
    try {
      var rawEnabled = localStorage.getItem(ENABLE_KEY);
      enabled = rawEnabled === null ? true : rawEnabled === "1";
      closedUntil = Number(localStorage.getItem(CLOSE_KEY) || 0);
    } catch (e) {
      enabled = true;
      closedUntil = 0;
    }

    function syncUI() {
      var closed = !enabled || closedUntil > Date.now();
      applyClosed(closed);
      if (switchEl) switchEl.checked = enabled;
      pill.setAttribute("aria-pressed", closed ? "false" : "true");
      pill.title = enabled
        ? "公益寻亲"
        : "公益寻亲已经关掉了，点一下重新打开";
    }

    function setEnabled(next, focus) {
      enabled = !!next;
      try {
        localStorage.setItem(ENABLE_KEY, enabled ? "1" : "0");
      } catch (e) {
        /* 隐私模式下忽略 */
      }
      if (enabled) {
        closedUntil = 0;
        try {
          localStorage.removeItem(CLOSE_KEY);
        } catch (e) {
          /* ignore */
        }
        card.classList.remove("aid-repop");
        void card.offsetWidth;
        card.classList.add("aid-repop");
      }
      syncUI();
      if (enabled && focus && closeBtn) closeBtn.focus();
    }

    if (switchEl) {
      switchEl.addEventListener("change", function () {
        setEnabled(switchEl.checked, false);
      });
    }

    if (railEl) {
      railEl.addEventListener("click", function () {
        setEnabled(true, true);
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        closedUntil = Date.now() + rememberDays * 86400000;
        try {
          localStorage.setItem(CLOSE_KEY, String(closedUntil));
        } catch (e) {
          /* 隐私模式下忽略 */
        }
        syncUI();
      });
    }

    pill.addEventListener("click", function () {
      setEnabled(true, true);
    });

    syncUI();

    fetchData(false);
    setInterval(function () {
      if (state.updatedAt) setLive(fmtAgo(state.updatedAt));
    }, 60000);
    setInterval(function () {
      if (!document.hidden) fetchData(true);
    }, refreshMs);
    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) fetchData(true);
    });
    window.addEventListener("online", function () {
      fetchData(true);
    });
  })();
</script>




