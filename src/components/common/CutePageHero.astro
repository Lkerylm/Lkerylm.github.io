---
/**
 * 可爱的页面头图（非首页通用）
 * - 粉彩渐变 + 漂浮小圆点 + 星光，纯 CSS，无图片、无版权问题
 * - 用法：<CutePageHero emoji="🌸" title="关于我" subtitle="..." chips={["二次元", "追番"]} />
 */
interface Props {
	emoji?: string;
	title: string;
	subtitle?: string;
	chips?: string[];
	tone?: "pink" | "mint" | "sky" | "peach";
}

const {
	emoji = "🌸",
	title,
	subtitle,
	chips = [],
	tone = "pink",
} = Astro.props;
---

<section class:list={["cute-hero", `cute-hero-${tone}`]}>
  <span class="cute-hero-blob cute-hero-blob-a" aria-hidden="true"></span>
  <span class="cute-hero-blob cute-hero-blob-b" aria-hidden="true"></span>
  <span class="cute-hero-spark cute-hero-spark-a" aria-hidden="true">✦</span>
  <span class="cute-hero-spark cute-hero-spark-b" aria-hidden="true">✧</span>
  <span class="cute-hero-spark cute-hero-spark-c" aria-hidden="true">✦</span>

  <div class="cute-hero-inner">
    <span class="cute-hero-emoji" aria-hidden="true">{emoji}</span>
    <div class="cute-hero-text">
      <h1 class="cute-hero-title">
        {title}<span class="cute-hero-tail" aria-hidden="true">〜</span>
      </h1>
      {subtitle && <p class="cute-hero-sub">{subtitle}</p>}
      {
        chips.length > 0 && (
          <div class="cute-hero-chips">
            {chips.map((chip) => (
              <span class="cute-chip">{chip}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .cute-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 1rem;
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius-large);
    border: 1px dashed rgba(255, 154, 200, 0.55);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.85), transparent 55%),
      linear-gradient(120deg, #ffe8f3 0%, #fff4fa 45%, #f3f0ff 100%);
    box-shadow: 0 14px 34px -22px rgba(255, 120, 180, 0.85);
  }

  .cute-hero-mint {
    border-color: rgba(126, 214, 199, 0.55);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.85), transparent 55%),
      linear-gradient(120deg, #e3fbf4 0%, #f2fffb 45%, #eef7ff 100%);
    box-shadow: 0 14px 34px -22px rgba(90, 200, 180, 0.8);
  }

  .cute-hero-sky {
    border-color: rgba(150, 190, 255, 0.55);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.85), transparent 55%),
      linear-gradient(120deg, #e8f1ff 0%, #f5f9ff 45%, #f3f0ff 100%);
    box-shadow: 0 14px 34px -22px rgba(120, 160, 255, 0.8);
  }

  .cute-hero-peach {
    border-color: rgba(255, 190, 150, 0.6);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.85), transparent 55%),
      linear-gradient(120deg, #fff0e6 0%, #fff8f2 45%, #ffeef6 100%);
    box-shadow: 0 14px 34px -22px rgba(255, 160, 120, 0.8);
  }

  .cute-hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cute-hero-emoji {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 1.1rem;
    font-size: 1.7rem;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 18px -12px rgba(255, 120, 180, 0.9);
    animation: cute-float 4s ease-in-out infinite;
  }

  .cute-hero-text {
    min-width: 0;
  }

  .cute-hero-title {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.25;
    color: #7d2b52;
    letter-spacing: 0.01em;
  }

  .cute-hero-sky .cute-hero-title {
    color: #2f4a86;
  }

  .cute-hero-mint .cute-hero-title {
    color: #1f6b5c;
  }

  .cute-hero-peach .cute-hero-title {
    color: #8c4323;
  }

  .cute-hero-tail {
    display: inline-block;
    margin-left: 0.15rem;
    color: rgba(209, 81, 143, 0.65);
    animation: cute-wiggle 3s ease-in-out infinite;
  }

  .cute-hero-sub {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #6f5a66;
  }

  :global(.dark) .cute-hero-sub {
    color: rgba(235, 220, 230, 0.8);
  }

  .cute-hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .cute-chip {
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.32rem 0.6rem;
    border-radius: 99px;
    color: #b0316c;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 154, 200, 0.45);
  }

  .cute-hero-sky .cute-chip {
    color: #35579a;
    border-color: rgba(150, 190, 255, 0.55);
  }

  .cute-hero-mint .cute-chip {
    color: #1f6b5c;
    border-color: rgba(126, 214, 199, 0.55);
  }

  .cute-hero-peach .cute-chip {
    color: #97502c;
    border-color: rgba(255, 190, 150, 0.6);
  }

  .cute-hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(6px);
    opacity: 0.55;
    pointer-events: none;
  }

  .cute-hero-blob-a {
    width: 8rem;
    height: 8rem;
    right: -2.5rem;
    top: -3.5rem;
    background: radial-gradient(circle at 30% 30%, #ffc7e0, rgba(255, 199, 224, 0));
    animation: cute-drift 9s ease-in-out infinite;
  }

  .cute-hero-blob-b {
    width: 6rem;
    height: 6rem;
    right: 4rem;
    bottom: -3rem;
    background: radial-gradient(circle at 30% 30%, #cdd8ff, rgba(205, 216, 255, 0));
    animation: cute-drift 11s ease-in-out infinite reverse;
  }

  .cute-hero-spark {
    position: absolute;
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.9rem;
    text-shadow: 0 1px 6px rgba(255, 140, 190, 0.6);
    animation: cute-twinkle 3.4s ease-in-out infinite;
    pointer-events: none;
  }

  .cute-hero-spark-a {
    left: 45%;
    top: 0.75rem;
  }

  .cute-hero-spark-b {
    left: 58%;
    top: 1.6rem;
    animation-delay: 1.1s;
  }

  .cute-hero-spark-c {
    left: 38%;
    bottom: 1rem;
    animation-delay: 2.2s;
  }

  @keyframes cute-float {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-5px) rotate(4deg);
    }
  }

  @keyframes cute-wiggle {
    0%,
    100% {
      transform: rotate(-6deg);
    }
    50% {
      transform: rotate(6deg);
    }
  }

  @keyframes cute-twinkle {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.85);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.1);
    }
  }

  @keyframes cute-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-8px, 8px, 0);
    }
  }

  @media (max-width: 640px) {
    .cute-hero {
      padding: 1.1rem 1.1rem;
    }

    .cute-hero-inner {
      gap: 0.75rem;
    }

    .cute-hero-emoji {
      width: 2.6rem;
      height: 2.6rem;
      font-size: 1.4rem;
      border-radius: 0.9rem;
    }

    .cute-hero-title {
      font-size: 1.3rem;
    }

    .cute-hero-sub {
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cute-hero-emoji,
    .cute-hero-tail,
    .cute-hero-blob,
    .cute-hero-spark {
      animation: none !important;
    }
  }
</style>
