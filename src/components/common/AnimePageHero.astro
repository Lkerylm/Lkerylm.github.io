---
/**
 * 动画感页面头图（AnimePageHero）
 * ------------------------------------------------------------
 * 像动画 OP 的标题卡：
 * - 可选循环视频 / 插画做背景（默认纯 CSS 糖果渐变，零请求）
 * - 花瓣、光斑、扫描线、角标、渐变标题
 * - 底部可放按钮 / 链接（默认插槽），点击自动带音效
 *
 * 用法：
 * <AnimePageHero kicker="EPISODE 01" emoji="🌸" title="关于我" subtitle="..." chips={["追番"]} tone="pink" video="/welcome.mp4" image="/anime-wallpaper/desktop-03.avif">
 *   <a class="anime-hero-btn" href="/archive/" data-sound="open">去看看 →</a>
 * </AnimePageHero>
 */
interface Props {
	title: string;
	subtitle?: string;
	/** 小标签，例如 EPISODE 01 / NEW / 2026 */
	kicker?: string;
	emoji?: string;
	chips?: string[];
	tone?: "pink" | "mint" | "sky" | "peach" | "grape" | "sun";
	/** 循环背景视频（静音自动播放） */
	video?: string;
	/** 背景插画 / 视频封面 */
	image?: string;
	align?: "left" | "center";
	/** 更矮的头图，适合工具型页面 */
	compact?: boolean;
}

const {
	title,
	subtitle,
	kicker,
	emoji = "🌸",
	chips = [],
	tone = "pink",
	video,
	image,
	align = "left",
	compact = false,
} = Astro.props;

const hasMedia = Boolean(video || image);
---

<section
  class:list={[
    "anime-hero",
    `anime-hero-${tone}`,
    { "has-media": hasMedia, "is-center": align === "center", "is-compact": compact },
  ]}
>
  {
    hasMedia && (
      <div class="anime-hero-media" aria-hidden="true">
        {video ? (
          <video
            class="anime-hero-video"
            autoplay
            muted
            loop
            playsinline
            preload="none"
            poster={image}
            tabindex="-1"
            disablepictureinpicture
          >
            <source src={video} type="video/mp4" />
          </video>
        ) : (
          <img class="anime-hero-img" src={image} alt="" loading="eager" decoding="async" />
        )}
        <span class="anime-hero-veil"></span>
        <span class="anime-hero-scan"></span>
      </div>
    )
  }

  <span class="anime-hero-orb anime-hero-orb-a" aria-hidden="true"></span>
  <span class="anime-hero-orb anime-hero-orb-b" aria-hidden="true"></span>
  <span class="anime-hero-orb anime-hero-orb-c" aria-hidden="true"></span>

  <div class="anime-hero-body">
    <span class="anime-hero-emblem" aria-hidden="true">{emoji}</span>

    <div class="anime-hero-copy">
      {
        kicker && (
          <p class="anime-hero-kicker">
            <span class="anime-hero-kicker-dot" aria-hidden="true" />
            {kicker}
          </p>
        )
      }
      <h1 class="anime-hero-title">
        {title}<span class="anime-hero-tilde" aria-hidden="true">〜</span>
      </h1>
      {subtitle && <p class="anime-hero-sub">{subtitle}</p>}

      {
        chips.length > 0 && (
          <ul class="anime-hero-chips">
            {chips.map((chip) => (
              <li class="anime-hero-chip">{chip}</li>
            ))}
          </ul>
        )
      }

      <div class="anime-hero-actions">
        <slot />
      </div>
    </div>
  </div>

  <div class="anime-hero-petals" aria-hidden="true">
    <span style="--x: 6%; --d: 0s; --t: 11s">🌸</span>
    <span style="--x: 22%; --d: 2.4s; --t: 13s">✿</span>
    <span style="--x: 47%; --d: 1.2s; --t: 12s">🌸</span>
    <span style="--x: 68%; --d: 3.6s; --t: 14s">✦</span>
    <span style="--x: 84%; --d: 0.8s; --t: 10s">🌸</span>
    <span style="--x: 94%; --d: 4.4s; --t: 15s">✧</span>
  </div>

  <span class="anime-hero-corner" aria-hidden="true">✦</span>
</section>

<style>
  .anime-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 13.5rem;
    margin-bottom: 1rem;
    padding: 1.6rem 1.7rem;
    border-radius: var(--radius-large, 1.35rem);
    border: 1px solid rgba(255, 255, 255, 0.65);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.9), transparent 55%),
      linear-gradient(120deg, #ffe8f3 0%, #fff5fb 46%, #f2efff 100%);
    box-shadow:
      0 18px 42px -28px rgba(255, 120, 180, 0.9),
      0 2px 0 rgba(255, 255, 255, 0.7) inset;
    animation: anime-hero-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .anime-hero.is-compact {
    min-height: 9.5rem;
    padding: 1.15rem 1.35rem;
  }

  /* ---- 色调 ---- */
  .anime-hero-mint {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.9), transparent 55%),
      linear-gradient(120deg, #e2fbf3 0%, #f2fffb 46%, #eef6ff 100%);
    box-shadow:
      0 18px 42px -28px rgba(90, 200, 180, 0.85),
      0 2px 0 rgba(255, 255, 255, 0.7) inset;
  }
  .anime-hero-sky {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.9), transparent 55%),
      linear-gradient(120deg, #e6f0ff 0%, #f4f9ff 46%, #f2efff 100%);
    box-shadow:
      0 18px 42px -28px rgba(110, 160, 255, 0.85),
      0 2px 0 rgba(255, 255, 255, 0.7) inset;
  }
  .anime-hero-peach {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.9), transparent 55%),
      linear-gradient(120deg, #fff0e5 0%, #fff8f2 46%, #ffeef6 100%);
    box-shadow:
      0 18px 42px -28px rgba(255, 160, 120, 0.85),
      0 2px 0 rgba(255, 255, 255, 0.7) inset;
  }
  .anime-hero-grape {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.9), transparent 55%),
      linear-gradient(120deg, #f1eaff 0%, #f9f5ff 46%, #ffeef8 100%);
    box-shadow:
      0 18px 42px -28px rgba(160, 120, 255, 0.85),
      0 2px 0 rgba(255, 255, 255, 0.7) inset;
  }
  .anime-hero-sun {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 255, 255, 0.9), transparent 55%),
      linear-gradient(120deg, #fff7dd 0%, #fffbef 46%, #ffeef4 100%);
    box-shadow:
      0 18px 42px -28px rgba(255, 200, 90, 0.9),
      0 2px 0 rgba(255, 255, 255, 0.7) inset;
  }

  :global(:root.dark) .anime-hero:not(.has-media) {
    border-color: rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 134, 200, 0.16), transparent 58%),
      linear-gradient(120deg, #241a2c 0%, #1d1729 48%, #1a1a2e 100%);
    box-shadow: 0 18px 42px -26px rgba(0, 0, 0, 0.8);
  }

  /* ---- 媒体层 ---- */
  .anime-hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
  }

  .anime-hero-video,
  .anime-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.04);
    filter: saturate(1.08) contrast(1.02);
    animation: anime-hero-ken 24s ease-in-out infinite alternate;
  }

  .anime-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(96deg, rgba(18, 10, 24, 0.9) 0%, rgba(24, 14, 32, 0.68) 46%, rgba(30, 18, 40, 0.28) 78%),
      radial-gradient(70% 90% at 88% 20%, rgba(255, 134, 200, 0.35), transparent 65%);
  }

  .anime-hero-scan {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    mix-blend-mode: overlay;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.5) 0 1px,
      transparent 1px 4px
    );
    pointer-events: none;
  }

  .anime-hero.has-media {
    border-color: rgba(255, 255, 255, 0.22);
    color: #fff;
  }
</style>

<style>
  /* ---- 光斑 ---- */
  .anime-hero-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(8px);
    opacity: 0.6;
    z-index: 0;
  }
  .anime-hero-orb-a {
    width: 10rem;
    height: 10rem;
    top: -4.5rem;
    right: -2rem;
    background: radial-gradient(circle at 30% 30%, #ffc7e0, rgba(255, 199, 224, 0));
    animation: anime-hero-drift 12s ease-in-out infinite;
  }
  .anime-hero-orb-b {
    width: 7rem;
    height: 7rem;
    right: 5.5rem;
    bottom: -3.2rem;
    background: radial-gradient(circle at 30% 30%, #cdd8ff, rgba(205, 216, 255, 0));
    animation: anime-hero-drift 15s ease-in-out infinite reverse;
  }
  .anime-hero-orb-c {
    width: 5.5rem;
    height: 5.5rem;
    left: 42%;
    top: -2.6rem;
    background: radial-gradient(circle at 30% 30%, #b9f7e6, rgba(185, 247, 230, 0));
    animation: anime-hero-drift 18s ease-in-out infinite;
  }

  /* ---- 内容 ---- */
  .anime-hero-body {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.05rem;
    width: 100%;
  }

  .anime-hero.is-center .anime-hero-body {
    flex-direction: column;
    text-align: center;
    gap: 0.75rem;
  }

  .anime-hero-emblem {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1.15rem;
    font-size: 1.85rem;
    line-height: 1;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 10px 22px -14px rgba(255, 120, 180, 0.95);
    animation: anime-hero-bob 4.5s ease-in-out infinite;
  }

  .anime-hero.has-media .anime-hero-emblem {
    background: rgba(24, 14, 32, 0.5);
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .anime-hero-copy {
    min-width: 0;
  }

  .anime-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    margin: 0 0 0.35rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #cf4d8b;
  }

  .anime-hero.has-media .anime-hero-kicker {
    color: #ffd0e6;
  }

  .anime-hero-kicker-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px rgba(255, 134, 200, 0.25);
    animation: anime-hero-pulse 2.2s ease-in-out infinite;
  }

  .anime-hero-title {
    margin: 0;
    font-size: clamp(1.45rem, 3.4vw, 2.05rem);
    font-weight: 900;
    line-height: 1.22;
    letter-spacing: 0.01em;
    background-image: linear-gradient(118deg, #ff5fa6 0%, #ff8fc4 38%, #b184ff 78%, #7fc5ff 100%);
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: anime-hero-shine 8s linear infinite;
  }

  .anime-hero.has-media .anime-hero-title {
    background-image: none;
    color: #fff;
    -webkit-text-fill-color: #fff;
    text-shadow:
      0 3px 18px rgba(255, 120, 180, 0.55),
      0 1px 2px rgba(0, 0, 0, 0.4);
    animation: none;
  }

  .anime-hero-tilde {
    display: inline-block;
    margin-left: 0.12em;
    transform-origin: 70% 80%;
    animation: anime-hero-wiggle 3.6s ease-in-out infinite;
  }

  .anime-hero-sub {
    margin: 0.45rem 0 0;
    max-width: 46rem;
    font-size: 0.9rem;
    line-height: 1.8;
    color: #7c5c6d;
  }

  .anime-hero.has-media .anime-hero-sub {
    color: rgba(255, 238, 246, 0.86);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }

  :global(:root.dark) .anime-hero:not(.has-media) .anime-hero-sub {
    color: rgba(236, 220, 232, 0.82);
  }

  /* ---- 胶囊 ---- */
  .anime-hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .anime-hero.is-center .anime-hero-chips {
    justify-content: center;
  }

  .anime-hero-chip {
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.36rem 0.66rem;
    border-radius: 999px;
    color: #b0316c;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(255, 154, 200, 0.45);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .anime-hero-chip:hover {
    transform: translateY(-2px) rotate(-2deg);
    box-shadow: 0 6px 14px -8px rgba(255, 120, 180, 0.9);
  }

  .anime-hero.has-media .anime-hero-chip {
    color: #ffe3f0;
    background: rgba(28, 16, 36, 0.42);
    border-color: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .anime-hero-mint .anime-hero-chip {
    color: #1f6b5c;
    border-color: rgba(126, 214, 199, 0.55);
  }
  .anime-hero-sky .anime-hero-chip {
    color: #35579a;
    border-color: rgba(150, 190, 255, 0.55);
  }
  .anime-hero-peach .anime-hero-chip {
    color: #97502c;
    border-color: rgba(255, 190, 150, 0.6);
  }
  .anime-hero-grape .anime-hero-chip {
    color: #5c3d9e;
    border-color: rgba(184, 148, 255, 0.6);
  }
  .anime-hero-sun .anime-hero-chip {
    color: #8a6413;
    border-color: rgba(255, 217, 107, 0.65);
  }

  /* ---- 动作区 ---- */
  .anime-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .anime-hero-actions:empty {
    display: none;
  }

  .anime-hero.is-center .anime-hero-actions {
    justify-content: center;
  }

  /* ---- 花瓣 ---- */
  .anime-hero-petals {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .anime-hero-petals span {
    position: absolute;
    top: -1.6rem;
    left: var(--x, 50%);
    font-size: 0.8rem;
    line-height: 1;
    opacity: 0;
    animation: anime-hero-fall var(--t, 12s) linear var(--d, 0s) infinite;
  }

  .anime-hero-corner {
    position: absolute;
    right: 0.85rem;
    bottom: 0.7rem;
    z-index: 3;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 10px rgba(255, 120, 180, 0.9);
    animation: anime-hero-pulse 3.4s ease-in-out infinite;
  }

  .anime-hero:not(.has-media) .anime-hero-corner {
    color: rgba(255, 140, 190, 0.85);
  }

  /* ---- 动画 ---- */
  @keyframes anime-hero-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes anime-hero-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-5deg);
    }
    50% {
      transform: translateY(-5px) rotate(5deg);
    }
  }
  @keyframes anime-hero-wiggle {
    0%,
    100% {
      transform: rotate(-7deg);
    }
    50% {
      transform: rotate(7deg);
    }
  }
  @keyframes anime-hero-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-10px, 10px, 0);
    }
  }
  @keyframes anime-hero-shine {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 220% 50%;
    }
  }
  @keyframes anime-hero-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.92);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @keyframes anime-hero-fall {
    0% {
      opacity: 0;
      transform: translate3d(0, -10px, 0) rotate(0deg);
    }
    12% {
      opacity: 0.85;
    }
    88% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      transform: translate3d(-26px, 15rem, 0) rotate(220deg);
    }
  }
  @keyframes anime-hero-ken {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.12) translate3d(-1.2%, -1.2%, 0);
    }
  }

  /* ---- 响应式 ---- */
  @media (max-width: 768px) {
    .anime-hero {
      min-height: 11.5rem;
      padding: 1.25rem 1.2rem;
    }
    .anime-hero-emblem {
      width: 2.9rem;
      height: 2.9rem;
      font-size: 1.5rem;
      border-radius: 0.95rem;
    }
    .anime-hero-sub {
      font-size: 0.84rem;
    }
    .anime-hero-veil {
      background:
        linear-gradient(180deg, rgba(18, 10, 24, 0.62) 0%, rgba(20, 12, 28, 0.78) 60%, rgba(22, 13, 30, 0.9) 100%),
        radial-gradient(80% 70% at 80% 0%, rgba(255, 134, 200, 0.3), transparent 65%);
    }
  }

  @media (max-width: 480px) {
    .anime-hero {
      min-height: 0;
    }
    .anime-hero-body {
      gap: 0.75rem;
    }
    .anime-hero-title {
      font-size: 1.28rem;
    }
    .anime-hero-emblem {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anime-hero,
    .anime-hero-emblem,
    .anime-hero-title,
    .anime-hero-tilde,
    .anime-hero-orb,
    .anime-hero-corner,
    .anime-hero-petals span,
    .anime-hero-video,
    .anime-hero-img {
      animation: none !important;
    }
    .anime-hero-video {
      display: none;
    }
  }
</style>

<style is:global>
  /* 头图内的通用按钮，各页面可直接使用（带音效由 UiSounds 统一处理） */
  .anime-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.1;
    text-decoration: none;
    color: #b0316c;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(255, 154, 200, 0.55);
    box-shadow: 0 8px 20px -14px rgba(255, 120, 180, 1);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .anime-hero-btn:hover {
    transform: translateY(-2px);
    background: #fff;
    box-shadow: 0 12px 26px -14px rgba(255, 120, 180, 1);
  }

  .anime-hero-btn:active {
    transform: scale(0.95);
  }

  .anime-hero-btn.primary {
    color: #fff;
    background-image: linear-gradient(132deg, #ff7ab6, #b88cff 70%, #7fc5ff);
    border-color: rgba(255, 255, 255, 0.65);
    box-shadow: 0 12px 26px -14px rgba(255, 120, 180, 1);
  }

  .anime-hero.has-media .anime-hero-btn {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.9);
  }

  .anime-hero.has-media .anime-hero-btn:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .anime-hero.has-media .anime-hero-btn.primary {
    background-image: linear-gradient(132deg, rgba(255, 122, 182, 0.95), rgba(184, 140, 255, 0.95));
    border-color: rgba(255, 255, 255, 0.55);
  }
</style>
