---
import AnimeBackdrop from "@/components/features/AnimeBackdrop.astro";
import AnimeHeadMeta from "@/components/features/AnimeHeadMeta.astro";
import AuthLive2D from "@/components/features/AuthLive2D.astro";
import ServerConnect from "@/components/features/ServerConnect.astro";

export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>登录 · 我的动漫小屋</title>
	<AnimeHeadMeta />
	<script is:inline src="/firefly-api.js"></script>
	<style is:global>
		body.console-login *{
			box-sizing: border-box;
		}

		body.console-login{
			margin: 0;
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			background: radial-gradient(
				circle at 50% 38%,
				#2a2350 0%,
				#12111d 62%,
				#07060c 100%
			);
			font-family: "Noto Sans SC", system-ui, -apple-system, "PingFang SC",
				"Microsoft YaHei", sans-serif;
			color: #fff;
			padding: 20px;
			overflow: hidden;
			position: relative;
		}

		/* 卡片后方的一团柔光，让深色背景不那么闷 */
		body.console-login body::before{
			content: "";
			position: fixed;
			top: 38%;
			left: 50%;
			width: 86vmin;
			height: 86vmin;
			transform: translate(-50%, -50%);
			background: radial-gradient(
				circle,
				rgba(255, 154, 200, 0.26) 0%,
				rgba(150, 130, 255, 0.14) 42%,
				transparent 72%
			);
			border-radius: 50%;
			filter: blur(42px);
			pointer-events: none;
			z-index: 0;
		}

		/* 樱花：登录页的固定小浪漫 */
		body.console-login .petals{
			position: fixed;
			inset: 0;
			pointer-events: none;
			z-index: 2;
			overflow: hidden;
		}

		body.console-login .petal{
			position: absolute;
			top: -5%;
			width: 10px;
			height: 10px;
			background: radial-gradient(
				circle,
				#ffc0d9 0%,
				#ff7ab8 60%,
				transparent 70%
			);
			border-radius: 50% 0 50% 50%;
			opacity: 0.85;
			filter: blur(0.3px);
			animation: fall linear infinite;
		}

		@keyframes fall{
			0% {
				transform: translate3d(0, -5vh, 0) rotate(0deg);
				opacity: 0;
			}
			10% {
				opacity: 0.9;
			}
			100% {
				transform: translate3d(30px, 110vh, 0) rotate(360deg);
				opacity: 0;
			}
		}

		/* ===== 登录卡片 ===== */
		body.console-login .card{
			position: relative;
			z-index: 10;
			width: 100%;
			max-width: 408px;
			margin-left: auto;
			margin-right: 7vw;
			padding: 34px 32px 28px;
			border-radius: 26px;
			background: linear-gradient(
				160deg,
				rgba(46, 38, 64, 0.78) 0%,
				rgba(24, 21, 34, 0.86) 100%
			);
			border: 1px solid rgba(255, 175, 214, 0.28);
			backdrop-filter: blur(24px) saturate(1.2);
			-webkit-backdrop-filter: blur(24px) saturate(1.2);
			box-shadow:
				0 24px 70px rgba(0, 0, 0, 0.62),
				0 0 0 6px rgba(255, 154, 200, 0.05),
				0 0 60px rgba(255, 154, 200, 0.12);
			animation: cardIn 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		}

		/* 卡片顶部一条粉紫渐变光带，像贴了张和纸胶带 */
		body.console-login .card::before{
			content: "";
			position: absolute;
			top: -1px;
			left: 26px;
			right: 26px;
			height: 3px;
			border-radius: 0 0 6px 6px;
			background: linear-gradient(
				90deg,
				transparent,
				#ff9ac8 18%,
				#c4a4ff 52%,
				#9ad7ff 82%,
				transparent
			);
			opacity: 0.9;
		}

		@keyframes cardIn{
			from {
				opacity: 0;
				transform: translateY(22px) scale(0.96);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}
		/* ===== 标题 ===== */
		body.console-login .card-head{
			display: flex;
			align-items: center;
			gap: 13px;
			margin-bottom: 18px;
		}

		body.console-login .mascot{
			flex-shrink: 0;
			width: 54px;
			height: 54px;
			border-radius: 50%;
			display: grid;
			place-items: center;
			font-size: 26px;
			line-height: 1;
			background: linear-gradient(135deg, #ff9ac8, #a78bfa);
			box-shadow:
				0 10px 26px rgba(255, 154, 200, 0.36),
				inset 0 -3px 8px rgba(0, 0, 0, 0.16);
			animation: bob 4.2s ease-in-out infinite;
		}

		body.console-login .card-head h1{
			margin: 0;
			font-size: 21px;
			font-weight: 700;
			letter-spacing: 0.02em;
		}

		body.console-login .card-head .sub{
			margin-top: 3px;
			font-size: 11.5px;
			letter-spacing: 0.16em;
			color: rgba(255, 255, 255, 0.46);
		}

		@keyframes bob{
			0%,
			100% {
				transform: translateY(0) rotate(-3deg);
			}
			50% {
				transform: translateY(-4px) rotate(3deg);
			}
		}

		/* ===== 表单 ===== */
		body.console-login .field{
			position: relative;
			margin-bottom: 13px;
		}

		body.console-login .field .ico{
			position: absolute;
			left: 14px;
			top: 50%;
			transform: translateY(-50%);
			font-size: 14px;
			line-height: 1;
			opacity: 0.85;
			pointer-events: none;
		}

		body.console-login .field input{
			width: 100%;
			height: 48px;
			padding: 0 14px 0 40px;
			border-radius: 14px;
			border: 1px solid rgba(255, 255, 255, 0.12);
			background: rgba(255, 255, 255, 0.06);
			color: #fff;
			font-family: inherit;
			font-size: 14px;
			transition:
				border-color 0.2s ease,
				background 0.2s ease,
				box-shadow 0.2s ease;
		}

		body.console-login .field input::placeholder{
			color: rgba(255, 255, 255, 0.3);
		}

		body.console-login .field input:focus{
			outline: none;
			border-color: rgba(255, 154, 200, 0.8);
			background: rgba(255, 255, 255, 0.1);
			box-shadow: 0 0 0 3px rgba(255, 154, 200, 0.16);
		}

		body.console-login .field input:-webkit-autofill{
			-webkit-text-fill-color: #fff;
			-webkit-box-shadow: 0 0 0 60px rgba(40, 34, 56, 0.9) inset;
		}

		body.console-login button[type="submit"]{
			position: relative;
			overflow: hidden;
			width: 100%;
			height: 48px;
			margin-top: 8px;
			border: none;
			border-radius: 14px;
			cursor: pointer;
			font-family: inherit;
			font-size: 15px;
			font-weight: 700;
			letter-spacing: 0.28em;
			color: #351026;
			background: linear-gradient(120deg, #ffb3d4, #ff9ac8 45%, #c4a4ff);
			box-shadow: 0 12px 28px rgba(255, 154, 200, 0.36);
			transition:
				transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
				box-shadow 0.2s ease,
				opacity 0.2s ease;
		}

		body.console-login button[type="submit"]::after{
			content: "";
			position: absolute;
			top: 0;
			left: -60%;
			width: 45%;
			height: 100%;
			background: linear-gradient(
				100deg,
				transparent,
				rgba(255, 255, 255, 0.55),
				transparent
			);
			transform: skewX(-18deg);
			animation: shine 3.6s ease-in-out infinite;
		}

		@keyframes shine{
			0%,
			62% {
				left: -60%;
			}
			100% {
				left: 120%;
			}
		}

		body.console-login button[type="submit"]:hover{
			transform: translateY(-2px);
			box-shadow: 0 16px 34px rgba(255, 154, 200, 0.5);
		}

		body.console-login button[type="submit"]:active{
			transform: scale(0.98);
		}

		body.console-login button[type="submit"]:disabled{
			opacity: 0.65;
			cursor: default;
			transform: none;
		}
		/* ===== 提示 ===== */
		body.console-login .msg{
			display: none;
			margin-top: 14px;
			padding: 10px 13px;
			border-radius: 12px;
			font-size: 12.5px;
			line-height: 1.65;
		}

		body.console-login .msg.show{
			display: block;
			animation: msgIn 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		}

		body.console-login .msg.ok{
			background: rgba(100, 255, 150, 0.14);
			color: #a8ffc4;
			border: 1px solid rgba(100, 255, 150, 0.3);
		}

		body.console-login .msg.err{
			background: rgba(255, 110, 120, 0.14);
			color: #ffb0b8;
			border: 1px solid rgba(255, 110, 120, 0.3);
		}

		@keyframes msgIn{
			from {
				opacity: 0;
				transform: translateY(-4px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		/* ===== 底部链接 ===== */
		body.console-login .links{
			margin-top: 18px;
			text-align: center;
			font-size: 12.5px;
			color: rgba(255, 255, 255, 0.48);
		}

		body.console-login .links a{
			color: #ffa9d3;
			text-decoration: none;
			margin: 0 4px;
			border-bottom: 1px dashed rgba(255, 169, 211, 0.4);
			transition:
				color 0.2s ease,
				border-color 0.2s ease;
		}

		body.console-login .links a:hover{
			color: #fff;
			border-color: #fff;
		}

		body.console-login .links .divider{
			margin: 0 6px;
			color: rgba(255, 255, 255, 0.22);
		}

		/* ===== 服务器状态小胶囊 ===== */
		body.console-login .status{
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 6px;
			margin-top: 16px;
			padding: 7px 12px;
			border-radius: 999px;
			font-size: 11.5px;
			color: rgba(255, 255, 255, 0.5);
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.08);
		}

		body.console-login .status .dot{
			width: 7px;
			height: 7px;
			border-radius: 50%;
			background: #b9b4c9;
			transition: background 0.3s ease;
		}

		body.console-login .status[data-state="online"] .dot{
			background: #63e6a2;
			box-shadow: 0 0 0 0 rgba(99, 230, 162, 0.6);
			animation: pulse 2.4s ease-out infinite;
		}

		body.console-login .status[data-state="offline"] .dot{
			background: #ff9a9a;
		}

		@keyframes pulse{
			0% {
				box-shadow: 0 0 0 0 rgba(99, 230, 162, 0.55);
			}
			70% {
				box-shadow: 0 0 0 7px rgba(99, 230, 162, 0);
			}
			100% {
				box-shadow: 0 0 0 0 rgba(99, 230, 162, 0);
			}
		}

		@media (max-width: 900px){
			body.console-login .card{
				margin-left: auto;
				margin-right: auto;
				padding: 30px 24px 24px;
			}

			body.console-login body::before{
				opacity: 0.7;
			}
		}

		@media (max-width: 420px){
			body.console-login .card{
				border-radius: 22px;
			}

			body.console-login .card-head h1{
				font-size: 19px;
			}

			body.console-login .mascot{
				width: 46px;
				height: 46px;
				font-size: 22px;
			}
		}

		@media (prefers-reduced-motion: reduce){
			body.console-login .card, body.console-login .mascot, body.console-login button[type="submit"]::after, body.console-login .petal, body.console-login .status[data-state="online"] .dot{
				animation: none !important;
			}
		}
	</style>
</head>
<body class="console-login">
	<AnimeBackdrop live2d="none" petals={false} />
	<AuthLive2D />
	<div id="petals" class="petals" aria-hidden="true"></div>

	<main class="card">
		<header class="card-head">
			<div class="mascot" aria-hidden="true">🌸</div>
			<div>
				<h1>欢迎回来</h1>
				<div class="sub">おかえりなさい · WELCOME BACK</div>
			</div>
		</header>

		<form id="loginForm" novalidate>
			<div class="field">
				<span class="ico" aria-hidden="true">👤</span>
				<input
					id="username"
					name="username"
					type="text"
					required
					maxlength="20"
					placeholder="用户名"
					autocomplete="username"
				/>
			</div>
			<div class="field">
				<span class="ico" aria-hidden="true">🔒</span>
				<input
					id="password"
					name="password"
					type="password"
					required
					placeholder="密码"
					autocomplete="current-password"
				/>
			</div>
			<button type="submit" id="submitBtn">登 录</button>
		</form>

		<div class="msg" id="msg" role="status" aria-live="polite"></div>

		<nav class="links">
			还没有账号？<a href="/register/">去注册</a>
			<span class="divider">·</span>
			<a href="/">返回首页</a>
			<span class="divider">·</span>
			<a href="/gallery/">先逛逛</a>
		</nav>

		<div class="status" id="serverStatus" data-state="unknown">
			<span class="dot" aria-hidden="true"></span>
			<span id="serverStatusText">正在确认小服务器…</span>
		</div>
	</main>

	<ServerConnect />

	<script is:inline>
		(function () {
			var wrap = document.getElementById("petals");
			if (!wrap) return;
			for (var i = 0; i < 12; i++) {
				var p = document.createElement("span");
				p.className = "petal";
				p.style.left = Math.random() * 100 + "%";
				var size = 7 + Math.random() * 7;
				p.style.width = size + "px";
				p.style.height = size + "px";
				p.style.animationDuration = 7 + Math.random() * 7 + "s";
				p.style.animationDelay = -Math.random() * 9 + "s";
				wrap.appendChild(p);
			}
		})();

		/* 顶部小胶囊：告诉访客后端在不在（不在也能正常浏览） */
		(function () {
			var el = document.getElementById("serverStatus");
			var text = document.getElementById("serverStatusText");
			if (!el || !text) return;

			function paint(s) {
				if (!s) {
					el.dataset.state = "unknown";
					text.textContent = "正在确认小服务器…";
					return;
				}
				el.dataset.state = s.ok ? "online" : "offline";
				if (s.ok) {
					text.textContent = "小服务器在线 · " + (s.base || "同源");
				} else if (s.base) {
					text.textContent = "连不上 " + s.base + "（点右下角 ⚙ 改地址）";
				} else {
					text.textContent = "未配置账号服务器 · 只浏览内容也完全 OK";
				}
			}

			if (window.FireflyAPI && window.FireflyAPI.check) {
				paint(window.FireflyAPI.status);
				window.FireflyAPI.check()
					.then(paint)
					.catch(function () {
						paint({ ok: false, base: "" });
					});
			} else {
				paint(null);
			}

			window.addEventListener("firefly:backend", function (e) {
				paint(e.detail);
			});
		})();
	</script>

	<script is:inline>
		(function () {
			var form = document.getElementById("loginForm");
			var msg = document.getElementById("msg");
			var btn = document.getElementById("submitBtn");
			if (!form || !msg || !btn) return;

			var btnLabel = btn.textContent;

			function showMsg(text, type) {
				msg.textContent = text;
				msg.className = "msg show " + type;
			}

			function sound(name, vol) {
				try {
					if (window.AnimeSounds) window.AnimeSounds.play(name, vol);
				} catch (e) {
					/* 音效是锦上添花 */
				}
			}

			function playWelcomeVoice() {
				try {
					var audio = new Audio("/tts/Nanami/0.mp3");
					audio.volume = 0.7;
					var p = audio.play();
					if (p && p.catch) p.catch(function () {});
				} catch (e) {
					/* ignore */
				}
			}

			function unlock() {
				btn.disabled = false;
				btn.textContent = btnLabel;
			}

			form.addEventListener("submit", function (e) {
				e.preventDefault();
				msg.className = "msg";

				var username = (
					document.getElementById("username").value || ""
				).trim();
				var password = document.getElementById("password").value || "";

				if (!username || !password) {
					showMsg("用户名和密码都要填哦～", "err");
					sound("error", 0.4);
					return;
				}

				btn.disabled = true;
				btn.textContent = "登录中…";

				fetch("/api/auth/login/", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "include",
					body: JSON.stringify({ username: username, password: password }),
				})
					.then(function (res) {
						if (res.status === 404 || res.status === 405) {
							throw new Error(
								"还没有连上账号服务器：点右下角 ⚙ 服务器，填上 http://电脑IP:8787 再登录（只浏览内容不用登录）",
							);
						}
						return res.json();
					})
					.then(function (data) {
						if (data && data.ok) {
							showMsg(
								"欢迎回来，" +
									((data.user && data.user.username) || username) +
									"！",
								"ok",
							);
							sound("login", 0.45);
							playWelcomeVoice();
							setTimeout(function () {
								location.href =
									data.user && data.user.role === "admin"
										? "/admin/"
										: "/dashboard/";
							}, 900);
							return;
						}
						showMsg((data && data.error) || "登录失败了，再试一次？", "err");
						sound("error", 0.4);
						unlock();
					})
					.catch(function (err) {
						showMsg(
							(err && err.message) ||
								"网络错误：看下右下角 ⚙ 里的服务器地址，或稍后再试",
							"err",
						);
						sound("error", 0.4);
						unlock();
					});
			});
		})();
	</script>
</body>
</html>
