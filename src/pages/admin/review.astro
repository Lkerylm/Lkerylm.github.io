---
import AnimeBackdrop from "@/components/features/AnimeBackdrop.astro";
import AnimeHeadMeta from "@/components/features/AnimeHeadMeta.astro";
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>审核后台 - 我的动漫小屋</title>
  <AnimeHeadMeta />
  <script is:inline src="/firefly-api.js"></script>
  <style is:global>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh;
      background: linear-gradient(135deg, #1b1e33 0%, #0a0b12 100%);
      font-family: system-ui, -apple-system, "Noto Sans SC", sans-serif;
      color: #fff; padding: 40px 20px;
    }
    .container { max-width: 900px; margin: 0 auto; }
    h1 { margin: 0 0 8px; font-size: 26px; }
    .sub { color: rgba(255,255,255,0.55); font-size: 13px; margin-bottom: 28px; }
    .post-list { display: flex; flex-direction: column; gap: 16px; }
    .post-item {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 20px 24px;
    }
    .post-title { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
    .post-meta { font-size: 12px; color: rgba(255,255,255,0.5); margin-bottom: 12px; }
    .post-content {
      font-size: 14px; line-height: 1.7;
      color: rgba(255,255,255,0.85);
      background: rgba(0,0,0,0.25);
      padding: 14px 16px;
      border-radius: 8px;
      max-height: 200px;
      overflow-y: auto;
      white-space: pre-wrap;
      margin-bottom: 16px;
    }
    .post-actions { display: flex; gap: 10px; }
    button {
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }
    .btn-approve { background: linear-gradient(135deg, #64ff96, #22c55e); color: #fff; }
    .btn-reject  { background: rgba(255,80,80,0.15); color: #ffb0b0; border: 1px solid rgba(255,80,80,0.3); }
    button:hover { transform: translateY(-1px); }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    .empty { text-align: center; padding: 60px 20px; color: rgba(255,255,255,0.5); }
    .status-badge {
      display: inline-block; padding: 4px 10px;
      border-radius: 6px; font-size: 12px; margin-left: 8px;
    }
    .status-badge.pending  { background: rgba(255,200,80,0.15); color: #ffd060; }
    .status-badge.approved { background: rgba(100,255,150,0.15); color: #a8ffc4; }
    .status-badge.rejected { background: rgba(255,80,80,0.15); color: #ffb0b0; }
    .back { color: #ff9ac8; text-decoration: none; font-size: 14px; }
  </style>
</head>
<body>
  <AnimeBackdrop />
  <div class="container">
    <h1>审核后台</h1>
    <div class="sub">审核用户投稿 · <a href="/dashboard/" class="back">返回用户中心</a></div>

    <div id="list" class="empty">加载中…</div>
  </div>

  <script is:inline>
    async function loadMe() {
      const res = await fetch('/api/auth/me/', { credentials: 'include' });
      const data = await res.json();
      if (!data.ok || data.user.role !== 'admin') {
        location.href = '/login/';
        return null;
      }
      return data.user;
    }

    async function loadAllPosts() {
      const res = await fetch('/api/posts/list/', { credentials: 'include' });
      const data = await res.json();
      if (!data.ok) return [];
      return data.posts;
    }

    async function loadPostContent(id) {
      const res = await fetch('/api/posts/list/', { credentials: 'include' });
      const data = await res.json();
      return '';
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    async function review(postId, action, btn) {
      btn.disabled = true;
      const res = await fetch('/api/posts/review/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ postId, action }),
      });
      const data = await res.json();
      if (data.ok) {
        location.reload();
      } else {
        alert(data.error || '操作失败');
        btn.disabled = false;
      }
    }

    (async () => {
      const me = await loadMe();
      if (!me) return;

      const posts = await loadAllPosts();
      const list = document.getElementById('list');

      if (!posts || posts.length === 0) {
        list.textContent = '暂无投稿';
        return;
      }

      list.className = 'post-list';
      list.innerHTML = posts.map(p => {
        const date = new Date(p.created_at * 1000).toLocaleString('zh-CN');
        const statusText = p.status === 'approved' ? '已发布' : p.status === 'rejected' ? '已拒绝' : '待审核';
        const btns = p.status === 'pending'
          ? `<button class="btn-approve" data-id="${p.id}" data-action="approve">通过</button>
             <button class="btn-reject"  data-id="${p.id}" data-action="reject">拒绝</button>`
          : '';
        return `<div class="post-item">
          <div class="post-title">${escapeHtml(p.title)}<span class="status-badge ${p.status}">${statusText}</span></div>
          <div class="post-meta">ID: ${p.id} · ${date}</div>
          <div class="post-actions">${btns}</div>
        </div>`;
      }).join('');

      document.querySelectorAll('button[data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
          review(Number(btn.dataset.id), btn.dataset.action, btn);
        });
      });
    })();
  </script>
</body>
</html>