---
import AnimeBackdrop from "@/components/features/AnimeBackdrop.astro";
import AnimeHeadMeta from "@/components/features/AnimeHeadMeta.astro";
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>写文章 - 我的动漫小屋</title>
  <AnimeHeadMeta />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #1b1e33 0%, #0a0b12 100%);
      font-family: system-ui, -apple-system, "Noto Sans SC", sans-serif;
      color: #fff;
      padding: 40px 20px;
    }
    .container { max-width: 800px; margin: 0 auto; }
    h1 { margin: 0 0 8px; font-size: 26px; }
    .sub { color: rgba(255,255,255,0.55); font-size: 13px; margin-bottom: 28px; }
    label { display: block; font-size: 13px; margin-bottom: 6px; color: rgba(255,255,255,0.75); }
    input, textarea {
      width: 100%;
      padding: 12px 14px;
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 10px;
      color: #fff;
      font-size: 14px;
      margin-bottom: 20px;
      outline: none;
      font-family: inherit;
    }
    input:focus, textarea:focus { border-color: #ff9ac8; box-shadow: 0 0 0 3px rgba(255,154,200,0.15); }
    textarea { min-height: 320px; resize: vertical; line-height: 1.6; }
    .actions { display: flex; gap: 12px; }
    button, a {
      padding: 12px 22px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }
    .btn-primary { background: linear-gradient(135deg, #ff9ac8, #a78bfa); color: #fff; }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 10px 30px rgba(255,154,200,0.3); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-ghost { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); }
    .btn-ghost:hover { background: rgba(255,255,255,0.15); }
    .btn-ghost:disabled { opacity: 0.5; cursor: not-allowed; }
    .msg {
      margin-top: 16px;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      display: none;
    }
    .msg.err { display: block; background: rgba(255,80,80,0.15); color: #ffb0b0; border: 1px solid rgba(255,80,80,0.3); }
    .msg.ok  { display: block; background: rgba(100,255,150,0.15); color: #a8ffc4; border: 1px solid rgba(100,255,150,0.3); }
    .hint { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: -16px; margin-bottom: 20px; }

    /* 上传区 */
    .upload-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
      flex-wrap: wrap;
    }
    .upload-row button {
      padding: 8px 16px;
      font-size: 13px;
    }
    .upload-status {
      font-size: 12px;
      color: rgba(255,255,255,0.5);
    }
    .upload-status.ok { color: #a8ffc4; }
    .upload-status.err { color: #ffb0b0; }
  </style>
</head>
<body>
  <AnimeBackdrop />
  <div class="container">
    <h1>写文章</h1>
    <div class="sub">提交后需要管理员审核，审核通过后才会公开</div>

    <form id="postForm">
      <label>标题</label>
      <input type="text" id="title" required maxlength="100" placeholder="文章标题" />
            <label>封面图（可选）</label>
      <div class="upload-row">
        <button type="button" id="coverBtn" class="btn-ghost">🖼 上传封面</button>
        <input type="file" id="coverInput" accept="image/*" style="display: none;" />
        <span id="coverStatus" class="upload-status"></span>
      </div>
      <input type="hidden" id="cover" />
      <img id="coverPreview" style="display: none; max-width: 100%; border-radius: 10px; margin-bottom: 20px;" />


      <label>正文</label>
      <div class="upload-row">
        <button type="button" id="uploadBtn" class="btn-ghost">📷 上传图片</button>
        <input type="file" id="fileInput" accept="image/*" style="display: none;" />
        <span id="uploadStatus" class="upload-status"></span>
      </div>
      <textarea id="content" required placeholder="支持 Markdown 语法，图片会自动插入到光标处…"></textarea>
      <div class="hint">图片限制 5MB，支持 JPG / PNG / GIF / WebP</div>

      <div class="actions">
        <button type="submit" class="btn-primary" id="submitBtn">提交审核</button>
        <a href="/dashboard/" class="btn-ghost">返回</a>
      </div>
    </form>

    <div class="msg" id="msg"></div>
  </div>

  <script is:inline>
    const form = document.getElementById('postForm');
    const msg = document.getElementById('msg');
    const btn = document.getElementById('submitBtn');

    function showMsg(text, type) {
      msg.textContent = text;
      msg.className = 'msg ' + type;
    }

    // ===== 图片上传 =====
    const uploadBtn = document.getElementById('uploadBtn');
        // ===== 封面上传 =====
    const coverBtn = document.getElementById('coverBtn');
    const coverInput = document.getElementById('coverInput');
    const coverStatus = document.getElementById('coverStatus');
    const coverEl = document.getElementById('cover');
    const coverPreview = document.getElementById('coverPreview');

    coverBtn.addEventListener('click', () => coverInput.click());

    coverInput.addEventListener('change', async () => {
      const file = coverInput.files && coverInput.files[0];
      if (!file) return;
      coverStatus.textContent = '上传中…';
      coverStatus.className = 'upload-status';
      coverBtn.disabled = true;

      const fd = new FormData();
      fd.append('file', file);

      try {
        const res = await fetch('/api/upload/', { method: 'POST', credentials: 'include', body: fd });
        const data = await res.json();
        if (data.ok) {
          coverEl.value = data.url;
          coverPreview.src = data.url;
          coverPreview.style.display = 'block';
          coverStatus.textContent = '✅ 已上传';
          coverStatus.className = 'upload-status ok';
        } else {
          coverStatus.textContent = '❌ ' + (data.error || '失败');
          coverStatus.className = 'upload-status err';
        }
      } catch (e) {
        coverStatus.textContent = '❌ 网络错误';
        coverStatus.className = 'upload-status err';
      } finally {
        coverBtn.disabled = false;
        coverInput.value = '';
      }
    });
    const fileInput = document.getElementById('fileInput');
    const uploadStatus = document.getElementById('uploadStatus');
    const contentEl = document.getElementById('content');

    uploadBtn.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', async () => {
      const file = fileInput.files && fileInput.files[0];
      if (!file) return;

      uploadStatus.textContent = '上传中…';
      uploadStatus.className = 'upload-status';
      uploadBtn.disabled = true;

      const fd = new FormData();
      fd.append('file', file);

      try {
        const res = await fetch('/api/upload/', {
          method: 'POST',
          credentials: 'include',
          body: fd,
        });
        const data = await res.json();

        if (data.ok) {
          const md = `![${file.name}](${data.url})`;
          const start = contentEl.selectionStart ?? contentEl.value.length;
          const end = contentEl.selectionEnd ?? contentEl.value.length;
          const text = contentEl.value;
          contentEl.value = text.slice(0, start) + md + text.slice(end);
          contentEl.focus();
          contentEl.selectionStart = contentEl.selectionEnd = start + md.length;

          uploadStatus.textContent = '✅ 已插入';
          uploadStatus.className = 'upload-status ok';
          setTimeout(() => {
            uploadStatus.textContent = '';
            uploadStatus.className = 'upload-status';
          }, 2500);
        } else {
          uploadStatus.textContent = '❌ ' + (data.error || '上传失败');
          uploadStatus.className = 'upload-status err';
        }
      } catch (err) {
        uploadStatus.textContent = '❌ 网络错误';
        uploadStatus.className = 'upload-status err';
      } finally {
        uploadBtn.disabled = false;
        fileInput.value = '';
      }
    });

    // ===== 提交文章 =====
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = '提交中…';
      msg.className = 'msg';

      const title = document.getElementById('title').value.trim();
      const content = document.getElementById('content').value.trim();

      try {
        const res = await fetch('/api/posts/create/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ title, content, cover: coverEl.value }),
        });
        const data = await res.json();

        if (data.ok) {
          showMsg('提交成功！等待管理员审核', 'ok');
          setTimeout(() => { location.href = '/dashboard/'; }, 1200);
        } else {
          showMsg(data.error || '提交失败', 'err');
          btn.disabled = false;
          btn.textContent = '提交审核';
        }
      } catch (err) {
        showMsg('网络错误，请重试', 'err');
        btn.disabled = false;
        btn.textContent = '提交审核';
      }
    });
  </script>
</body>
</html>