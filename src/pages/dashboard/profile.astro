---
import AnimeBackdrop from "@/components/features/AnimeBackdrop.astro";
import AnimeHeadMeta from "@/components/features/AnimeHeadMeta.astro";
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>个人资料 - 我的动漫小屋</title>
  <AnimeHeadMeta />
  <script is:inline src="/firefly-api.js"></script>
  <style is:global>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh;
      background: linear-gradient(135deg, #1b1e33 0%, #0a0b12 100%);
      font-family: system-ui, -apple-system, "Noto Sans SC", sans-serif;
      color: #fff; padding: 40px 20px;
    }
    .container { max-width: 700px; margin: 0 auto; }
    h1 { margin: 0 0 8px; font-size: 26px; }
    .sub { color: rgba(255,255,255,0.55); font-size: 13px; margin-bottom: 28px; }
    .card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      padding: 28px 32px;
      margin-bottom: 24px;
    }
    .card h2 { margin: 0 0 20px; font-size: 17px; color: #ff9ac8; }
    .avatar-row { display: flex; align-items: center; gap: 20px; margin-bottom: 22px; }
    .avatar {
      width: 88px; height: 88px; border-radius: 50%;
      background: linear-gradient(135deg, #ff9ac8, #a78bfa);
      display: flex; align-items: center; justify-content: center;
      font-size: 36px; font-weight: 700;
      background-size: cover; background-position: center;
      flex-shrink: 0;
    }
    label { display: block; font-size: 13px; margin-bottom: 8px; color: rgba(255,255,255,0.75); font-weight: 500; }
    input, textarea {
      width: 100%; padding: 12px 15px;
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 10px;
      color: #fff; font-size: 14px;
      margin-bottom: 18px; outline: none;
      transition: all 0.2s; font-family: inherit;
    }
    input:focus, textarea:focus { border-color: #ff9ac8; box-shadow: 0 0 0 3px rgba(255,154,200,0.12); }
    input:disabled { opacity: 0.5; cursor: not-allowed; }
    textarea { min-height: 80px; resize: vertical; }
    button {
      padding: 11px 22px; border-radius: 10px;
      font-size: 14px; font-weight: 500;
      border: none; cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    .btn-primary { background: linear-gradient(135deg, #ff9ac8, #a78bfa); color: #fff; }
    .btn-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(255,154,200,0.3); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-ghost { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); }
    .btn-ghost:hover { background: rgba(255,255,255,0.15); }
    .msg { margin-top: 14px; padding: 10px 14px; border-radius: 8px; font-size: 13px; display: none; }
    .msg.err { display: block; background: rgba(255,80,80,0.15); color: #ffb0b0; border: 1px solid rgba(255,80,80,0.3); }
    .msg.ok  { display: block; background: rgba(100,255,150,0.15); color: #a8ffc4; border: 1px solid rgba(100,255,150,0.3); }
    .actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
    a.back { color: #ff9ac8; text-decoration: none; font-size: 13px; }
  </style>
</head>
<body>
  <AnimeBackdrop />
  <div class="container">
    <h1>个人资料</h1>
    <div class="sub">修改你的账号信息 · <a href="/dashboard/" class="back">← 返回用户中心</a></div>

    <!-- 头像 + 基本信息 -->
    <div class="card">
      <h2>基本信息</h2>
      <div class="avatar-row">
        <div class="avatar" id="avatarBox">?</div>
        <div>
          <button class="btn-ghost" id="uploadAvatarBtn" type="button">更换头像</button>
          <input type="file" id="avatarInput" accept="image/*" style="display: none;" />
          <div style="font-size: 12px; color: rgba(255,255,255,0.5); margin-top: 8px;">支持 JPG / PNG，小于 5MB</div>
        </div>
      </div>

      <label>用户名（不可改）</label>
      <input type="text" id="username" disabled />

      <label>邮箱</label>
      <input type="email" id="email" />

      <label>个人简介</label>
      <textarea id="bio" placeholder="介绍一下你自己…"></textarea>

      <div class="actions">
        <button class="btn-primary" id="saveInfoBtn">保存基本信息</button>
      </div>
      <div class="msg" id="infoMsg"></div>
    </div>

    <!-- 修改密码 -->
    <div class="card">
      <h2>修改密码</h2>
      <label>原密码</label>
      <input type="password" id="oldPassword" placeholder="输入当前密码" />
      <label>新密码</label>
      <input type="password" id="newPassword" placeholder="至少 6 位" />
      <div class="actions">
        <button class="btn-primary" id="savePassBtn">修改密码</button>
      </div>
      <div class="msg" id="passMsg"></div>
    </div>
  </div>

  <script is:inline>
    const avatarBox = document.getElementById('avatarBox');
    const uploadAvatarBtn = document.getElementById('uploadAvatarBtn');
    const avatarInput = document.getElementById('avatarInput');
    const infoMsg = document.getElementById('infoMsg');
    const passMsg = document.getElementById('passMsg');

    let currentAvatar = '';

    function showMsg(el, text, type) {
      el.textContent = text;
      el.className = 'msg ' + type;
      setTimeout(() => { if (el.className.includes(type)) el.className = 'msg'; }, 3000);
    }

    function renderAvatar() {
      if (currentAvatar) {
        avatarBox.style.backgroundImage = `url(${currentAvatar})`;
        avatarBox.textContent = '';
      }
    }

    async function loadMe() {
      const res = await fetch('/api/auth/me/', { credentials: 'include' });
      const data = await res.json();
      if (!data.ok) { location.href = '/login/'; return; }
      const u = data.user;
      document.getElementById('username').value = u.username;
      document.getElementById('email').value = u.email;
      document.getElementById('bio').value = u.bio || '';
      currentAvatar = u.avatar || '';
      if (currentAvatar) {
        renderAvatar();
      } else {
        avatarBox.textContent = u.username.charAt(0).toUpperCase();
      }
    }

    // 上传头像
    uploadAvatarBtn.addEventListener('click', () => avatarInput.click());
    avatarInput.addEventListener('change', async () => {
      const file = avatarInput.files && avatarInput.files[0];
      if (!file) return;
      uploadAvatarBtn.disabled = true;
      uploadAvatarBtn.textContent = '上传中…';

      const fd = new FormData();
      fd.append('file', file);

      try {
        const res = await fetch('/api/upload/', { method: 'POST', credentials: 'include', body: fd });
        const data = await res.json();
        if (data.ok) {
          currentAvatar = data.url;
          renderAvatar();
          // 保存到用户信息
          const res2 = await fetch('/api/user/update/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ avatar: data.url }),
          });
          const data2 = await res2.json();
          if (data2.ok) {
            showMsg(infoMsg, '头像已更新', 'ok');
          } else {
            showMsg(infoMsg, data2.error || '保存失败', 'err');
          }
        } else {
          showMsg(infoMsg, data.error || '上传失败', 'err');
        }
      } catch (err) {
        showMsg(infoMsg, '网络错误', 'err');
      } finally {
        uploadAvatarBtn.disabled = false;
        uploadAvatarBtn.textContent = '更换头像';
        avatarInput.value = '';
      }
    });

    // 保存基本信息
    document.getElementById('saveInfoBtn').addEventListener('click', async () => {
      const email = document.getElementById('email').value.trim();
      const bio = document.getElementById('bio').value.trim();
      const btn = document.getElementById('saveInfoBtn');
      btn.disabled = true;
      btn.textContent = '保存中…';

      try {
        const res = await fetch('/api/user/update/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email, bio }),
        });
        const data = await res.json();
        if (data.ok) {
          showMsg(infoMsg, '✅ 保存成功', 'ok');
        } else {
          showMsg(infoMsg, data.error || '保存失败', 'err');
        }
      } catch (err) {
        showMsg(infoMsg, '网络错误', 'err');
      } finally {
        btn.disabled = false;
        btn.textContent = '保存基本信息';
      }
    });

    // 修改密码
    document.getElementById('savePassBtn').addEventListener('click', async () => {
      const oldPassword = document.getElementById('oldPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const btn = document.getElementById('savePassBtn');

      if (!oldPassword || !newPassword) {
        showMsg(passMsg, '请填写完整', 'err'); return;
      }
      if (newPassword.length < 6) {
        showMsg(passMsg, '新密码至少 6 位', 'err'); return;
      }

      btn.disabled = true;
      btn.textContent = '修改中…';
      try {
        const res = await fetch('/api/user/password/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ oldPassword, newPassword }),
        });
        const data = await res.json();
        if (data.ok) {
          showMsg(passMsg, '✅ 密码已修改', 'ok');
          document.getElementById('oldPassword').value = '';
          document.getElementById('newPassword').value = '';
        } else {
          showMsg(passMsg, data.error || '修改失败', 'err');
        }
      } catch (err) {
        showMsg(passMsg, '网络错误', 'err');
      } finally {
        btn.disabled = false;
        btn.textContent = '修改密码';
      }
    });

    loadMe();
  </script>
</body>
</html>