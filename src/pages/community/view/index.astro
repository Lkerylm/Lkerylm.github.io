---
import AnimeBackdrop from "@/components/features/AnimeBackdrop.astro";
import AnimeHeadMeta from "@/components/features/AnimeHeadMeta.astro";
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>文章 - 我的动漫小屋</title>
  <AnimeHeadMeta />
  <script is:inline src="/firefly-api.js"></script>
  <style is:global>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh;
      background: linear-gradient(135deg, #1b1e33 0%, #0a0b12 100%);
      font-family: system-ui, -apple-system, "Noto Sans SC", sans-serif;
      color: #fff; padding: 40px 20px;
    }
    .container { max-width: 820px; margin: 0 auto; }
    .back { color: #ff9ac8; text-decoration: none; font-size: 13px; }
    h1 { font-size: 28px; margin: 14px 0 8px; line-height: 1.4; word-break: break-word; }
    .meta { color: rgba(255,255,255,0.5); font-size: 13px; margin-bottom: 22px; }
    .cover { width: 100%; border-radius: 14px; margin-bottom: 20px; display: none; }
    .content {
      white-space: pre-wrap; word-break: break-word;
      font-size: 15px; line-height: 1.9;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px; padding: 24px;
    }
    h2 { font-size: 18px; margin: 36px 0 14px; }
    .comment {
      display: flex; gap: 12px;
      padding: 14px 16px; margin-bottom: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 12px;
    }
    .avatar {
      width: 34px; height: 34px; border-radius: 50%; flex: none;
      background: linear-gradient(135deg, #ff9ac8, #7dd3fc);
      color: #1b1e33; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .cname { font-size: 13px; color: #ff9ac8; margin-bottom: 4px; }
    .ctext { font-size: 14px; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
    .ctime { font-size: 11px; color: rgba(255,255,255,0.35); margin-top: 6px; }
    textarea {
      width: 100%; min-height: 90px; resize: vertical;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 10px; padding: 12px;
      color: #fff; font-family: inherit; font-size: 14px;
      margin-bottom: 10px;
    }
    button {
      padding: 10px 22px; border-radius: 10px; border: none; cursor: pointer;
      background: linear-gradient(135deg, #ff9ac8, #c084fc); color: #fff;
      font-size: 14px; font-family: inherit;
    }
    button:disabled { opacity: .5; cursor: not-allowed; }
    .hint { color: rgba(255,255,255,0.5); font-size: 13px; }
    .hint a { color: #ff9ac8; }
    .empty { color: rgba(255,255,255,0.4); font-size: 14px; padding: 16px 0; }
    .toast {
      position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%) translateY(20px);
      background: rgba(20,22,36,0.96); border: 1px solid rgba(255,255,255,0.12);
      padding: 10px 18px; border-radius: 999px; font-size: 13px;
      opacity: 0; transition: all .25s; pointer-events: none;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>
  <AnimeBackdrop />
  <div class="container">
    <a class="back" href="/community/">← 返回社区</a>
    <h1 id="title">加载中…</h1>
    <div class="meta" id="meta"></div>
    <img class="cover" id="cover" alt="封面" />
    <div class="content" id="content">正在加载文章…</div>

    <h2>💬 评论 <span id="cCount" style="font-size:13px;color:rgba(255,255,255,.45)"></span></h2>
    <div id="comments"><div class="empty">加载中…</div></div>

    <div id="commentForm" style="display:none;margin-top:16px;">
      <textarea id="cInput" placeholder="友善发言～（Ctrl+Enter 发送）"></textarea>
      <button id="cSend">发表评论</button>
    </div>
    <div class="hint" id="loginHint" style="margin-top:14px;display:none;">
      <a href="/login/">登录</a> 后即可评论 · 没有账号？<a href="/register/">立即注册</a>
    </div>
  </div>
  <div class="toast" id="toast"></div>

  <script is:inline>
    (function () {
      var esc = function (s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      };
      var fmt = function (ts) {
        if (!ts) return "";
        return new Date(ts * 1000).toLocaleString("zh-CN", { hour12: false });
      };
      var toastTimer;
      function toast(msg, isErr) {
        var el = document.getElementById("toast");
        el.textContent = msg;
        el.style.borderColor = isErr ? "rgba(255,80,80,.5)" : "rgba(255,154,200,.5)";
        el.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { el.classList.remove("show"); }, 2200);
      }

      var slug = new URLSearchParams(location.search).get("slug");
      var post = null;
      var me = null;

      function renderPost() {
        document.title = post.title + " - 我的动漫小屋";
        document.getElementById("title").textContent = post.title;
        document.getElementById("meta").textContent = "作者 " + post.author + " · " + fmt(post.created_at);
        document.getElementById("content").textContent = post.content || "";
        if (post.cover) {
          var img = document.getElementById("cover");
          img.src = post.cover;
          img.style.display = "block";
        }
      }

      function renderComments(list) {
        var box = document.getElementById("comments");
        if (!list || list.length === 0) {
          box.innerHTML = '<div class="empty">还没有评论，来抢沙发～</div>';
          return;
        }
        box.innerHTML = list
          .map(function (c) {
            var av = c.avatar
              ? '<div class="avatar"><img src="' + esc(c.avatar) + '" alt=""></div>'
              : '<div class="avatar">' + esc((c.author || "?").slice(0, 1).toUpperCase()) + "</div>";
            return (
              '<div class="comment">' + av +
              '<div style="flex:1;min-width:0">' +
              '<div class="cname">' + esc(c.author) + "</div>" +
              '<div class="ctext">' + esc(c.content) + "</div>" +
              '<div class="ctime">' + fmt(c.created_at) + "</div>" +
              "</div></div>"
            );
          })
          .join("");
      }

      async function loadComments() {
        if (!post) return;
        var r = await fetch("/api/comments/list/?postId=" + post.id);
        var d = await r.json();
        if (d && d.ok) {
          renderComments(d.comments);
          document.getElementById("cCount").textContent = d.comments.length ? "(" + d.comments.length + ")" : "";
        }
      }

      async function loadPost() {
        var r = await fetch("/api/posts/public/");
        var d = await r.json();
        if (!d || !d.ok) throw new Error("加载失败");
        post = (d.posts || []).find(function (p) { return p.slug === slug; });
        if (!post) {
          document.getElementById("title").textContent = "文章不存在或未通过审核";
          document.getElementById("content").textContent = "这篇文章可能还在审核中，或者已经被删除。";
          document.getElementById("comments").style.display = "none";
          return false;
        }
        renderPost();
        await loadComments();
        return true;
      }

      async function loadMe() {
        try {
          var r = await fetch("/api/auth/me/");
          var d = await r.json();
          me = d && d.ok ? d.user : null;
        } catch (e) {
          me = null;
        }
        if (!post) return;
        document.getElementById("commentForm").style.display = me ? "block" : "none";
        document.getElementById("loginHint").style.display = me ? "none" : "block";
      }

      document.getElementById("cSend").addEventListener("click", async function () {
        var btn = this;
        var input = document.getElementById("cInput");
        var content = input.value.trim();
        if (!content) return toast("评论不能为空", true);
        btn.disabled = true;
        try {
          var r = await fetch("/api/comments/create/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ postId: post.id, content: content }),
          });
          var d = await r.json();
          if (d.ok) {
            input.value = "";
            toast("评论成功");
            await loadComments();
          } else {
            toast(d.error || "发送失败", true);
          }
        } catch (e) {
          toast("网络错误", true);
        } finally {
          btn.disabled = false;
        }
      });

      document.getElementById("cInput").addEventListener("keydown", function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") document.getElementById("cSend").click();
      });

      (async function () {
        if (!slug) {
          document.getElementById("title").textContent = "缺少文章参数";
          document.getElementById("content").textContent = "请从社区列表进入。";
          return;
        }
        try {
          var ok = await loadPost();
          if (!ok) return;
          await loadMe();
          setInterval(function () {
            if (!document.hidden) loadComments();
          }, 5000);
        } catch (e) {
          document.getElementById("title").textContent = "加载失败";
          document.getElementById("content").textContent =
            "无法连接后端（" + (e && e.message ? e.message : "网络错误") + "）。请确认电脑上的后端已启动。";
        }
      })();
    })();
  </script>

</body>
</html>
