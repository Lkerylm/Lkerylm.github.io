---
import type { GetStaticPaths } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import {
	localAnimeStatusText,
	pickFeaturedAnime,
} from "@/config/animeCollection";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const pageSize = siteConfig.pagination.postsPerPage;
	return paginate(allBlogPosts, { pageSize });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const len = page.data.length;

// 首页「本季追番」速览：来自 src/config/animeCollection.ts 的本地清单
const featuredAnime = pickFeaturedAnime(6);
const animeProgress = (ep: number, totalEp: number) =>
	totalEp > 0 ? Math.min(100, Math.round((ep / totalEp) * 100)) : 0;
---

<MainGridLayout>
  <!-- 🎬 首页横幅：单独的全宽区块，静态部署（无后端）时也能正常显示 -->
  {page.currentPage === 1 && (
  <div slot="full-width" class="hero-wrapper">
    <div class="hero-card">
      <div class="hero-mascot" aria-hidden="true">
        <span class="hero-mascot-glow"></span>
        <svg viewBox="0 0 120 148" focusable="false">
          <defs>
            <linearGradient id="hero-hair" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ffe3f0"></stop>
              <stop offset="50%" stop-color="#ffa9d3"></stop>
              <stop offset="100%" stop-color="#c3a4ff"></stop>
            </linearGradient>
            <linearGradient id="hero-dress" x1="0" y1="0" x2="0.4" y2="1">
              <stop offset="0%" stop-color="#ffffff"></stop>
              <stop offset="100%" stop-color="#ffe7f4"></stop>
            </linearGradient>
            <radialGradient id="hero-face" cx="50%" cy="36%" r="68%">
              <stop offset="0%" stop-color="#fffaf4"></stop>
              <stop offset="100%" stop-color="#ffe3d0"></stop>
            </radialGradient>
          </defs>
          <!-- 双马尾 -->
          <path d="M22 40c10 2 13 13 13 26s-5 26-13 30c-8-5-10-18-8-31 2-12 5-21 8-25z" fill="#f4a5ce"></path>
          <path d="M98 40c-10 2-13 13-13 26s5 26 13 30c8-5 10-18 8-31-2-12-5-21-8-25z" fill="#f4a5ce"></path>
          <!-- 腿与鞋 -->
          <rect x="47" y="112" width="10" height="24" rx="5" fill="#ffe7d8"></rect>
          <rect x="63" y="112" width="10" height="24" rx="5" fill="#ffe7d8"></rect>
          <ellipse cx="51.5" cy="139" rx="9" ry="5.6" fill="#ff86ba"></ellipse>
          <ellipse cx="68.5" cy="139" rx="9" ry="5.6" fill="#ff86ba"></ellipse>
          <!-- 后发 -->
          <ellipse cx="60" cy="52" rx="33" ry="34" fill="url(#hero-hair)"></ellipse>
          <!-- 裙子 -->
          <path d="M46 76h28l9 34c-10 6-15 7-23 7s-13-1-23-7z" fill="url(#hero-dress)" stroke="#ffb9d8" stroke-width="1.6" stroke-linejoin="round"></path>
          <!-- 水手领 -->
          <path d="M50 76l10 10 10-10 7 4-17 16-17-16z" fill="#a9d8ff"></path>
          <!-- 蝴蝶结 -->
          <path d="M59 94c-3.4-2.6-8-4.2-10-1.2-2 2.7 1 5.4 5.6 5.4-4.6 0-7.6 2.7-5.6 5.4 2 3 6.6 1.4 10-1.2z" fill="#ef5f97"></path>
          <path d="M61 94c3.4-2.6 8-4.2 10-1.2 2 2.7-1 5.4-5.6 5.4 4.6 0 7.6 2.7 5.6 5.4-2 3-6.6 1.4-10-1.2z" fill="#ef5f97"></path>
          <circle cx="60" cy="99.2" r="3.2" fill="#ff8fb9"></circle>
          <!-- 手臂 -->
          <path d="M46 80c-5 5-7 12-6.6 18" stroke="#ffe7d8" stroke-width="7.4" fill="none" stroke-linecap="round"></path>
          <circle cx="39" cy="101" r="4.4" fill="#ffe7d8"></circle>
          <path d="M74 80c5.6-2.6 9-8 10.4-13.6" stroke="#ffe7d8" stroke-width="7.4" fill="none" stroke-linecap="round"></path>
          <circle cx="86" cy="62" r="5.6" fill="#ffe7d8"></circle>
          <!-- 脸 -->
          <ellipse cx="60" cy="54" rx="24" ry="23" fill="url(#hero-face)"></ellipse>
          <!-- 刘海 -->
          <path d="M60 20c17 0 28 11 28 25 0 3-1 4.6-2.8 4.8-4.2-6-8.8-10-14.4-12-2.6 4.8-7.2 7.8-13 7.8-4.4 0-8.6-1.6-11.6-4.4-4.2 3.4-8.2 7.8-11.2 12-1.8-.2-2.8-2-2.8-4.8C32 31 43 20 60 20z" fill="url(#hero-hair)"></path>
          <!-- 呆毛 -->
          <path d="M61 20c.8-7 8.6-8 10.4-2.2" stroke="#ffc9e4" stroke-width="3.4" fill="none" stroke-linecap="round"></path>
          <!-- 眼睛 -->
          <ellipse cx="49.6" cy="55.4" rx="5.4" ry="6.8" fill="#3b2b50"></ellipse>
          <ellipse cx="70.4" cy="55.4" rx="5.4" ry="6.8" fill="#3b2b50"></ellipse>
          <circle cx="47.6" cy="52.6" r="2" fill="#ffffff"></circle>
          <circle cx="68.4" cy="52.6" r="2" fill="#ffffff"></circle>
          <circle cx="51.8" cy="58.4" r="1.1" fill="#ffc7e2"></circle>
          <circle cx="72.6" cy="58.4" r="1.1" fill="#ffc7e2"></circle>
          <!-- 腮红与嘴 -->
          <ellipse cx="40.6" cy="64.4" rx="6" ry="3.2" fill="#ff9ec4" opacity="0.55"></ellipse>
          <ellipse cx="79.4" cy="64.4" rx="6" ry="3.2" fill="#ff9ec4" opacity="0.55"></ellipse>
          <path d="M56.4 70.4q3.6 3.4 7.2 0" stroke="#b9566f" stroke-width="2.4" fill="none" stroke-linecap="round"></path>
          <!-- 发饰 -->
          <path d="M92 33c2.4-2 5.4-2 6.6 0 1.2 2-1 4.4-3.4 3.8 2.4-.6 4.6 1.8 3.4 3.8-1.2 2-4.2 2-6.6 0z" fill="#ff7fb8"></path>
          <circle cx="94.4" cy="36.8" r="1.8" fill="#ff4f97"></circle>
        </svg>
        <span class="hero-mascot-heart">♡</span>
      </div>

      <div class="anime-hero">
        <div class="ah-jp">ようこそ · アニメの世界へ</div>
        <div class="ah-title">欢迎来到 <span>我的动漫小屋</span></div>
        <div class="ah-desc">追番 · 杂谈 · 同人 · 日常，把每一次心动都收藏起来</div>
        <div class="ah-chips">
          <a href="/archive/">📺 全部文章</a>
          <a href="/bangumi/">🌸 追番记录</a>
          <a href="/gallery/">🖼 相册</a>
          <a href="/community/">🌏 社区</a>
          <a href="/app/">📱 App</a>
        </div>
      </div>
    </div>
  </div>
  )}

  <!-- 🌸 本季追番速览：本地清单驱动，静态部署（无后端）也能显示 -->
  {page.currentPage === 1 && (
  <section slot="full-width" class="home-anime">
    <div class="home-anime-inner">
      <div class="home-anime-head">
        <h2>
          🌸 本季追番
          <a href="/bangumi/">全部 →</a>
        </h2>
      </div>

      <div class="home-anime-grid">
        {featuredAnime.map((anime) => (
          <a
            class="ha-card"
            href="/bangumi/"
            style={`--ha-a:${anime.gradient[0]};--ha-b:${anime.gradient[1]};`}
            title={`${anime.nameCn} · ${localAnimeStatusText[anime.status]}`}
          >
            <span class="ha-emoji" aria-hidden="true">{anime.emoji}</span>
            <span class="ha-name">{anime.nameCn}</span>
            <span class="ha-meta">
              {anime.year} · {localAnimeStatusText[anime.status]}
              {anime.score > 0 && ` · ⭐ ${anime.score.toFixed(1)}`}
            </span>
            <span class="ha-bar" aria-hidden="true">
              <i style={`width:${animeProgress(anime.ep, anime.totalEp)}%`}></i>
            </span>
          </a>
        ))}
      </div>

      <!-- 🧸 公益寻亲：独立页面入口（不再用全站浮动卡片挡住内容） -->
      <a class="home-aid" href="/aid/">
        <span class="home-aid-emoji" aria-hidden="true">🧸</span>
        <span class="home-aid-text">
          <strong>公益寻亲</strong>
          <small>多看一眼，也许就多一次团圆 · 官方信息公开汇总，随时可查</small>
        </span>
        <span class="home-aid-go">去看看 →</span>
      </a>
    </div>
  </section>
  )}

  <!-- 文章列表留在主内容区，不受影响 -->
  <PostPage page={page} />
  {
    page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</MainGridLayout>

<style is:global>
  /* ===== 🎬 首页横幅（静态部署也可见） ===== */
  .hero-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    margin: 4px 0 20px;
    box-sizing: border-box;
    z-index: 40;
  }

  /* 与主内容网格 (#main-grid) 同步下移，避免横幅压在 banner 上 */
  body.enable-banner .hero-wrapper {
    transform: translateY(var(--banner-height-extend, 0px));
  }

  /* ===== 🌸 首页追番速览 + 公益寻亲入口 ===== */
  .home-anime {
    position: relative;
    width: 100%;
    padding: 0 16px;
    margin: 0 0 20px;
    box-sizing: border-box;
    z-index: 39;
  }

  /* 和 hero / #main-grid 一起跟随 banner 下移 */
  body.enable-banner .home-anime {
    transform: translateY(var(--banner-height-extend, 0px));
  }

  .home-anime-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .home-anime-head {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    margin: 0 4px 10px;
  }

  .home-anime-head h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.02rem;
    font-weight: 700;
    color: rgba(78, 52, 92, 0.9);
    letter-spacing: 0.02em;
  }

  html.dark .home-anime-head h2 {
    color: rgba(255, 255, 255, 0.85);
  }

  .home-anime-head a {
    font-size: 0.76rem;
    color: #e0568f;
    text-decoration: none;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 176, 208, 0.6);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .home-anime-head a:hover {
    transform: translateX(2px);
    background: rgba(255, 255, 255, 0.95);
  }

  html.dark .home-anime-head a {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 176, 208, 0.35);
    color: #ffb3d4;
  }

  .home-anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  @media (min-width: 640px) {
    .home-anime-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .home-anime-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .ha-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 12px 13px;
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: rgba(64, 40, 74, 0.92);
    background:
      radial-gradient(120% 90% at 15% 0%, rgba(255, 255, 255, 0.85), transparent 60%),
      linear-gradient(150deg, var(--ha-a, #ffd9ea), var(--ha-b, #c9b8ff));
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 10px 22px rgba(190, 150, 220, 0.16);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ha-card::after {
    content: "";
    position: absolute;
    right: -26px;
    top: -32px;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  .ha-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px rgba(190, 150, 220, 0.28);
  }

  html.dark .ha-card {
    color: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.3);
  }

  html.dark .ha-card::after {
    background: rgba(255, 255, 255, 0.16);
  }

  .ha-emoji {
    position: relative;
    z-index: 1;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .ha-name {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ha-meta {
    position: relative;
    z-index: 1;
    font-size: 0.66rem;
    opacity: 0.78;
  }

  .ha-bar {
    position: relative;
    z-index: 1;
    display: block;
    height: 5px;
    margin-top: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
    overflow: hidden;
  }

  .ha-bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #ff8dc0, #a78bfa);
  }

  html.dark .ha-bar {
    background: rgba(255, 255, 255, 0.2);
  }

  /* 🧸 公益寻亲入口条 */
  .home-aid {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding: 11px 16px;
    border-radius: 20px;
    text-decoration: none;
    background: linear-gradient(
      120deg,
      rgba(255, 240, 247, 0.96),
      rgba(242, 245, 255, 0.96)
    );
    border: 1px dashed rgba(255, 168, 205, 0.75);
    box-shadow: 0 8px 20px rgba(255, 150, 190, 0.12);
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  .home-aid:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 26px rgba(255, 150, 190, 0.22);
  }

  html.dark .home-aid {
    background: linear-gradient(
      120deg,
      rgba(52, 36, 50, 0.95),
      rgba(40, 42, 60, 0.95)
    );
    border-color: rgba(255, 168, 205, 0.35);
  }

  .home-aid-emoji {
    font-size: 1.45rem;
    line-height: 1;
  }

  .home-aid-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 0 1 auto;
    min-width: 0;
  }

  .home-aid-text strong {
    font-size: 0.9rem;
    color: #d4387c;
  }

  html.dark .home-aid-text strong {
    color: #ffa6cf;
  }

  .home-aid-text small {
    font-size: 0.72rem;
    color: rgba(90, 74, 96, 0.78);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  html.dark .home-aid-text small {
    color: rgba(255, 255, 255, 0.66);
  }

  .home-aid-go {
    flex: 0 0 auto;
    font-size: 0.75rem;
    color: #e0568f;
    white-space: nowrap;
  }

  html.dark .home-aid-go {
    color: #ffb3d4;
  }

  @media (max-width: 639px) {
    .home-aid-text small {
      white-space: normal;
    }
  }

  .hero-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 1200px;
    padding: 18px 26px 16px 20px;
    border-radius: 28px;
    overflow: hidden;
    box-sizing: border-box;
    /* 奶白奶糖卡片：粉 → 白 → 香芋紫 */
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(255, 214, 236, 0.95), transparent 58%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.97), rgba(255, 245, 251, 0.95) 52%, rgba(243, 238, 255, 0.95));
    border: 2px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 22px 54px rgba(255, 124, 184, 0.22),
      0 8px 22px rgba(194, 166, 255, 0.2),
      inset 0 0 0 1px rgba(255, 190, 219, 0.55);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }

  /* 顶部丝带彩条 */
  .hero-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 5px;
    background-image: linear-gradient(90deg, #ff9ecb, #ffd59e 28%, #a9f0dc 55%, #a5dcff 78%, #c2a6ff);
    opacity: 0.95;
    pointer-events: none;
  }

  /* 右下角香芋光晕 */
  .hero-card::after {
    content: "";
    position: absolute;
    right: -40px;
    bottom: -70px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(194, 166, 255, 0.42), transparent 70%);
    filter: blur(4px);
    pointer-events: none;
  }

  html.dark .hero-card {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(255, 124, 184, 0.28), transparent 60%),
      linear-gradient(135deg, rgba(38, 27, 48, 0.97), rgba(44, 31, 58, 0.95));
    border-color: rgba(255, 190, 219, 0.35);
    box-shadow:
      0 22px 54px rgba(0, 0, 0, 0.45),
      inset 0 0 0 1px rgba(255, 190, 219, 0.18);
  }

  html.dark .hero-card::before {
    opacity: 0.85;
  }

  /* 站娘：会挥手的小少女 */
  .hero-mascot {
    position: relative;
    flex: 0 0 auto;
    width: 116px;
    display: grid;
    place-items: center;
    z-index: 1;
  }

  .hero-mascot svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 8px 18px rgba(255, 124, 184, 0.35));
    animation: hero-float 4.4s ease-in-out infinite;
  }

  .hero-mascot-glow {
    position: absolute;
    width: 98px;
    height: 98px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 158, 203, 0.55), transparent 68%);
    filter: blur(2px);
  }

  .hero-mascot-heart {
    position: absolute;
    right: 0;
    top: 10px;
    font-size: 16px;
    line-height: 1;
    color: #ff5fa8;
    animation: hero-heart 3s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50% { transform: translateY(-6px) rotate(1.5deg); }
  }

  @keyframes hero-heart {
    0%, 100% { opacity: 0.35; transform: translateY(0) scale(0.9); }
    50% { opacity: 1; transform: translateY(-6px) scale(1.1); }
  }

  .hero-card > .anime-hero {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    margin: 0;
    padding: 4px 4px 8px;
    text-align: left;
  }

  .hero-card > .anime-hero::after {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mascot svg,
    .hero-mascot-heart {
      animation: none !important;
    }
  }

  /* 平板/手机非首页：主网格不位移，横幅也要跟着取消位移 */
  @media (max-width: 1023px) {
    body.enable-banner:not(.lg\:is-home) .hero-wrapper,
    body.enable-banner:not(.lg\:is-home) .home-anime {
      transform: none;
    }
  }

  /* 平板/桌面：底部留出横幅版权小胶囊（位于主网格上方 -3.25rem）的位置，避免被横卡压住 */
  @media (min-width: 641px) {
    .hero-wrapper {
      margin-bottom: 80px;
    }
  }

  /* 主网格（含横幅版权胶囊）绘制在横卡之上，避免横卡阴影把胶囊压成一条暗影 */
  body:has(.hero-wrapper) #main-grid {
    position: relative;
    z-index: 45;
  }

  /* 手机端：卡片更紧凑 */
  @media (max-width: 640px) {
    .hero-wrapper {
      padding: 0 12px;
      margin: 2px 0 16px;
    }
    /* 手机端横卡几乎占满屏宽，横幅版权胶囊没有落脚处，直接隐藏（其他页面照常显示） */
    body:has(.hero-wrapper) #banner-credit-mobile {
      display: none;
    }
    .hero-card {
      gap: 6px;
      padding: 16px 14px 12px;
      border-radius: 22px;
    }
    .hero-mascot {
      width: 78px;
    }
    .hero-mascot-glow {
      width: 66px;
      height: 66px;
    }
    .hero-mascot-heart {
      font-size: 12px;
      top: 2px;
    }
    .ah-jp {
      font-size: 10px;
      letter-spacing: .1em;
      margin-bottom: 6px;
    }
    .ah-title {
